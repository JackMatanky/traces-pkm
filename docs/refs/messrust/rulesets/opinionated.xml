<?xml version="1.0" encoding="UTF-8" ?>

<ruleset name="Opinionated Rust Rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
The opt-in checks omitted from the recommended Rust policy because they can
conflict with common Rust conventions. Combine this ruleset with `rust` to
run the complete policy.
    </description>

    <rule ref="naming/ShortVariable" />
    <rule ref="unusedcode/UnusedFormalParameter" />
    <rule ref="cleancode/BooleanArgumentFlag" />
    <rule ref="cleancode/ElseExpression" />
    <rule ref="cleancode/StaticAccess" />
    <rule ref="design/CountInLoopExpression" />
    <rule ref="design/ExitExpression" />
</ruleset>
