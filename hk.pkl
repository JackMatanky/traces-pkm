amends "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Builtins.pkl"

fail_fast = false

exclude = List(
    "target",
    "vendor",
    ".direnv",
    ".venv",
    "node_modules",
    "dist",
    "build",
    "LICENSE"
)

local hygiene = new Mapping<String, Step> {
    ["end-of-file-fixer"] = Builtins.newlines
    ["trailing-whitespace"] = Builtins.trailing_whitespace
    ["mixed-line-ending"] = Builtins.mixed_line_ending
}

local data_formats = new Mapping<String, Step> {
    ["check-json"] = Builtins.jq
    ["check-yaml"] = (Builtins.ryl) {
        check_diff = new CommandSpec {
            command = new Command {
                argv = List("ryl", "--diff", "-d", "extends: default", "{{files}}")
            }
            effect = "read"
        }
        check_list_files = new CommandSpec {
            command = new Command {
                argv = List("ryl", "--list-files", "-d", "extends: default", "{{files}}")
            }
            effect = "read"
        }
        fix = new CommandSpec {
            command = new Command {
                argv = List("ryl", "--fix", "-d", "extends: default", "{{files}}")
            }
            effect = "write"
        }
    }
    ["tombi-format"] = Builtins.tombi_format
}

local vcs = new Mapping<String, Step> {
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["check-case-conflict"] = Builtins.check_case_conflict
    ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-symlinks"] = Builtins.check_symlinks
}

local security = new Mapping<String, Step> {
    ["detect-private-key"] = Builtins.detect_private_key
    ["gitleaks"] = (Builtins.gitleaks) {
        check = new CommandSpec {
            command = "for file in {{files}}; do gitleaks dir --redact --no-banner --log-level error \"$file\" || exit $?; done"
            effect = "read"
        }
    }
}

local rust = new Mapping<String, Step> {
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["cargo-clippy"] = Builtins.cargo_clippy
    ["cargo-test"] = new Step {
        glob = List("**/*.rs", "**/Cargo.toml", "**/Cargo.lock")
        check = new CommandSpec {
            command = new Command {
                argv = List("cargo", "test", "--workspace", "--features", "test-utils")
            }
            effect = "write"
        }
    }
    ["cargo-deny"] = Builtins.cargo_deny
    ["cargo-sweep"] = new Step {
        step_condition = "exec('test -d target')"
        check = new CommandSpec {
            command = new Command {
                argv = List("cargo", "sweep", "--maxsize", "8000")
            }
            effect = "destructive"
        }
    }
}

local formatting =
    hygiene +
    data_formats +
    new Mapping<String, Step> {
        ["cargo-fmt"] = rust["cargo-fmt"]
    }

local prose = new Mapping<String, Step> {
    ["harper"] = (Builtins.harper) {
        glob = List("**/*.rs", "**/*.md")
        exclude = List(".rust-docs/**", ".agents/**")
        profiles = List("prose")
        check = new CommandSpec {
            command = new Command {
                argv = List(
                    "harper-cli",
                    "lint",
                    "--user-dict-path",
                    "dictionary.txt",
                    "{{files}}",
                )
            }
            effect = "read"
        }
    }
}

local validation =
    vcs +
    prose +
    new Mapping<String, Step> {
        ["tombi"] = Builtins.tombi
    }

local quality =
    new Mapping<String, Step> {
        ["cargo-clippy"] = rust["cargo-clippy"]
        ["cargo-test"] = rust["cargo-test"]
        ["cargo-deny"] = rust["cargo-deny"]
    }

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping<String, Step | Group> {
            ["format"] = new Group { steps = formatting }
            ["validate"] = new Group { steps = validation }
        }
    }

    ["pre-push"] {
        steps = new Mapping<String, Step | Group> {
            ["validate"] = new Group { steps = validation }
            ["security"] = new Group { steps = security }
            ["quality"] = new Group { steps = quality }
            ["cargo-sweep"] = rust["cargo-sweep"]
        }
    }

    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["conventional-commit"] = (Builtins.check_conventional_commit) {
                check = new CommandSpec {
                    command = new Command {
                        argv = List("hk", "util", "check-conventional-commit", "--verbose", "{{commit_msg_file}}")
                    }
                    effect = "read"
                }
            }
        }
    }

    ["fix"] {
        fix = true
        steps = formatting
    }

    ["check"] {
        steps = new Mapping<String, Step | Group> {
            ["format"] = new Group { steps = formatting }
            ["validate"] = new Group { steps = validation }
            ["security"] = new Group { steps = security }
            ["quality"] = new Group { steps = quality }
        }
    }
}
