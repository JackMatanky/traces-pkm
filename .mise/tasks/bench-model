#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy", "scikit-learn"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" help="Criterion output directory (default: target/criterion)"

from __future__ import annotations

import json
import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import numpy as np
from sklearn.linear_model import LinearRegression

# -- Data structures --------------------------------------------------------


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """A single measured benchmark result from Criterion output.

    Represents one parameterized benchmark measurement: a specific
    benchmark group (and, for multi-variant groups, a specific named
    sub-benchmark) run at a specific workspace size.

    Attributes:
        group: Benchmark group name (e.g. ``FileIndex::build``).
            Corresponds to the subdirectory under ``target/criterion/``.
        file_count: Parameter value — the number of files in the
            workspace that was benchmarked.
        mean_seconds: Mean wall-clock execution time in seconds,
            converted from Criterion's nanosecond ``point_estimate``.
        function: Sub-benchmark name within the group (e.g.
            ``sort_only``); empty for a group with exactly one flat
            sweep (``BenchmarkId::from_parameter``).
    """

    group: str
    file_count: float
    mean_seconds: float
    function: str = ""


@dataclass(frozen=True, slots=True)
class FittedModel:
    """A regression model fitted to benchmark data.

    Wraps the coefficients and goodness-of-fit from a scikit-learn
    `LinearRegression` fit so that predictions can be made at
    arbitrary workspace sizes.

    Attributes:
        name: Short identifier for the model type -- ``linear``, ``log``,
            or ``combined``.
        formula: Human-readable formula string for display in reports.
        coeff_n: Slope coefficient for the primary term (the ``a`` in
            ``a*n``, ``a*n*ln(n)``, or the linear term of ``combined``).
        coeff_intercept: Constant term (the ``b``/``c`` in ``a*n + b`` or
            ``a*n + b*n*ln(n) + c``).
        r_squared: Coefficient of determination -- 1.0 means a perfect
            fit to the measured data points.
        coeff_nlogn: Coefficient for the ``n*ln(n)`` term in the
            ``combined`` model; ``0.0`` and unused for ``linear``/``log``.
    """

    name: str
    formula: str
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    coeff_nlogn: float = 0.0

    def predict(self, file_count: float) -> float:
        """Predict mean seconds for a given workspace size.

        Applies the fitted formula to a new file count value.
        For the linear model this is ``a*n + b``; for the log
        model it is ``a*n*ln(n) + b``; for the combined model it is
        ``a*n + b*n*ln(n) + c``.

        Args:
            file_count: Workspace size (number of files) to predict
                execution time for.  Must be > 0 for the log and
                combined models.

        Returns:
            Predicted mean wall-clock time in seconds.
        """
        if self.name == "linear":
            return self.coeff_n * file_count + self.coeff_intercept
        if self.name == "combined":
            return (
                self.coeff_n * file_count
                + self.coeff_nlogn * file_count * np.log(file_count)
                + self.coeff_intercept
            )
        return (
            self.coeff_n * file_count * np.log(file_count)
            + self.coeff_intercept
        )


@dataclass(frozen=True, slots=True)
class ExtrapolationResult:
    """An extrapolated prediction for a target workspace size.

    Generated by :func:`extrapolate_to_target_sizes` and consumed
    by :func:`print_report` for display.

    Attributes:
        file_count: Target workspace size (e.g. 50_000 or 100_000).
        predicted_seconds: Predicted mean wall-clock time in seconds
            at the target workspace size.
        model_name: Name of the model used for the prediction
            (``linear`` or ``log``).
    """

    file_count: int
    predicted_seconds: float
    model_name: str


# -- Criterion output loading -----------------------------------------------


def load_benchmark_data(
    criterion_dir: Path,
) -> dict[str, list[BenchmarkDataPoint]]:
    """Load benchmark measurements from Criterion's JSON output, grouped by series.

    Walks the Criterion output tree two ways per group directory:

    - Flat sweep: ``<group>/<size>/new/`` (single-variant groups using
      ``BenchmarkId::from_parameter(n)``). Series key is the group name.
    - Nested sweep: ``<group>/<function>/<size>/new/`` (multi-variant
      groups using ``BenchmarkId::new(name, n)``). Series key is
      ``f"{group}/{function}"`` so distinct sub-benchmarks (e.g.
      ascending vs. descending sort) never get mixed into one
      regression.

    The expected directory layout is::

        criterion_dir/
        ├── FileIndex__build/
        │   ├── 50/new/{benchmark,estimates}.json          <- flat
        │   └── ...
        └── QueryService__run__sort_by_metadata/
            ├── sort_only/
            │   ├── 5000/new/{benchmark,estimates}.json    <- nested
            │   └── ...
            └── sort_only_desc/
                └── ...

    Args:
        criterion_dir: Root Criterion output directory, typically
            ``target/criterion``.

    Returns:
        Data points grouped by series key, each series sorted
        ascending by file count.  A series with fewer than 2 points
        is still returned; the caller is responsible for checking the
        minimum count.

    Raises:
        FileNotFoundError: If ``criterion_dir`` does not exist on
            the filesystem.
    """
    if not criterion_dir.exists():
        raise FileNotFoundError(f"Criterion output not found: {criterion_dir}")

    series: dict[str, list[BenchmarkDataPoint]] = {}

    for group_dir in sorted(criterion_dir.iterdir()):
        if not group_dir.is_dir():
            continue
        for child_dir in sorted(group_dir.iterdir()):
            if not child_dir.is_dir():
                continue
            flat_results: Path = child_dir / "new"
            if flat_results.is_dir():
                dp: BenchmarkDataPoint | None = _parse_benchmark_result(
                    group=group_dir.name,
                    function="",
                    results_dir=flat_results,
                )
                if dp is not None:
                    series.setdefault(group_dir.name, []).append(dp)
                continue
            for size_dir in sorted(child_dir.iterdir()):
                if not size_dir.is_dir():
                    continue
                nested_results: Path = size_dir / "new"
                if not nested_results.is_dir():
                    continue
                nested_dp: BenchmarkDataPoint | None = _parse_benchmark_result(
                    group=group_dir.name,
                    function=child_dir.name,
                    results_dir=nested_results,
                )
                if nested_dp is not None:
                    key: str = f"{group_dir.name}/{child_dir.name}"
                    series.setdefault(key, []).append(nested_dp)

    for points in series.values():
        points.sort(key=lambda p: p.file_count)
    return series


def _parse_benchmark_result(
    group: str,
    function: str,
    results_dir: Path,
) -> BenchmarkDataPoint | None:
    """Parse a single benchmark result from its ``new/`` directory.

    Reads ``benchmark.json`` for the parameter value (file count)
    and ``estimates.json`` for the mean timing.  Returns ``None``
    if either file is missing, malformed, or contains unexpected
    keys — this is expected for benchmarks that haven't run yet.

    Args:
        group: Benchmark group name (the parent directory name,
            e.g. ``FileIndex__build``).
        function: Sub-benchmark name, or empty for a flat sweep.
        results_dir: Path to the ``new/`` directory containing
            ``benchmark.json`` and ``estimates.json``.

    Returns:
        A parsed :class:`BenchmarkDataPoint`, or ``None`` if the
        result files could not be read or parsed.
    """
    try:
        bench: dict[str, Any] = json.loads(
            (results_dir / "benchmark.json").read_text()
        )
        est: dict[str, Any] = json.loads(
            (results_dir / "estimates.json").read_text()
        )
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        return None

    try:
        file_count: float = float(bench["value_str"])
        mean_s: float = est["mean"]["point_estimate"] / 1e9
    except (KeyError, TypeError, ValueError):
        return None

    return BenchmarkDataPoint(
        group=group,
        file_count=file_count,
        mean_seconds=mean_s,
        function=function,
    )


# -- Model fitting ----------------------------------------------------------


def fit_performance_models(
    data_points: list[BenchmarkDataPoint],
) -> list[FittedModel]:
    """Fit linear, n*ln(n), and combined regression models via scikit-learn.

    Extracts file counts and mean seconds from the data points and
    delegates to the individual fitting functions. Returns an empty
    list if the data has zero variance (all measurements identical),
    since scikit-learn's R-squared is undefined in that case.

    Args:
        data_points: Benchmark measurements.  At least 2 data
            points are required for a meaningful fit; fewer will
            produce degenerate results.

    Returns:
        List of fitted models sorted by R-squared descending
        (best fit first).  Includes a combined ``a*n + b*n*ln(n) + c``
        model when at least 4 data points are available; fewer points
        cannot support 3 free parameters without a degenerate exact
        fit. Empty if variance is zero.
    """
    file_counts: np.ndarray = np.array([dp.file_count for dp in data_points])
    mean_seconds: np.ndarray = np.array([dp.mean_seconds for dp in data_points])

    if np.var(mean_seconds) == 0:
        return []

    models: list[FittedModel] = [
        _fit_linear(file_counts, mean_seconds),
        _fit_log(file_counts, mean_seconds),
    ]
    if len(data_points) >= 4:
        models.append(_fit_combined(file_counts, mean_seconds))

    return sorted(models, key=lambda m: m.r_squared, reverse=True)


def _fit_linear(x: np.ndarray, y: np.ndarray) -> FittedModel:
    """Fit a linear model ``y = a*x + b`` via scikit-learn's OLS.

    Fits `sklearn.linear_model.LinearRegression` on a single feature
    column (the raw file counts) and reads the slope, intercept, and
    R-squared directly from the fitted estimator.

    Args:
        x: Independent variable -- array of file counts.
        y: Dependent variable -- array of mean execution times
            in seconds, same length as ``x``.

    Returns:
        A :class:`FittedModel` with ``name="linear"`` containing
        the fitted coefficients and R-squared value.
    """
    features: np.ndarray = x.reshape(-1, 1)
    model = LinearRegression().fit(features, y)

    return FittedModel(
        name="linear",
        formula="y = a*n + b",
        coeff_n=float(model.coef_[0]),
        coeff_intercept=float(model.intercept_),
        r_squared=float(model.score(features, y)),
    )


def _fit_log(x: np.ndarray, y: np.ndarray) -> FittedModel:
    """Fit a logarithmic model ``y = a*x*ln(x) + b`` via scikit-learn's OLS.

    Transforms the independent variable to ``x * ln(x)`` and fits
    `sklearn.linear_model.LinearRegression` on that single feature
    column. Captures complexity classes like comparison-sort
    O(n*ln(n)) behavior.

    Args:
        x: Independent variable -- array of file counts (> 0).
        y: Dependent variable -- array of mean execution times
            in seconds, same length as ``x``.

    Returns:
        A :class:`FittedModel` with ``name="log"`` containing
        the fitted coefficients and R-squared value.
    """
    features: np.ndarray = (x * np.log(x)).reshape(-1, 1)
    model = LinearRegression().fit(features, y)

    return FittedModel(
        name="log",
        formula="y = a*n*ln(n) + b",
        coeff_n=float(model.coef_[0]),
        coeff_intercept=float(model.intercept_),
        r_squared=float(model.score(features, y)),
    )


def _fit_combined(x: np.ndarray, y: np.ndarray) -> FittedModel:
    """Fit ``y = a*x + b*x*ln(x) + c`` via scikit-learn's OLS.

    Separates the linear (per-row key materialization) and n*ln(n)
    (comparator + permutation) cost terms in one regression, matching
    the two-component model several sort benchmarks' doc comments
    describe fitting. Fits `sklearn.linear_model.LinearRegression` on
    two feature columns (``x`` and ``x*ln(x)``). Requires strictly more
    data points than free parameters (4) to avoid a degenerate exact
    fit; callers must check ``len(data_points) >= 4`` before calling.

    Args:
        x: Independent variable -- array of file counts (> 0).
        y: Dependent variable -- array of mean execution times
            in seconds, same length as ``x``.

    Returns:
        A :class:`FittedModel` with ``name="combined"`` containing
        the fitted coefficients and R-squared value.
    """
    features: np.ndarray = np.column_stack([x, x * np.log(x)])
    model = LinearRegression().fit(features, y)

    return FittedModel(
        name="combined",
        formula="y = a*n + b*n*ln(n) + c",
        coeff_n=float(model.coef_[0]),
        coeff_intercept=float(model.intercept_),
        r_squared=float(model.score(features, y)),
        coeff_nlogn=float(model.coef_[1]),
    )


# -- Extrapolation ----------------------------------------------------------


def extrapolate_to_target_sizes(
    best_model: FittedModel,
    target_sizes: list[int],
) -> list[ExtrapolationResult]:
    """Predict performance at larger workspace sizes.

    Uses the fitted model's :meth:`FittedModel.predict` method to
    estimate execution time at each target workspace size.  This
    is only meaningful when the model has high R-squared (>= 0.95);
    the caller should check before calling.

    Args:
        best_model: The model with the highest R-squared from the
            fitted set.  Used for all extrapolations.
        target_sizes: Workspace sizes to extrapolate to, typically
            ``[50_000, 100_000]``.

    Returns:
        One :class:`ExtrapolationResult` per target size, in the
        same order as ``target_sizes``.
    """
    return [
        ExtrapolationResult(
            file_count=sz,
            predicted_seconds=round(best_model.predict(float(sz)), 3),
            model_name=best_model.name,
        )
        for sz in target_sizes
    ]


# -- Reporting --------------------------------------------------------------


def print_report(
    data_points: list[BenchmarkDataPoint],
    fitted_models: list[FittedModel],
    extrapolations: list[ExtrapolationResult],
) -> None:
    """Print a human-readable performance model report.

    Outputs three sections:

    1. **Data summary** — number of data points and file counts used.
    2. **Fitted models** — each model's formula, coefficients, and
       R-squared, with the best model marked.
    3. **Extrapolation** — predicted times at target sizes (only
       shown if best R-squared >= 0.95; otherwise a warning is
       printed instead).

    Args:
        data_points: The benchmark data that was fitted.
        fitted_models: All fitted models, sorted best-first.
        extrapolations: Extrapolated predictions.  May be empty
            if R-squared was below the threshold.
    """
    print(f"\nData points: {len(data_points)}")
    print(
        "File counts: "
        + ", ".join(str(int(dp.file_count)) for dp in data_points)
    )

    print("\nFitted models:")
    best: FittedModel = fitted_models[0]
    for model in fitted_models:
        marker: str = " <- best" if model is best else ""
        if model.name == "combined":
            print(
                f"  {model.formula}: "
                f"a={model.coeff_n:.6f}, "
                f"b={model.coeff_nlogn:.6f}, "
                f"c={model.coeff_intercept:.4f}, "
                f"R2={model.r_squared:.4f}{marker}"
            )
        else:
            print(
                f"  {model.formula}: "
                f"a={model.coeff_n:.6f}, "
                f"b={model.coeff_intercept:.4f}, "
                f"R2={model.r_squared:.4f}{marker}"
            )

    if best.name == "combined":
        residual_df: int = len(data_points) - 3
        if residual_df < 3:
            print(
                f"\nNote: combined model has only {residual_df} residual "
                "degree(s) of freedom "
                f"(n_points={len(data_points)}); R2 may be optimistic."
            )

    if best.r_squared < 0.95:
        print(
            f"\nWarning: low R2 ({best.r_squared:.4f})"
            " -- extrapolation unreliable."
        )
        print("  Measure directly at target sizes instead.")
        return

    print(f"\nExtrapolation (best: {best.name}, R2={best.r_squared:.4f}):")
    for ext in extrapolations:
        print(f"  {ext.file_count:>6,} notes: {ext.predicted_seconds:.3f}s")


# -- Entry point ------------------------------------------------------------


def main() -> None:
    """Load Criterion output, fit models per series, and print reports.

    Reads the criterion output directory from the
    ``usage_criterion_dir`` environment variable (set by mise
    ``#USAGE`` arg backing), falling back to ``sys.argv[1]``
    and then to the default ``target/criterion``.

    A series is a benchmark group's flat sweep, or one
    ``<group>/<function>`` pair for a group with multiple named
    sub-benchmarks (see :func:`load_benchmark_data`). Each series is
    fit and reported independently so distinct sub-benchmark curves
    are never blended into one regression.

    Exits with code 1 if the directory is missing, no usable series
    are found at all, or at least one series failed to fit (too few
    points or zero variance) -- but still prints every series that
    did succeed rather than stopping at the first failure.
    """
    criterion_dir: Path = Path(
        os.environ.get(
            "usage_criterion_dir",
            sys.argv[1] if len(sys.argv) > 1 else "target/criterion",
        )
    )

    try:
        series: dict[str, list[BenchmarkDataPoint]] = load_benchmark_data(
            criterion_dir
        )
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)

    if not series:
        print(
            "No usable benchmark series found under "
            f"{criterion_dir} (need numeric file-count parameters).",
            file=sys.stderr,
        )
        sys.exit(1)

    # Aggregated across all series: one under-measured/zero-variance
    # series fails the whole invocation (sys.exit(1) below) even after
    # every other series printed successfully. Under mise.toml's
    # `set -euo pipefail`, this fails `mise run bench --model` outright.
    had_failure = False
    for name in sorted(series):
        data_points: list[BenchmarkDataPoint] = series[name]
        print(f"\n=== {name} ===")

        if len(data_points) < 2:
            print(
                f"Skipping: need >=2 data points, found {len(data_points)}.",
                file=sys.stderr,
            )
            had_failure = True
            continue

        fitted_models: list[FittedModel] = fit_performance_models(data_points)
        if not fitted_models:
            print("Could not fit models (zero variance?).", file=sys.stderr)
            had_failure = True
            continue

        best_model: FittedModel = fitted_models[0]
        extrapolations: list[ExtrapolationResult] = (
            extrapolate_to_target_sizes(best_model, [50_000, 100_000])
            if best_model.r_squared >= 0.95
            else []
        )

        print_report(data_points, fitted_models, extrapolations)

    sys.exit(1 if had_failure else 0)


if __name__ == "__main__":
    main()
