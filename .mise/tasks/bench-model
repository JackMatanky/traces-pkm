#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" {
# [USAGE]   help="Criterion output directory"
# [USAGE]   default="target/criterion"
# [USAGE] }
# [USAGE] long_help="""
# [USAGE] Reads Criterion JSON output (new/benchmark.json for the
# [USAGE] parameter value, new/estimates.json for mean timing),
# [USAGE] fits linear and n*ln(n) regression models via OLS,
# [USAGE] and extrapolates to 50K, 100K notes.  Reports R-squared
# [USAGE] so the caller knows whether extrapolation is trustworthy.
# [USAGE]
# [USAGE] Expected directory layout:
# [USAGE]   target/criterion/<group>/<size>/new/{benchmark,estimates}.json
# [USAGE]
# [USAGE] Usage:
# [USAGE]   mise run bench-model                    # target/criterion
# [USAGE]   mise run bench-model /path/to/criterion # custom dir
# [USAGE] """

from __future__ import annotations

import json
import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import numpy as np

# -- Data structures --------------------------------------------------------


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """A single measured benchmark result from Criterion output.

    Represents one parameterized benchmark measurement: a specific
    benchmark group run at a specific workspace size.

    Attributes:
        group: Benchmark group name (e.g. ``FileIndex::build``).
            Corresponds to the subdirectory under ``target/criterion/``.
        file_count: Parameter value — the number of files in the
            workspace that was benchmarked.
        mean_seconds: Mean wall-clock execution time in seconds,
            converted from Criterion's nanosecond ``point_estimate``.
    """

    group: str
    file_count: float
    mean_seconds: float


@dataclass(frozen=True, slots=True)
class FittedModel:
    """A regression model fitted to benchmark data.

    Wraps the coefficients and goodness-of-fit from an OLS regression
    so that predictions can be made at arbitrary workspace sizes.

    Attributes:
        name: Short identifier for the model type — ``linear`` or ``log``.
        formula: Human-readable formula string for display in reports.
        coeff_n: Slope coefficient for the primary term (the ``a`` in
            ``a*n`` or ``a*n*ln(n)``).
        coeff_intercept: Constant term (the ``b`` in ``a*n + b``).
        r_squared: Coefficient of determination — 1.0 means a perfect
            fit to the measured data points.
    """

    name: str
    formula: str
    coeff_n: float
    coeff_intercept: float
    r_squared: float

    def predict(self, file_count: float) -> float:
        """Predict mean seconds for a given workspace size.

        Applies the fitted formula to a new file count value.
        For the linear model this is ``a*n + b``; for the log
        model it is ``a*n*ln(n) + b``.

        Args:
            file_count: Workspace size (number of files) to predict
                execution time for.  Must be > 0 for the log model.

        Returns:
            Predicted mean wall-clock time in seconds.
        """
        if self.name == "linear":
            return self.coeff_n * file_count + self.coeff_intercept
        return (
            self.coeff_n * file_count * np.log(file_count)
            + self.coeff_intercept
        )


@dataclass(frozen=True, slots=True)
class ExtrapolationResult:
    """An extrapolated prediction for a target workspace size.

    Generated by :func:`extrapolate_to_target_sizes` and consumed
    by :func:`print_report` for display.

    Attributes:
        file_count: Target workspace size (e.g. 50_000 or 100_000).
        predicted_seconds: Predicted mean wall-clock time in seconds
            at the target workspace size.
        model_name: Name of the model used for the prediction
            (``linear`` or ``log``).
    """

    file_count: int
    predicted_seconds: float
    model_name: str


# -- Criterion output loading -----------------------------------------------


def load_benchmark_data(
    criterion_dir: Path,
) -> list[BenchmarkDataPoint]:
    """Load benchmark measurements from Criterion's JSON output.

    Walks the Criterion output directory tree.  For each
    ``<group>/<parameter>/new/`` directory that contains both
    ``benchmark.json`` and ``estimates.json``, extracts the file
    count and mean timing into a :class:`BenchmarkDataPoint`.

    The expected directory layout is::

        criterion_dir/
        ├── FileIndex__build/
        │   ├── 50/new/{benchmark,estimates}.json
        │   ├── 100/new/{benchmark,estimates}.json
        │   └── ...
        └── QueryService__run/
            └── ...

    Args:
        criterion_dir: Root Criterion output directory, typically
            ``target/criterion``.

    Returns:
        List of data points sorted ascending by file count.  Groups
        with fewer than 2 valid data points will still produce data
        points; the caller is responsible for checking minimum count.

    Raises:
        FileNotFoundError: If ``criterion_dir`` does not exist on
            the filesystem.
    """
    if not criterion_dir.exists():
        raise FileNotFoundError(
            f"Criterion output not found: {criterion_dir}"
        )

    data_points: list[BenchmarkDataPoint] = []

    for group_dir in sorted(criterion_dir.iterdir()):
        if not group_dir.is_dir():
            continue
        for size_dir in sorted(group_dir.iterdir()):
            if not size_dir.is_dir():
                continue
            results_dir: Path = size_dir / "new"
            if not results_dir.is_dir():
                continue
            dp: BenchmarkDataPoint | None = _parse_benchmark_result(
                group=group_dir.name,
                results_dir=results_dir,
            )
            if dp is not None:
                data_points.append(dp)

    data_points.sort(key=lambda p: p.file_count)
    return data_points


def _parse_benchmark_result(
    group: str,
    results_dir: Path,
) -> BenchmarkDataPoint | None:
    """Parse a single benchmark result from its ``new/`` directory.

    Reads ``benchmark.json`` for the parameter value (file count)
    and ``estimates.json`` for the mean timing.  Returns ``None``
    if either file is missing, malformed, or contains unexpected
    keys — this is expected for benchmarks that haven't run yet.

    Args:
        group: Benchmark group name (the parent directory name,
            e.g. ``FileIndex__build``).
        results_dir: Path to the ``new/`` directory containing
            ``benchmark.json`` and ``estimates.json``.

    Returns:
        A parsed :class:`BenchmarkDataPoint`, or ``None`` if the
        result files could not be read or parsed.
    """
    try:
        bench: dict[str, Any] = json.loads(
            (results_dir / "benchmark.json").read_text()
        )
        est: dict[str, Any] = json.loads(
            (results_dir / "estimates.json").read_text()
        )
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        return None

    try:
        file_count: float = float(bench["value_str"])
        mean_s: float = est["mean"]["point_estimate"] / 1e9
    except (KeyError, TypeError, ValueError):
        return None

    return BenchmarkDataPoint(
        group=group,
        file_count=file_count,
        mean_seconds=mean_s,
    )


# -- Model fitting ----------------------------------------------------------


def fit_performance_models(
    data_points: list[BenchmarkDataPoint],
) -> list[FittedModel]:
    """Fit linear and n*ln(n) regression models via OLS.

    Extracts file counts and mean seconds from the data points,
    computes the total sum of squares, and delegates to the
    individual fitting functions.  Returns an empty list if the
    data has zero variance (all measurements identical).

    Args:
        data_points: Benchmark measurements.  At least 2 data
            points are required for a meaningful fit; fewer will
            produce degenerate results.

    Returns:
        List of fitted models sorted by R-squared descending
        (best fit first).  Empty if variance is zero.
    """
    file_counts: np.ndarray = np.array(
        [dp.file_count for dp in data_points]
    )
    mean_seconds: np.ndarray = np.array(
        [dp.mean_seconds for dp in data_points]
    )

    ss_tot: float = float(
        np.sum((mean_seconds - np.mean(mean_seconds)) ** 2)
    )
    if ss_tot == 0:
        return []

    models: list[FittedModel] = [
        _fit_linear(file_counts, mean_seconds, ss_tot),
        _fit_log(file_counts, mean_seconds, ss_tot),
    ]

    return sorted(
        models, key=lambda m: m.r_squared, reverse=True
    )


def _fit_linear(
    x: np.ndarray,
    y: np.ndarray,
    ss_tot: float,
) -> FittedModel:
    """Fit a linear model ``y = a*x + b`` via ordinary least squares.

    Constructs a design matrix ``[[x_0, 1], [x_1, 1], ...]`` and
    solves for the coefficient vector ``[a, b]`` using
    ``numpy.linalg.lstsq``.  Computes R-squared from the residual
    sum of squares.

    Args:
        x: Independent variable — array of file counts.
        y: Dependent variable — array of mean execution times
            in seconds, same length as ``x``.
        ss_tot: Precomputed total sum of squares for R-squared
            calculation.

    Returns:
        A :class:`FittedModel` with ``name="linear"`` containing
        the fitted coefficients and R-squared value.
    """
    A: np.ndarray = np.vstack([x, np.ones(len(x))]).T
    c: np.ndarray
    _, _, _, c = np.linalg.lstsq(A, y, rcond=None)
    pred: np.ndarray = A @ c
    ss_res: float = float(np.sum((y - pred) ** 2))

    return FittedModel(
        name="linear",
        formula="y = a*n + b",
        coeff_n=float(c[0]),
        coeff_intercept=float(c[1]),
        r_squared=1.0 - ss_res / ss_tot,
    )


def _fit_log(
    x: np.ndarray,
    y: np.ndarray,
    ss_tot: float,
) -> FittedModel:
    """Fit a logarithmic model ``y = a*x*ln(x) + b`` via OLS.

    Transforms the independent variable to ``x * ln(x)`` and then
    fits a linear model to the transformed data.  This captures
    complexity classes like comparison-sort O(n*ln(n)) behavior.

    Args:
        x: Independent variable — array of file counts (> 0).
        y: Dependent variable — array of mean execution times
            in seconds, same length as ``x``.
        ss_tot: Precomputed total sum of squares for R-squared
            calculation.

    Returns:
        A :class:`FittedModel` with ``name="log"`` containing
        the fitted coefficients and R-squared value.
    """
    xlogx: np.ndarray = x * np.log(x)
    A: np.ndarray = np.vstack([xlogx, np.ones(len(x))]).T
    c: np.ndarray
    _, _, _, c = np.linalg.lstsq(A, y, rcond=None)
    pred: np.ndarray = A @ c
    ss_res: float = float(np.sum((y - pred) ** 2))

    return FittedModel(
        name="log",
        formula="y = a*n*ln(n) + b",
        coeff_n=float(c[0]),
        coeff_intercept=float(c[1]),
        r_squared=1.0 - ss_res / ss_tot,
    )


# -- Extrapolation ----------------------------------------------------------


def extrapolate_to_target_sizes(
    best_model: FittedModel,
    target_sizes: list[int],
) -> list[ExtrapolationResult]:
    """Predict performance at larger workspace sizes.

    Uses the fitted model's :meth:`FittedModel.predict` method to
    estimate execution time at each target workspace size.  This
    is only meaningful when the model has high R-squared (>= 0.95);
    the caller should check before calling.

    Args:
        best_model: The model with the highest R-squared from the
            fitted set.  Used for all extrapolations.
        target_sizes: Workspace sizes to extrapolate to, typically
            ``[50_000, 100_000]``.

    Returns:
        One :class:`ExtrapolationResult` per target size, in the
        same order as ``target_sizes``.
    """
    return [
        ExtrapolationResult(
            file_count=sz,
            predicted_seconds=round(
                best_model.predict(float(sz)), 3
            ),
            model_name=best_model.name,
        )
        for sz in target_sizes
    ]


# -- Reporting --------------------------------------------------------------


def print_report(
    data_points: list[BenchmarkDataPoint],
    fitted_models: list[FittedModel],
    extrapolations: list[ExtrapolationResult],
) -> None:
    """Print a human-readable performance model report.

    Outputs three sections:

    1. **Data summary** — number of data points and file counts used.
    2. **Fitted models** — each model's formula, coefficients, and
       R-squared, with the best model marked.
    3. **Extrapolation** — predicted times at target sizes (only
       shown if best R-squared >= 0.95; otherwise a warning is
       printed instead).

    Args:
        data_points: The benchmark data that was fitted.
        fitted_models: All fitted models, sorted best-first.
        extrapolations: Extrapolated predictions.  May be empty
            if R-squared was below the threshold.
    """
    print(f"\nData points: {len(data_points)}")
    print(
        "File counts: "
        + ", ".join(
            str(int(dp.file_count)) for dp in data_points
        )
    )

    print("\nFitted models:")
    best: FittedModel = fitted_models[0]
    for model in fitted_models:
        marker: str = " <- best" if model is best else ""
        print(
            f"  {model.formula}: "
            f"a={model.coeff_n:.6f}, "
            f"b={model.coeff_intercept:.4f}, "
            f"R2={model.r_squared:.4f}{marker}"
        )

    if best.r_squared < 0.95:
        print(
            f"\nWarning: low R2 ({best.r_squared:.4f})"
            " -- extrapolation unreliable."
        )
        print(
            "  Measure directly at target sizes instead."
        )
        return

    print(
        f"\nExtrapolation (best: {best.name}, "
        f"R2={best.r_squared:.4f}):"
    )
    for ext in extrapolations:
        print(
            f"  {ext.file_count:>6,} notes: "
            f"{ext.predicted_seconds:.3f}s"
        )


# -- Entry point ------------------------------------------------------------


def main() -> None:
    """Load Criterion output, fit models, and print the report.

    Reads the criterion output directory from the
    ``usage_criterion_dir`` environment variable (set by mise
    ``#USAGE`` arg backing), falling back to ``sys.argv[1]``
    and then to the default ``target/criterion``.

    Exits with code 1 if the directory is missing, fewer than 2
    data points are found, or model fitting fails due to zero
    variance.
    """
    criterion_dir: Path = Path(
        os.environ.get(
            "usage_criterion_dir",
            sys.argv[1]
            if len(sys.argv) > 1
            else "target/criterion",
        )
    )

    try:
        data_points: list[BenchmarkDataPoint] = (
            load_benchmark_data(criterion_dir)
        )
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)

    if len(data_points) < 2:
        print(
            f"Need >=2 data points, found "
            f"{len(data_points)}.",
            file=sys.stderr,
        )
        sys.exit(1)

    fitted_models: list[FittedModel] = (
        fit_performance_models(data_points)
    )
    if not fitted_models:
        print(
            "Could not fit models (zero variance?).",
            file=sys.stderr,
        )
        sys.exit(1)

    best_model: FittedModel = fitted_models[0]
    extrapolations: list[ExtrapolationResult] = (
        extrapolate_to_target_sizes(
            best_model, [50_000, 100_000]
        )
        if best_model.r_squared >= 0.95
        else []
    )

    print_report(
        data_points, fitted_models, extrapolations
    )


if __name__ == "__main__":
    main()
