#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy", "scikit-learn", "plotext<6"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" help="Criterion output directory" default="target/criterion"
# [USAGE] flag "-p --plot" help="Render scatter plots with fitted curves in the terminal"
# [USAGE] flag "-s --summary" help="Print high-level summary of all series"

from __future__ import annotations

import json
import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import numpy as np
from sklearn.linear_model import LinearRegression

WORKSPACE_POINTS = {50, 200, 1000, 5000, 20000, 40000}

# ------------------------------------------------------------- #
#                        Data Structures                        #
# ------------------------------------------------------------- #


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """A single measured benchmark result from Criterion output.

    Represents one parameterized benchmark measurement: a specific benchmark
    group (and, for multi-variant groups, a specific named sub-benchmark) run at
    a specific workspace size.

    Attributes:
        group: Benchmark group name (e.g. ``FileIndex::build``).
            Corresponds to the subdirectory under ``target/criterion/``.
        file_count: Parameter value — the number of files in the
            workspace that was benchmarked.
        mean_seconds: Mean wall-clock execution time in seconds,
            converted from Criterion's nanosecond ``point_estimate``.
        function: Sub-benchmark name within the group (e.g.
            ``sort_only``); empty for a group with exactly one flat
            sweep (``BenchmarkId::from_parameter``).
    """

    group: str
    file_count: float
    mean_seconds: float
    function: str = ""


@dataclass(frozen=True, slots=True)
class FittedModel:
    """A regression model fitted to benchmark data.

    Wraps the coefficients and goodness-of-fit from a scikit-learn
    `LinearRegression` fit so that predictions can be made at arbitrary
    workspace sizes.

    Attributes:
        name: Short identifier for the model type -- ``linear``, ``log``,
            or ``combined``.
        formula: Human-readable formula string for display in reports.
        coeff_n: Slope coefficient for the primary term (the ``a`` in
            ``a*n``, ``a*n*ln(n)``, or the linear term of ``combined``).
        coeff_intercept: Constant term (the ``b``/``c`` in ``a*n + b`` or
            ``a*n + b*n*ln(n) + c``).
        r_squared: Coefficient of determination -- 1.0 means a perfect
            fit to the measured data points.
        coeff_nlogn: Coefficient for the ``n*ln(n)`` term in the
            ``combined`` model; ``0.0`` and unused for ``linear``/``log``.
    """

    name: str
    formula: str
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    coeff_nlogn: float = 0.0

    def predict(self, file_count: float) -> float:
        """Predict mean seconds for a given workspace size.

        Applies the fitted formula to a new file count value per model:
        - linear model: ``a*n + b``;
        - log model: ``a*n*ln(n) + b``;
        - combined model: ``a*n + b*n*ln(n) + c``.

        Args:
            file_count: Workspace size (number of files) to predict
                execution time for.  Must be > 0 for the log and
                combined models.

        Returns:
            Predicted mean wall-clock time in seconds.
        """
        if self.name == "linear":
            return self.coeff_n * file_count + self.coeff_intercept
        if self.name == "combined":
            return (
                self.coeff_n * file_count
                + self.coeff_nlogn * file_count * np.log(file_count)
                + self.coeff_intercept
            )
        return (
            self.coeff_n * file_count * np.log(file_count)
            + self.coeff_intercept
        )


@dataclass(frozen=True, slots=True)
class ExtrapolationResult:
    """An extrapolated prediction for a target workspace size.

    Generated by :func:`extrapolate_to_target_sizes` and consumed
    by :func:`print_report` for display.

    Attributes:
        file_count: Target workspace size (e.g. 50_000 or 100_000).
        predicted_seconds: Predicted mean wall-clock time in seconds
            at the target workspace size.
        model_name: Name of the model used for the prediction
            (``linear`` or ``log``).
    """

    file_count: int
    predicted_seconds: float
    model_name: str


# ------------------------------------------------------------- #
#                   Criterion Output Loading                    #
# ------------------------------------------------------------- #


def load_benchmark_data(
    criterion_dir: Path,
) -> dict[str, list[BenchmarkDataPoint]]:
    """Load benchmark measurements from Criterion's JSON output, grouped by
    series.

    Walks the Criterion output tree two ways per group directory:

    - Flat sweep: ``<group>/<size>/new/`` (single-variant groups using
      ``BenchmarkId::from_parameter(n)``). Series key is the group name.
    - Nested sweep: ``<group>/<function>/<size>/new/`` (multi-variant
      groups using ``BenchmarkId::new(name, n)``). Series key is
      ``f"{group}/{function}"`` so distinct sub-benchmarks (e.g.
      ascending vs. descending sort) never get mixed into one
      regression.

    The expected directory layout is::

        criterion_dir/
        ├── FileIndex__build/
        │   ├── 50/new/{benchmark,estimates}.json          <- flat
        │   └── ...
        └── QueryService__run__sort_by_metadata/
            ├── sort_only/
            │   ├── 5000/new/{benchmark,estimates}.json    <- nested
            │   └── ...
            └── sort_only_desc/
                └── ...

    Args:
        criterion_dir: Root Criterion output directory, typically
            ``target/criterion``.

    Returns:
        Data points grouped by series key, each series sorted ascending by file
        count. A series with fewer than 2 points is still returned; the caller
        is responsible for checking the minimum count.

    Raises:
        FileNotFoundError: If ``criterion_dir`` does not exist on
            the filesystem.
    """
    if not criterion_dir.exists():
        raise FileNotFoundError(f"Criterion output not found: {criterion_dir}")

    series: dict[str, list[BenchmarkDataPoint]] = {}

    for group_dir in sorted(criterion_dir.iterdir()):
        if not group_dir.is_dir():
            continue
        for child_dir in sorted(group_dir.iterdir()):
            if not child_dir.is_dir():
                continue
            flat_results: Path = child_dir / "new"
            if flat_results.is_dir():
                dp: BenchmarkDataPoint | None = _parse_benchmark_result(
                    group=group_dir.name,
                    function="",
                    results_dir=flat_results,
                )
                if dp is not None:
                    series.setdefault(group_dir.name, []).append(dp)
                continue
            for size_dir in sorted(child_dir.iterdir()):
                if not size_dir.is_dir():
                    continue
                nested_results: Path = size_dir / "new"
                if not nested_results.is_dir():
                    continue
                nested_dp: BenchmarkDataPoint | None = _parse_benchmark_result(
                    group=group_dir.name,
                    function=child_dir.name,
                    results_dir=nested_results,
                )
                if nested_dp is not None:
                    key: str = f"{group_dir.name}/{child_dir.name}"
                    series.setdefault(key, []).append(nested_dp)

    for points in series.values():
        points.sort(key=lambda p: p.file_count)
    return series


def _parse_benchmark_result(
    group: str,
    function: str,
    results_dir: Path,
) -> BenchmarkDataPoint | None:
    """Parse a single benchmark result from its ``new/`` directory.

    Reads ``benchmark.json`` for the parameter value (file count) and
    ``estimates.json`` for the mean timing. Returns ``None`` if either file is
    missing, malformed, or contains unexpected keys — this is expected for
    benchmarks that haven't run yet.

    Args:
        group: Benchmark group name (the parent directory name,
            e.g. ``FileIndex__build``).
        function: Sub-benchmark name, or empty for a flat sweep.
        results_dir: Path to the ``new/`` directory containing
            ``benchmark.json`` and ``estimates.json``.

    Returns:
        A parsed :class:`BenchmarkDataPoint`, or ``None`` if the result files
        could not be read or parsed.
    """
    try:
        bench: dict[str, Any] = json.loads(
            (results_dir / "benchmark.json").read_text()
        )
        est: dict[str, Any] = json.loads(
            (results_dir / "estimates.json").read_text()
        )
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        return None

    try:
        file_count: float = float(bench["value_str"])
        mean_s: float = est["mean"]["point_estimate"] / 1e9
    except (KeyError, TypeError, ValueError):
        return None

    return BenchmarkDataPoint(
        group=group,
        file_count=file_count,
        mean_seconds=mean_s,
        function=function,
    )


# ------------------------------------------------------------- #
#                         Model Fitting                         #
# ------------------------------------------------------------- #


def fit_performance_models(
    data_points: list[BenchmarkDataPoint],
) -> list[FittedModel]:
    """Fit linear, n*ln(n), and combined regression models via scikit-learn.

    Extracts file counts and mean seconds from the data points and delegates to
    the individual fitting functions. Returns an empty list if the data has zero
    variance (all measurements identical), since scikit-learn's R-squared is
    undefined in that case.

    Args:
        data_points: Benchmark measurements.  At least 2 data
            points are required for a meaningful fit; fewer will
            produce degenerate results.

    Returns:
        List of fitted models sorted by R-squared descending model when at least
        5 data points are available; fewer points cannot support 3 free
        parameters without a degenerate exact fit. Empty if variance is zero.
    """
    file_counts: np.ndarray = np.array([dp.file_count for dp in data_points])
    mean_seconds: np.ndarray = np.array([dp.mean_seconds for dp in data_points])

    if np.var(mean_seconds) == 0:
        return []

    models: list[FittedModel] = [
        _fit_linear(file_counts, mean_seconds),
        _fit_log(file_counts, mean_seconds),
    ]
    if len(data_points) >= 5:
        models.append(_fit_combined(file_counts, mean_seconds))

    return sorted(models, key=lambda m: m.r_squared, reverse=True)


def _fit_linear(x: np.ndarray, y: np.ndarray) -> FittedModel:
    """Fit a linear model ``y = a*x + b`` via scikit-learn's OLS.

    Fits `sklearn.linear_model.LinearRegression` on a single feature column (the
    raw file counts) and reads the slope, intercept, and R-squared directly from
    the fitted estimator.

    Args:
        x: Independent variable -- array of file counts.
        y: Dependent variable -- array of mean execution times
            in seconds, same length as ``x``.

    Returns:
        A :class:`FittedModel` with ``name="linear"`` containing the fitted
        coefficients and R-squared value.
    """
    features: np.ndarray = x.reshape(-1, 1)
    model = LinearRegression().fit(features, y)

    return FittedModel(
        name="linear",
        formula="y = a*n + b",
        coeff_n=float(model.coef_[0]),
        coeff_intercept=float(model.intercept_),
        r_squared=float(model.score(features, y)),
    )


def _fit_log(x: np.ndarray, y: np.ndarray) -> FittedModel:
    """Fit a logarithmic model ``y = a*x*ln(x) + b`` via scikit-learn's OLS.

    Transforms the independent variable to ``x * ln(x)`` and fits
    `sklearn.linear_model.LinearRegression` on that single feature column.
    Captures complexity classes like comparison-sort O(n*ln(n)) behavior.

    Args:
        x: Independent variable -- array of file counts (> 0).
        y: Dependent variable -- array of mean execution times
            in seconds, same length as ``x``.

    Returns:
        A :class:`FittedModel` with ``name="log"`` containing the fitted
        coefficients and R-squared value.
    """
    features: np.ndarray = (x * np.log(x)).reshape(-1, 1)
    model = LinearRegression().fit(features, y)

    return FittedModel(
        name="log",
        formula="y = a*n*ln(n) + b",
        coeff_n=float(model.coef_[0]),
        coeff_intercept=float(model.intercept_),
        r_squared=float(model.score(features, y)),
    )


def _fit_combined(x: np.ndarray, y: np.ndarray) -> FittedModel:
    """Fit ``y = a*x + b*x*ln(x) + c`` via scikit-learn's OLS.

    Separates the linear (per-row key materialization) and n*ln(n) (comparator +
    permutation) cost terms in one regression, matching the two-component model
    several sort benchmarks' doc comments describe fitting. Fits
    `sklearn.linear_model.LinearRegression` on two feature columns (``x`` and
    ``x*ln(x)``). Requires strictly more data points than free parameters (4) to
    avoid a degenerate exact fit; callers must check ``len(data_points) >= 4``
    before calling.

    Args:
        x: Independent variable -- array of file counts (> 0).
        y: Dependent variable -- array of mean execution times
            in seconds, same length as ``x``.

    Returns:
        A :class:`FittedModel` with ``name="combined"`` containing the fitted
        coefficients and R-squared value.
    """
    features: np.ndarray = np.column_stack([x, x * np.log(x)])
    model = LinearRegression().fit(features, y)

    return FittedModel(
        name="combined",
        formula="y = a*n + b*n*ln(n) + c",
        coeff_n=float(model.coef_[0]),
        coeff_intercept=float(model.intercept_),
        r_squared=float(model.score(features, y)),
        coeff_nlogn=float(model.coef_[1]),
    )


# ------------------------------------------------------------- #
#                         Extrapolation                         #
# ------------------------------------------------------------- #


def extrapolate_to_target_sizes(
    best_model: FittedModel,
    target_sizes: list[int],
) -> list[ExtrapolationResult]:
    """Predict performance at larger workspace sizes.

    Uses the fitted model's :meth:`FittedModel.predict` method to estimate
    execution time at each target workspace size. This is only meaningful when
    the model has high R-squared (>= 0.95); the caller should check before
    calling.

    Args:
        best_model: The model with the highest R-squared from the fitted set.
            Used for all extrapolations.
        target_sizes: Workspace sizes to extrapolate to, typically
            ``[50_000, 100_000]``.

    Returns:
        One :class:`ExtrapolationResult` per target size, in the same order as
        ``target_sizes``.
    """
    return [
        ExtrapolationResult(
            file_count=sz,
            predicted_seconds=round(best_model.predict(float(sz)), 3),
            model_name=best_model.name,
        )
        for sz in target_sizes
    ]


# ------------------------------------------------------------- #
#                        Terminal Plots                         #
# ------------------------------------------------------------- #


def plot_series(
    name: str,
    data_points: list[BenchmarkDataPoint],
    fitted_models: list[FittedModel],
) -> None:
    """Render a scatter plot with fitted curves using plotext.

    Draws measured data points as scatter markers and overlays the best
    model's fitted curve.  Each series gets its own plot block.

    Args:
        name: Series name (printed as the plot title).
        data_points: Measured benchmark data.
        fitted_models: Fitted models sorted best-first.
    """
    import plotext as plt

    x = [dp.file_count for dp in data_points]
    y = [dp.mean_seconds for dp in data_points]

    plt.clear_terminal()
    plt.title(name)
    plt.xlabel("n (files)")
    plt.ylabel("time (s)")

    # Measured data points
    plt.scatter(x, y, label="measured", color="cyan")

    # Best fitted curve — sample across the data range
    best = fitted_models[0]
    x_min, x_max = min(x), max(x)
    pad = max((x_max - x_min) * 0.1, 1)
    x_curve = np.linspace(max(x_min - pad, 1), x_max + pad, 200)
    y_curve = np.array([best.predict(float(xi)) for xi in x_curve])

    plt.plot(x_curve.tolist(), y_curve.tolist(), label=best.name, color="yellow")

    # R² annotation — place text at top-left of the plot area
    plt.text(
        f"R²={best.r_squared:.4f}  {best.formula}",
        x_min,
        y_curve.max(),
    )

    plt.show()
    print()  # blank line after plot


# ------------------------------------------------------------- #
#                         Formatting                            #
# ------------------------------------------------------------- #

# Unicode symbols
R_SQUARED = "R²"
BOX_H = "─"
BOX_V = "│"
BOX_TL = "┌"
BOX_TR = "┐"
BOX_BL = "└"
BOX_BR = "┘"

# Human-readable model descriptions
MODEL_DESCRIPTIONS = {
    "linear": "O(n) + constant",
    "log": "O(n·ln n) + constant",
    "combined": "O(n) + O(n·ln n) + constant",
}

# Coefficient explanations per model type
COEFF_EXPLANATIONS = {
    "linear": [
        ("a", "per-file linear cost"),
        ("b", "fixed overhead"),
    ],
    "log": [
        ("a", "sort/comparison overhead per file"),
        ("b", "fixed overhead"),
    ],
    "combined": [
        ("a", "per-file linear cost"),
        ("b", "sort/comparison overhead per file"),
        ("c", "fixed overhead"),
    ],
}


def _box_line(content: str, width: int = 60) -> str:
    """Format a line inside a box with padding."""
    padding = width - 4 - len(content)
    if padding < 0:
        padding = 0
    return f"{BOX_V} {content}{' ' * padding}{BOX_V}"


def _box_top(title: str, width: int = 60) -> str:
    """Box top border with title."""
    inner = width - 2
    title_part = f" {title} "
    remaining = inner - len(title_part)
    if remaining < 0:
        remaining = 0
    return f"{BOX_TL}{BOX_H * remaining}{title_part}{BOX_H * (width - len(title_part) - 2)}{BOX_TR}"


def _box_bottom(width: int = 60) -> str:
    """Box bottom border."""
    return f"{BOX_BL}{BOX_H * (width - 2)}{BOX_BR}"


def _box_separator(width: int = 60) -> str:
    """Thin separator line inside a box."""
    return f"{BOX_V} {'─' * (width - 4)}{BOX_V}"


def _format_scientific(value: float, precision: int = 2) -> str:
    """Format a float in scientific notation."""
    return f"{value:.{precision}e}"


def _format_seconds(seconds: float) -> str:
    """Format seconds with appropriate unit."""
    if seconds < 0.001:
        return f"{seconds * 1_000_000:.1f}µs"
    if seconds < 1.0:
        return f"{seconds * 1_000:.1f}ms"
    return f"{seconds:.2f}s"


# ------------------------------------------------------------- #
#                           Reporting                           #
# ------------------------------------------------------------- #


def print_report(
    data_points: list[BenchmarkDataPoint],
    fitted_models: list[FittedModel],
    extrapolations: list[ExtrapolationResult],
) -> None:
    """Print a human-readable performance model report.

    Outputs a box-formatted report with:
    1. **Data summary** — number of data points and file count range.
    2. **Best model** — human-readable formula with coefficient explanations.
    3. **Extrapolation** — predicted times at target sizes.
    4. **Scaling note** — which cost component dominates at scale.

    Args:
        data_points: The benchmark data that was fitted.
        fitted_models: All fitted models, sorted best-first.
        extrapolations: Extrapolated predictions.  May be empty if R-squared was
            below the threshold.
    """
    W = 60  # box width
    best: FittedModel = fitted_models[0]
    name = data_points[0].group if data_points else "unknown"
    sizes = [int(dp.file_count) for dp in data_points]

    # Header
    print()
    print(_box_top(name, W))
    print(_box_line("", W))

    # Data summary
    size_range = f"{min(sizes):,} → {max(sizes):,}"
    print(_box_line(f"Data: {len(data_points)} points  |  Sizes: {size_range}", W))

    # Best model
    desc = MODEL_DESCRIPTIONS.get(best.name, best.name)
    print(_box_line("", W))
    print(_box_line(f"Best fit: {desc}", W))
    print(_box_line("─" * (W - 4), W))

    # Coefficients with explanations
    coeffs = [
        ("a", best.coeff_n),
        ("b" if best.name != "combined" else "c", best.coeff_intercept),
    ]
    if best.name == "combined":
        coeffs.insert(1, ("b", best.coeff_nlogn))

    explanations = COEFF_EXPLANATIONS.get(best.name, [])
    for (label, value), (_, explanation) in zip(coeffs, explanations):
        print(_box_line(f"  {label} = {_format_scientific(value)}   {explanation}", W))

    # R²
    r2_quality = (
        "excellent" if best.r_squared >= 0.99
        else "good" if best.r_squared >= 0.95
        else "fair" if best.r_squared >= 0.90
        else "poor"
    )
    print(_box_line(f"  {R_SQUARED} = {best.r_squared:.4f}     {r2_quality} fit", W))

    # Low DOF warning
    if best.name == "combined":
        residual_df = len(data_points) - 3
        if residual_df < 3:
            print(_box_line("", W))
            print(_box_line(f"  ⚠ {residual_df} residual DOF — R² may be optimistic", W))

    # Extrapolation
    if best.r_squared < 0.95:
        print(_box_line("", W))
        print(_box_line(f"  ⚠ Low R² — extrapolation unreliable", W))
        print(_box_line(f"  Measure directly at target sizes instead.", W))
    elif extrapolations:
        if any(ext.predicted_seconds < 0 for ext in extrapolations):
            print(_box_line("", W))
            print(_box_line(f"  ⚠ Predictions negative — extrapolation suppressed", W))
        else:
            print(_box_line("", W))
            print(_box_line("Extrapolation:", W))
            for ext in extrapolations:
                print(_box_line(f"    {ext.file_count:>6,} notes → {_format_seconds(ext.predicted_seconds)}", W))

            # Scaling note
            if best.name == "combined":
                n = float(max(sizes) * 2.5)  # extrapolation point
                linear = abs(best.coeff_n * n)
                log = abs(best.coeff_nlogn * n * np.log(n))
                if linear > 2 * log:
                    dominant = "linear"
                elif log > 2 * linear:
                    dominant = "O(n·ln n) sort"
                else:
                    dominant = "mixed"
                print(_box_line("", W))
                print(_box_line(f"Scaling: {dominant} dominates at extrapolation point", W))

    print(_box_bottom(W))


def print_summary(
    all_series: dict[str, tuple[list[BenchmarkDataPoint], list[FittedModel]]],
) -> None:
    """Print a high-level summary of all series.

    Shows worst performers, unreliable fits, scaling breakdown, and
    near-constant series in a single box-formatted report.

    Args:
        all_series: Dict mapping series name to (data_points, fitted_models).
    """
    W = 64
    TARGET = 100_000

    # Classify series
    good_fits: list[tuple[str, FittedModel, float]] = []  # (name, model, predicted)
    bad_fits: list[tuple[str, FittedModel]] = []  # (name, model)
    constant: list[tuple[str, float]] = []  # (name, mean_time)
    scaling_counts: dict[str, int] = {
        "O(n)": 0,
        "O(n·ln n)": 0,
        "O(n) + O(n·ln n)": 0,
    }

    for name, (data_points, models) in all_series.items():
        if not models:
            continue
        best = models[0]

        # Check if near-constant
        times = [dp.mean_seconds for dp in data_points]
        if max(times) - min(times) < 0.0001:
            constant.append((name, np.mean(times)))
            continue

        # Classify scaling
        desc = MODEL_DESCRIPTIONS.get(best.name, best.name)
        # Map model name to scaling label
        scale_label = {
            "linear": "O(n)",
            "log": "O(n·ln n)",
            "combined": "O(n) + O(n·ln n)",
        }.get(best.name)
        if scale_label and scale_label in scaling_counts:
            scaling_counts[scale_label] += 1

        # Check fit quality
        if best.r_squared < 0.95:
            bad_fits.append((name, best))
        else:
            # Predict at target
            predicted = best.predict(float(TARGET))
            if predicted > 0:
                good_fits.append((name, best, predicted))

    # Sort by predicted time (worst first)
    good_fits.sort(key=lambda x: x[2], reverse=True)

    # Print summary
    print()
    print(_box_top("Performance Summary", W))
    print(_box_line("", W))

    # Stats
    total = len(all_series)
    n_good = len(good_fits)
    n_bad = len(bad_fits)
    n_const = len(constant)
    print(_box_line(f"{total} series  |  {n_good} good fits  |  {n_bad} unreliable  |  {n_const} constant", W))

    # Worst at target
    if good_fits:
        print(_box_line("", W))
        print(_box_line(f"WORST AT {TARGET // 1000}K NOTES:", W))
        print(_box_line("─" * (W - 4), W))
        for name, model, predicted in good_fits[:8]:  # top 8
            desc = MODEL_DESCRIPTIONS.get(model.name, model.name).split(" +")[0]
            r2_str = f"{R_SQUARED}={model.r_squared:.3f}"
            print(_box_line(f"  {name:<30s} {_format_seconds(predicted):>8s}  {desc:<15s} {r2_str}", W))

    # Bad fits
    if bad_fits:
        print(_box_line("", W))
        print(_box_line("UNRELIABLE FITS (R² < 0.95):", W))
        print(_box_line("─" * (W - 4), W))
        for name, model in bad_fits:
            print(_box_line(f"  {name:<30s} {R_SQUARED}={model.r_squared:.3f}  poor fit", W))

    # Scaling breakdown
    print(_box_line("", W))
    print(_box_line("SCALING BREAKDOWN:", W))
    print(_box_line("─" * (W - 4), W))
    for scale, count in scaling_counts.items():
        if count > 0:
            label = {
                "O(n)": "O(n)            linear per-file cost",
                "O(n·ln n)": "O(n·ln n)         sort/comparison cost",
                "O(n) + O(n·ln n)": "O(n) + O(n·ln n)  mixed cost",
            }.get(scale, scale)
            print(_box_line(f"  {label}: {count} series", W))

    # Near-constant
    if constant:
        print(_box_line("", W))
        print(_box_line("NEAR-CONSTANT (no scaling concern):", W))
        print(_box_line("─" * (W - 4), W))
        for name, mean_t in constant[:6]:  # top 6
            print(_box_line(f"  {name:<30s} {_format_seconds(mean_t):>8s}  all sizes", W))

    print(_box_bottom(W))


