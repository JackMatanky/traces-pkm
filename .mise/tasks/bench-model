#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy"]
# ///
# MISE description="Fit performance models to criterion output"
# MISE hide=true
# USAGE arg "[criterion_dir]" help="Criterion output directory" default="target/criterion"

"""
Performance curve fitting for Criterion benchmark output.

Reads the JSON files that Criterion writes after each ``cargo bench``
run, fits linear and n*ln(n) regression models to the measured data,
and extrapolates to larger workspace sizes (50K, 100K notes).  Reports
R-squared for each model so the caller knows whether the extrapolation
is trustworthy.
"""

from __future__ import annotations

import json
import os
import sys
from dataclasses import dataclass
from pathlib import Path

import numpy as np


# -- Data structures --------------------------------------------------------


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """A single measured benchmark result from Criterion output.

    Attributes:
        group: Benchmark group name (e.g. ``FileIndex::build``).
        file_count: Parameter value, number of files.
        mean_seconds: Mean wall-clock time in seconds.
    """

    group: str
    file_count: float
    mean_seconds: float


@dataclass(frozen=True, slots=True)
class FittedModel:
    """A regression model fitted to benchmark data.

    Attributes:
        name: Short identifier (``linear`` or ``log``).
        formula: Human-readable formula string.
        coeff_n: Slope coefficient for the primary term.
        coeff_intercept: Intercept (constant) coefficient.
        r_squared: Coefficient of determination (1.0 = perfect).
    """

    name: str
    formula: str
    coeff_n: float
    coeff_intercept: float
    r_squared: float

    def predict(self, file_count: float) -> float:
        """Predict mean seconds for a given file count.

        Args:
            file_count: Workspace size to predict at.

        Returns:
            Predicted mean wall-clock time in seconds.
        """
        if self.name == "linear":
            return self.coeff_n * file_count + self.coeff_intercept
        return (
            self.coeff_n * file_count * np.log(file_count)
            + self.coeff_intercept
        )


@dataclass(frozen=True, slots=True)
class ExtrapolationResult:
    """An extrapolated prediction for a target workspace size.

    Attributes:
        file_count: Target workspace size.
        predicted_seconds: Predicted mean wall-clock time.
        model_name: Name of the model used for prediction.
    """

    file_count: int
    predicted_seconds: float
    model_name: str


# -- Criterion output loading -----------------------------------------------


def load_benchmark_data(
    criterion_dir: Path,
) -> list[BenchmarkDataPoint]:
    """Load benchmark measurements from Criterion JSON output.

    Reads ``new/benchmark.json`` for the parameter value and
    ``new/estimates.json`` for the mean timing from each
    parameterized benchmark directory.

    Args:
        criterion_dir: Root Criterion output directory.

    Returns:
        Data points sorted ascending by file count.

    Raises:
        FileNotFoundError: If directory does not exist.
    """
    if not criterion_dir.exists():
        raise FileNotFoundError(
            f"Criterion output not found: {criterion_dir}"
        )

    data_points: list[BenchmarkDataPoint] = []

    for group_dir in sorted(criterion_dir.iterdir()):
        if not group_dir.is_dir():
            continue
        for size_dir in sorted(group_dir.iterdir()):
            if not size_dir.is_dir():
                continue
            results_dir = size_dir / "new"
            if not results_dir.is_dir():
                continue
            dp = _parse_benchmark_result(
                group=group_dir.name,
                results_dir=results_dir,
            )
            if dp is not None:
                data_points.append(dp)

    data_points.sort(key=lambda p: p.file_count)
    return data_points


def _parse_benchmark_result(
    group: str,
    results_dir: Path,
) -> BenchmarkDataPoint | None:
    """Parse a single benchmark result from its ``new/`` directory.

    Args:
        group: Benchmark group name.
        results_dir: Path to the ``new/`` directory.

    Returns:
        A parsed data point, or ``None`` on any error.
    """
    try:
        bench = json.loads(
            (results_dir / "benchmark.json").read_text()
        )
        est = json.loads(
            (results_dir / "estimates.json").read_text()
        )
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        return None

    try:
        file_count = float(bench["value_str"])
        mean_s = est["mean"]["point_estimate"] / 1e9
    except (KeyError, TypeError, ValueError):
        return None

    return BenchmarkDataPoint(
        group=group,
        file_count=file_count,
        mean_seconds=mean_s,
    )


# -- Model fitting ----------------------------------------------------------


def fit_performance_models(
    data_points: list[BenchmarkDataPoint],
) -> list[FittedModel]:
    """Fit linear and n*ln(n) regression models via OLS.

    Args:
        data_points: Benchmark measurements (>= 2 required).

    Returns:
        Models sorted by R-squared descending.
    """
    file_counts = np.array(
        [dp.file_count for dp in data_points]
    )
    mean_seconds = np.array(
        [dp.mean_seconds for dp in data_points]
    )

    ss_tot = float(
        np.sum((mean_seconds - np.mean(mean_seconds)) ** 2)
    )
    if ss_tot == 0:
        return []

    models = [
        _fit_linear(file_counts, mean_seconds, ss_tot),
        _fit_log(file_counts, mean_seconds, ss_tot),
    ]

    return sorted(
        models, key=lambda m: m.r_squared, reverse=True
    )


def _fit_linear(
    x: np.ndarray,
    y: np.ndarray,
    ss_tot: float,
) -> FittedModel:
    """Fit ``y = a*x + b`` via ordinary least squares.

    Args:
        x: Independent variable (file counts).
        y: Dependent variable (mean seconds).
        ss_tot: Precomputed total sum of squares.

    Returns:
        A fitted linear model.
    """
    A = np.vstack([x, np.ones(len(x))]).T
    c, _, _, _ = np.linalg.lstsq(A, y, rcond=None)
    pred = A @ c
    ss_res = float(np.sum((y - pred) ** 2))

    return FittedModel(
        name="linear",
        formula="y = a*n + b",
        coeff_n=float(c[0]),
        coeff_intercept=float(c[1]),
        r_squared=1.0 - ss_res / ss_tot,
    )


def _fit_log(
    x: np.ndarray,
    y: np.ndarray,
    ss_tot: float,
) -> FittedModel:
    """Fit ``y = a*x*ln(x) + b`` via ordinary least squares.

    Args:
        x: Independent variable (file counts).
        y: Dependent variable (mean seconds).
        ss_tot: Precomputed total sum of squares.

    Returns:
        A fitted logarithmic model.
    """
    xlogx = x * np.log(x)
    A = np.vstack([xlogx, np.ones(len(x))]).T
    c, _, _, _ = np.linalg.lstsq(A, y, rcond=None)
    pred = A @ c
    ss_res = float(np.sum((y - pred) ** 2))

    return FittedModel(
        name="log",
        formula="y = a*n*ln(n) + b",
        coeff_n=float(c[0]),
        coeff_intercept=float(c[1]),
        r_squared=1.0 - ss_res / ss_tot,
    )


# -- Extrapolation ----------------------------------------------------------


def extrapolate_to_target_sizes(
    best_model: FittedModel,
    target_sizes: list[int],
) -> list[ExtrapolationResult]:
    """Predict performance at larger workspace sizes.

    Args:
        best_model: The model with highest R-squared.
        target_sizes: Workspace sizes to extrapolate to.

    Returns:
        One extrapolation result per target size.
    """
    return [
        ExtrapolationResult(
            file_count=sz,
            predicted_seconds=round(
                best_model.predict(float(sz)), 3
            ),
            model_name=best_model.name,
        )
        for sz in target_sizes
    ]


# -- Reporting --------------------------------------------------------------


def print_report(
    data_points: list[BenchmarkDataPoint],
    fitted_models: list[FittedModel],
    extrapolations: list[ExtrapolationResult],
) -> None:
    """Print a human-readable performance model report.

    Args:
        data_points: The benchmark data that was fitted.
        fitted_models: All fitted models (best first).
        extrapolations: Extrapolated predictions (may be empty).
    """
    print(f"\nData points: {len(data_points)}")
    print(
        "File counts: "
        + ", ".join(
            str(int(dp.file_count)) for dp in data_points
        )
    )

    print("\nFitted models:")
    best = fitted_models[0]
    for model in fitted_models:
        marker = " <- best" if model is best else ""
        print(
            f"  {model.formula}: "
            f"a={model.coeff_n:.6f}, "
            f"b={model.coeff_intercept:.4f}, "
            f"R2={model.r_squared:.4f}{marker}"
        )

    if best.r_squared < 0.95:
        print(
            f"\nWarning: low R2 ({best.r_squared:.4f})"
            " -- extrapolation unreliable."
        )
        print(
            "  Measure directly at target sizes instead."
        )
        return

    print(
        f"\nExtrapolation (best: {best.name}, "
        f"R2={best.r_squared:.4f}):"
    )
    for ext in extrapolations:
        print(
            f"  {ext.file_count:>6,} notes: "
            f"{ext.predicted_seconds:.3f}s"
        )


# -- Entry point ------------------------------------------------------------


def main() -> None:
    """Load Criterion output, fit models, and report."""
    criterion_dir = Path(
        os.environ.get(
            "usage_criterion_dir",
            sys.argv[1] if len(sys.argv) > 1
            else "target/criterion",
        )
    )

    try:
        data_points = load_benchmark_data(criterion_dir)
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)

    if len(data_points) < 2:
        print(
            f"Need >=2 data points, found "
            f"{len(data_points)}.",
            file=sys.stderr,
        )
        sys.exit(1)

    fitted_models = fit_performance_models(data_points)
    if not fitted_models:
        print(
            "Could not fit models "
            "(zero variance?).",
            file=sys.stderr,
        )
        sys.exit(1)

    best_model = fitted_models[0]
    extrapolations = (
        extrapolate_to_target_sizes(
            best_model, [50_000, 100_000]
        )
        if best_model.r_squared >= 0.95
        else []
    )

    print_report(
        data_points, fitted_models, extrapolations
    )


if __name__ == "__main__":
    main()
