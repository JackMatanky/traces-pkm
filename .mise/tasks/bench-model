#                          Entry Point                          #
# ------------------------------------------------------------- #


def main() -> None:
    """Load Criterion output, fit models per series, and print reports.

    Reads the criterion output directory from the ``usage_criterion_dir``
    environment variable (set by mise ``#USAGE`` arg backing), falling back to
    ``sys.argv[1]`` and then to the default ``target/criterion``.

    A series is a benchmark group's flat sweep, or one ``<group>/<function>``
    pair for a group with multiple named sub-benchmarks (see
    :func:`load_benchmark_data`). Each series is fit and reported independently
    so distinct sub-benchmark curves are never blended into one regression.

    Exits with code 1 if the directory is missing, no usable series are found at
    all, or at least one series failed to fit (too few points or zero variance)
    -- but still prints every series that did succeed rather than stopping at
    the first failure.
    """
    criterion_dir: Path = Path(
        os.environ.get(
            "usage_criterion_dir",
            sys.argv[1] if len(sys.argv) > 1 else "target/criterion",
        )
    )
    plot: bool = os.environ.get("usage_plot", "false") == "true"
    summary: bool = os.environ.get("usage_summary", "false") == "true"

    try:
        series: dict[str, list[BenchmarkDataPoint]] = load_benchmark_data(
            criterion_dir
        )
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)

    if not series:
        print(
            "No usable benchmark series found under "
            f"{criterion_dir} (need numeric file-count parameters).",
            file=sys.stderr,
        )
        sys.exit(1)

    # Aggregated across all series: one under-measured/zero-variance series
    # fails the whole invocation (sys.exit(1) below) even after every other
    # series printed successfully. Under mise.toml's `set -euo pipefail`, this
    # fails `mise run bench --model` outright.
    had_failure = False
    all_fitted: dict[str, tuple[list[BenchmarkDataPoint], list[FittedModel]]] = {}

    for name in sorted(series):
        data_points: list[BenchmarkDataPoint] = series[name]

        if len(data_points) < 2:
            print(
                f"Skipping: need >=2 data points, found {len(data_points)}.",
                file=sys.stderr,
            )
            had_failure = True
            continue

        fitted_models: list[FittedModel] = fit_performance_models(data_points)
        if not fitted_models:
            print("Could not fit models (zero variance?).", file=sys.stderr)
            had_failure = True
            continue

        all_fitted[name] = (data_points, fitted_models)

        if not summary:
            best_model: FittedModel = fitted_models[0]
            is_workspace_series = set(
                int(dp.file_count) for dp in data_points
            ).issubset(WORKSPACE_POINTS)
            extrapolations: list[ExtrapolationResult] = (
                extrapolate_to_target_sizes(best_model, [50_000, 100_000])
                if (best_model.r_squared >= 0.95 and is_workspace_series)
                else []
            )

            print_report(data_points, fitted_models, extrapolations)
            if plot:
                plot_series(name, data_points, fitted_models)

    if summary:
        print_summary(all_fitted)

    sys.exit(1 if had_failure else 0)


if __name__ == "__main__":
    main()
