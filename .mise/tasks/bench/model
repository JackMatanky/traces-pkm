class SummaryReporter:
    """Renders the overview of every fitted series in a clean widescreen table."""

    def __init__(
        self,
        worst_count: int = DEFAULT_WORST_COUNT,
        target: int = SUMMARY_TARGET,
    ) -> None:
        self._worst_count = worst_count
        self._target = target

    def render(self, data: SummaryData, width: int | None = None) -> str:
        width = Presentation.terminal_width() if width is None else width
        lines: list[str] = [
            f"{'═' * min(100, width)}",
            f"{Style.bold('PERFORMANCE SUMMARY')}",
            (
                f"{data.total_series} series evaluated  │  {Style.green(str(data.supported_fit_count) + ' supported')}"
                f"  │  {Style.yellow(str(data.unreliable_count) + ' inconclusive')}"
                f"  │  {Style.dim(str(data.constant_count) + ' near-constant')}"
            ),
            *self._ranked_lines(data, width),
            *self._unreliable_lines(data, width),
            *self._scaling_lines(data),
            *self._constant_lines(data, width),
            f"{'═' * min(100, width)}",
        ]
        return "\n".join(lines)

    def _ranked_lines(self, data: SummaryData, width: int) -> list[str]:
        if not data.ranked:
            return []
        shown = data.ranked[: self._worst_count]
        lines: list[str] = [
            "",
            f"{Style.bold(f'TOP PERFORMANCE CONSUMERS AT {self._target // 1000}K (top {len(shown)}):')}",
            f"  {'Rank':<5} {'Benchmark Name':<34} {'Range (n)':<16} {'Baseline Δ':<14} {'Complexity':<14} {R_SQUARED:<6} {'Est. @ 100K':<12} Status",
            f"  {'─'*4:<5} {'─'*32:<34} {'─'*14:<16} {'─'*12:<14} {'─'*12:<14} {'─'*5:<6} {'─'*10:<12} {'─'*12}",
        ]
        for rank, entry in enumerate(shown, start=1):
            name = Presentation.truncate_middle(entry.name, 32)
            delta = entry.change_vs_base.format_short() if entry.change_vs_base else Style.dim("n/a")
            est = Presentation.format_seconds(entry.predicted_seconds)
            lines.append(
                f"   {rank:<3} {name:<34} {entry.range_str:<16} {delta:<14} "
                f"{entry.model.kind.short_label:<14} {entry.model.r_squared:.3f}  "
                f"{est:>10}  {Style.green('🟢 EXPLORATORY')}"
            )
        return lines

    def _unreliable_lines(self, data: SummaryData, width: int) -> list[str]:
        if not data.unreliable:
            return []
        lines: list[str] = [
            "",
            f"{Style.bold('INCONCLUSIVE SERIES (insufficient DOF or weak correlation):')}",
            f"  {'Benchmark Name':<34} {'Range (n)':<16} {'Sizes / DOF':<12} {'Baseline Δ':<14} {R_SQUARED:<6} Reason",
            f"  {'─'*32:<34} {'─'*14:<16} {'─'*10:<12} {'─'*12:<14} {'─'*5:<6} {'─'*24}",
        ]
        for entry in data.unreliable:
            name = Presentation.truncate_middle(entry.name, 32)
            delta = entry.change_vs_base.format_short() if entry.change_vs_base else Style.dim("n/a")
            dof_str = f"{entry.sizes_count} / {entry.residual_dof}"
            reason_badge = (
                Style.yellow("🟡 " + entry.reason)
                if "need" in entry.reason or "inconclusive" in entry.reason
                else Style.red("🔴 " + entry.reason)
            )
            lines.append(
                f"  {name:<34} {entry.range_str:<16} {dof_str:<12} {delta:<14} "
                f"{entry.model.r_squared:.3f}  {reason_badge}"
            )
        return lines

    @staticmethod
    def _scaling_lines(data: SummaryData) -> list[str]:
        lines: list[str] = ["", f"{Style.bold('SCALING BREAKDOWN:')}"]
        for kind, count in data.scaling_counts.items():
            if count > 0:
                lines.append(
                    f"  {kind.short_label:<14}  {kind.breakdown_description}:"
                    f" {count} series"
                )
        return lines

    @staticmethod
    def _constant_lines(data: SummaryData, width: int) -> list[str]:
        if not data.constant:
            return []
        lines: list[str] = ["", f"{Style.bold('NEAR-CONSTANT (no scaling concern):')}"]
        for entry in data.constant:
            name = Presentation.truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            lines.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {Presentation.format_seconds(entry.mean_seconds):>8}  all sizes"
            )
        return lines


class SeriesPlotRenderer:
    """Renders measured scatter dots, connected steps, and regression curves with plotext."""

    def render(self, analysis: SeriesAnalysis, siblings: Sequence[SeriesAnalysis] = ()) -> None:
        import plotext as plt

        width = self._width()
        plt.clear_figure()
        plt.plotsize(width, PLOT_HEIGHT)
        plt.theme("clear")
        plt.xlabel(f"Input Size: n ({analysis.input_unit})")

        # Determine if we have sibling variants to overlay (e.g. InlinkMap__new variants)
        variants = [analysis]
        if siblings:
            variants.extend([s for s in siblings if s.name != analysis.name])

        # Find global scale
        max_time = max(max(p.mean_seconds for p in var.data_points) for var in variants)
        unit, scale = Presentation.time_unit(max_time)
        plt.ylabel(f"Time ({unit})")

        colors = ["cyan", "yellow", "green", "magenta", "red"]
        for idx, var in enumerate(variants):
            color = colors[idx % len(colors)]
            x = [p.input_size for p in var.data_points]
            y = [p.mean_seconds * scale for p in var.data_points]
            lbl = var.name.split("/")[-1] if len(variants) > 1 else "measured (mean)"

            # Scatter points
            plt.scatter(x, y, label=lbl, color=color, marker="dot")

            # Fitted curve for trusted models
            if var.is_fit_trusted:
                curve_x = np.linspace(min(x), max(x), 100)
                curve_y = [var.best_model.predict(float(val)) * scale for val in curve_x]
                fit_lbl = f"fit: {var.best_model.kind.short_label}" if len(variants) == 1 else None
                plt.plot(curve_x.tolist(), curve_y, label=fit_lbl, color=color, marker="dot")

        plt.show()
        print()

    @staticmethod
    def _width() -> int:
        try:
            columns = os.get_terminal_size().columns
        except OSError:
            return PLOT_MIN_WIDTH
        return min(PLOT_MAX_WIDTH, max(PLOT_MIN_WIDTH, columns - 4))


