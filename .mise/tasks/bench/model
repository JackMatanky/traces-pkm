#                           Reporting                           #
# ------------------------------------------------------------- #


class SeriesReporter:
    """Renders scan-first cards, forecasts, and statistical grids."""

    def render_card(self, analysis: SeriesAnalysis, width: int | None = None) -> str:
        width = Presentation.terminal_width() if width is None else width
        if width >= WIDESCREEN_THRESHOLD:
            return self._render_wide_card(analysis, width)
        return self._render_narrow_card(analysis)

    @staticmethod
    def _pad_columns(
        left_lines: Sequence[str], right_lines: Sequence[str], col_w: int
    ) -> list[tuple[str, str]]:
        """Pad two label/value line lists to col_w: wrap any line overflowing col_w
        into multiple physical rows first, then extend the shorter side with blanks."""
        left = SeriesReporter._wrap_lines(left_lines, col_w)
        right = SeriesReporter._wrap_lines(right_lines, col_w)
        max_rows = max(len(left), len(right))
        left += [""] * (max_rows - len(left))
        right += [""] * (max_rows - len(right))
        return [
            (Style.pad_visible(l, col_w), Style.pad_visible(r, col_w))
            for l, r in zip(left, right, strict=True)
        ]

    @staticmethod
    def _wrap_lines(lines: Sequence[str], width: int) -> list[str]:
        wrapped: list[str] = []
        for line in lines:
            wrapped.extend(SeriesReporter._wrap_line(line, width))
        return wrapped

    @staticmethod
    def _wrap_line(text: str, width: int) -> list[str]:
        """Wrap one line to `width` visible columns. Continuation lines indent to
        align under the value, detected as the text after the first ": " label
        separator (every card field in this file follows a "label: value" shape).
        # ponytail: assumes at most one ANSI color run per line, true for every
        # field rendered today; a genuinely multi-color line would need a
        # per-run wrap instead of reapplying one leading color to every row.
        """
        if Style.visible_width(text) <= width:
            return [text]

        clean = re.sub(r"\033\[[0-9;]*m", "", text)
        color_match = re.match(r"^(\033\[[0-9;]*m)", text)
        color = color_match.group(1) if color_match else ""
        reset = Style.RESET if color else ""

        sep = clean.find(": ")
        indent = " " * (sep + 2) if sep != -1 else ""

        wrapped = SeriesReporter._wrap_plain(clean, width, indent)
        return [f"{color}{line}{reset}" if color else line for line in wrapped]

    @staticmethod
    def _wrap_plain(text: str, width: int, indent: str) -> list[str]:
        """Greedy word-wrap using visible-column width: correctly accounts for
        wide/emoji characters, unlike stdlib textwrap's plain character count."""
        lines: list[str] = []
        prefix = ""
        current = ""
        for word in text.split(" "):
            candidate = f"{current} {word}" if current else word
            if current and Style.visible_width(prefix + candidate) > width:
                lines.append(prefix + current)
                prefix = indent
                current = word
            else:
                current = candidate
        lines.append(prefix + current)
        return lines

    def _render_wide_card(self, analysis: SeriesAnalysis, width: int) -> str:
        card_w = min(114, max(96, width - 2))
        col_w = (card_w - 11) // 2

        latest = analysis.largest_measurement
        best = analysis.best_model
        rate_str = latest.throughput_rate_str or "N/A"
        r2_label = f"{R_SQUARED} (in-sample)"
        slope_str = f"{Presentation.format_estimate_interval(latest.slope)}" + (
            f" ({R_SQUARED}={latest.slope_r_squared:.3f})" if latest.slope_r_squared else ""
        )

        # Left column: raw measurement facts, then how they compare to base.
        left_lines = [
            f"{Style.bold('MEASUREMENT'):<{col_w}}",
            f"{'─' * (col_w - 2):<{col_w}}",
            f"{'Largest':<10}: {latest.input_size:,.0f} {analysis.input_unit}",
            f"{'Runtime':<10}: {latest.timing.format_with_ci()}  95% CI",
            f"{'Throughput':<10}: {rate_str}",
            f"{'Median':<10}: {Presentation.format_estimate_interval(latest.median)}",
            f"{'MAD':<10}: {Presentation.format_estimate_interval(latest.mad)}",
            f"{'Std Dev':<10}: {Presentation.format_estimate_interval(latest.std_dev)}",
            f"{'Outliers':<10}: {latest.outliers.format_summary()}",
            "",
            f"{Style.bold('BASELINE COMPARISON'):<{col_w}}",
            f"{'─' * (col_w - 2):<{col_w}}",
        ]
        if latest.change_vs_base:
            left_lines += [
                f"{'Δ vs base':<9}: {latest.change_vs_base.format_badge()}",
                f"{'Decision':<9}: {latest.change_vs_base.format_decision_line()}",
            ]
        else:
            left_lines.append(f"{'Δ vs base':<9}: {Style.dim('⚪ n/a (no baseline recorded)')}")

        # Right column: everything the complexity model produces, facts and forecasts.
        right_lines = [
            f"{Style.bold('CAPACITY MODEL'):<{col_w}}",
            f"{'─' * (col_w - 2):<{col_w}}",
            f"{'Status':<14}: {analysis.trust.format_badge()}",
            f"{'Candidate':<14}: {best.label}",
            f"{r2_label:<14}: {best.r_squared:.4f}",
            f"{'LOO RMSE':<14}: {Presentation.format_seconds(best.validation_rmse)}",
            f"{'DOF':<14}: {len(analysis.data_points)} sizes · {analysis.residual_dof} residual",
            f"{'Slope':<14}: {slope_str}",
            "",
        ]
        if analysis.is_fit_trusted:
            right_lines += [
                f"{'input size':<14} {'latency':<12} {'throughput':<12} basis",
                f"{latest.input_size:,.0f} {analysis.input_unit:<6} {Presentation.format_seconds(latest.mean_seconds):<12} {rate_str.split(' ')[0]:<12} meas 95%",
            ]
            for ext in analysis.extrapolations:
                dist = ext.input_size / latest.input_size
                ext_rate = ext.throughput_rate_str or "-"
                right_lines.append(
                    f"{ext.input_size:,.0f} {analysis.input_unit:<6} "
                    f"{Presentation.format_seconds(ext.predicted_seconds):<12} "
                    f"{ext_rate:<12} ext ({dist:.0f}×)"
                )
        else:
            right_lines += [
                f"{Style.yellow('⚠ FORECASTS WITHHELD')}",
                f"  {analysis.trust.reason}.",
                "  Add parameter sizes before using this model",
                "  for capacity estimates.",
            ]

        header_title = f" {analysis.name} "
        header_meta = f" {len(analysis.data_points)} sizes · {analysis.size_range} {analysis.input_unit} "
        gap = card_w - 6 - len(header_title) - len(header_meta)
        if gap < 2:
            header_line = f"╭──{header_title}{'─' * max(2, card_w - 4 - len(header_title))}╮"
        else:
            header_line = f"╭──{header_title}{'─' * gap}{header_meta}──╮"

        body_lines = [header_line, f"│ {' ' * (card_w - 4)} │"]
        for l_pad, r_pad in self._pad_columns(left_lines, right_lines, col_w):
            body_lines.append(f"│  {l_pad}  │  {r_pad}  │")
        body_lines.append(f"│ {' ' * (card_w - 4)} │")
        body_lines.append(f"╰{'─' * (card_w - 2)}╯")
        return "\n".join(body_lines)

    def _render_narrow_card(self, analysis: SeriesAnalysis) -> str:
        best = analysis.best_model
        latest = analysis.largest_measurement
        r2_label = f"{R_SQUARED} (in-sample)"
        slope_str = f"{Presentation.format_estimate_interval(latest.slope)}" + (
            f" ({R_SQUARED}={latest.slope_r_squared:.3f})" if latest.slope_r_squared else ""
        )
        lines: list[str] = [
            f"{analysis.name:<46} {len(analysis.data_points)} sizes · {analysis.size_range} {analysis.input_unit}",
            "",
            "MEASUREMENT",
            f"  {'Largest':<10}: {latest.input_size:,.0f} {analysis.input_unit}",
            f"  {'Runtime':<10}: {latest.timing.format_with_ci()}  95% CI",
            f"  {'Throughput':<10}: {latest.throughput_rate_str or 'N/A'}",
            f"  {'Median':<10}: {Presentation.format_estimate_interval(latest.median)}",
            f"  {'MAD':<10}: {Presentation.format_estimate_interval(latest.mad)}",
            f"  {'Std Dev':<10}: {Presentation.format_estimate_interval(latest.std_dev)}",
            f"  {'Outliers':<10}: {latest.outliers.format_summary()}",
            "",
            "BASELINE COMPARISON",
        ]
        if latest.change_vs_base:
            lines += [
                f"  {'Δ vs base':<9}: {latest.change_vs_base.format_badge()}",
                f"  {'Decision':<9}: {latest.change_vs_base.format_decision_line()}",
            ]
        else:
            lines.append(f"  {'Δ vs base':<9}: {Style.dim('⚪ n/a (no baseline recorded)')}")
        lines += [
            "",
            "CAPACITY MODEL",
            f"  {'Status':<14}: {analysis.trust.format_badge()}",
            f"  {'Candidate':<14}: {best.label}",
            f"  {r2_label:<14}: {best.r_squared:.4f}",
            f"  {'LOO RMSE':<14}: {Presentation.format_seconds(best.validation_rmse)}",
            f"  {'DOF':<14}: {len(analysis.data_points)} sizes · {analysis.residual_dof} residual",
            f"  {'Slope':<14}: {slope_str}",
        ]
        if not analysis.is_fit_trusted:
            lines += [
                "",
                f"  {Style.yellow('⚠ FORECASTS WITHHELD')}",
                f"  {analysis.trust.reason}.",
                "  Add input sizes before using this model for capacity estimates.",
            ]
        else:
            lines += [
                "",
                "  OUTLOOK (model-based estimates)",
                f"  {'input size':<18} {'time':<22} basis",
                f"  {'-' * 16:<18} {'-' * 20:<22} ----------------------------",
                (
                    f"  {f'{latest.input_size:,.0f} {analysis.input_unit}':<18} "
                    f"{latest.timing.format_with_ci():<22} measured · 95% CI"
                ),
            ]
            for extrapolation in analysis.extrapolations:
                distance = extrapolation.input_size / latest.input_size
                lines.append(
                    f"  {f'{extrapolation.input_size:,} {analysis.input_unit}':<18} "
                    f"{Presentation.format_seconds(extrapolation.predicted_seconds):<22} "
                    f"extrapolated · {distance:.1f}× range"
                )
        return "\n".join(lines)

    def render_group_card(
        self, group: str, analyses: Sequence[SeriesAnalysis], width: int | None = None
    ) -> str:
        """Compact multi-row card for benchmark variants sharing one Criterion group:
        one row per variant instead of N fully-chromed individual cards, since the
        rows are directly comparable and full per-variant chrome is pure duplication."""
        width = Presentation.terminal_width() if width is None else width
        card_w = min(114, max(96, width - 2))
        inner_w = card_w - 4

        header_title = f" Group: {group} "
        header_meta = f" {len(analyses)} variants "
        gap = card_w - 6 - len(header_title) - len(header_meta)
        if gap < 2:
            header_line = f"╭──{header_title}{'─' * max(2, card_w - 4 - len(header_title))}╮"
        else:
            header_line = f"╭──{header_title}{'─' * gap}{header_meta}──╮"

        columns = (
            f"{'VARIANT':<20} {'STATUS':<15} {'SIZES':<18} {'LATEST':<9} "
            f"{'THROUGHPUT':<13} {'Δ vs BASE':<9}"
        )
        body_rows = [columns, "─" * len(columns)]
        for analysis in analyses:
            latest = analysis.largest_measurement
            variant = latest.function or "(default)"
            delta = (
                latest.change_vs_base.format_short()
                if latest.change_vs_base
                else Style.dim("n/a")
            )
            throughput = (latest.throughput_rate_str or "N/A").split(" [")[0]
            body_rows.append(
                " ".join((
                    Presentation.truncate_middle(variant, 20).ljust(20),
                    Style.pad_visible(analysis.trust.format_badge(), 15),
                    f"{len(analysis.data_points)} \u00b7 {analysis.size_range}".ljust(18),
                    Presentation.format_seconds(latest.mean_seconds).ljust(9),
                    throughput.ljust(13),
                    Style.pad_visible(delta, 9),
                ))
            )

        lines = [header_line, f"│ {' ' * inner_w} │"]
        for row in body_rows:
            lines.append(f"│ {Style.pad_visible(row, inner_w)} │")
        lines.append(f"│ {' ' * inner_w} │")
        lines.append(f"╰{'─' * (card_w - 2)}╯")
        return "\n".join(lines)


class SummaryReporter:
    """Renders the overview of every fitted series in a clean widescreen table."""

    def __init__(
        self,
        worst_count: int = DEFAULT_WORST_COUNT,
        target: int = SUMMARY_TARGET,
    ) -> None:
        self._worst_count = worst_count
        self._target = target

    def render(self, data: SummaryData, width: int | None = None) -> str:
        width = Presentation.terminal_width() if width is None else width
        lines: list[str] = [
            f"{'═' * min(100, width)}",
            f"{Style.bold('PERFORMANCE SUMMARY')}",
            (
                f"{data.total_series} series evaluated  │  {Style.green(str(data.supported_fit_count) + ' supported')}"
                f"  │  {Style.yellow(str(data.unreliable_count) + ' inconclusive')}"
                f"  │  {Style.dim(str(data.constant_count) + ' near-constant')}"
            ),
            *self._ranked_lines(data, width),
            *self._unreliable_lines(data, width),
            *self._scaling_lines(data),
            *self._constant_lines(data, width),
            f"{'═' * min(100, width)}",
        ]
        return "\n".join(lines)

    def _ranked_lines(self, data: SummaryData, width: int) -> list[str]:
        if not data.ranked:
            return []
        shown = data.ranked[: self._worst_count]
        lines: list[str] = [
            "",
            f"{Style.bold(f'TOP PERFORMANCE CONSUMERS AT {self._target // 1000}K (top {len(shown)}):')}",
            f"  {'Rank':<5} {'Benchmark Name':<34} {'Range (n)':<16} {'Baseline Δ':<14} {'Complexity':<14} {R_SQUARED:<6} {'Est. @ 100K':<12} Status",
            f"  {'─'*4:<5} {'─'*32:<34} {'─'*14:<16} {'─'*12:<14} {'─'*12:<14} {'─'*5:<6} {'─'*10:<12} {'─'*12}",
        ]
        for rank, entry in enumerate(shown, start=1):
            name = Presentation.truncate_middle(entry.name, 32)
            delta = entry.change_vs_base.format_short() if entry.change_vs_base else Style.dim("n/a")
            est = Presentation.format_seconds(entry.predicted_seconds)
            lines.append(
                f"   {rank:<3} {name:<34} {entry.range_str:<16} {delta:<14} "
                f"{entry.model.kind.short_label:<14} {entry.model.r_squared:.3f}  "
                f"{est:>10}  {Style.green('🟢 EXPLORATORY')}"
            )
        return lines

    def _unreliable_lines(self, data: SummaryData, width: int) -> list[str]:
        if not data.unreliable:
            return []
        lines: list[str] = [
            "",
            f"{Style.bold('INCONCLUSIVE SERIES (insufficient DOF or weak correlation):')}",
            f"  {'Benchmark Name':<34} {'Range (n)':<16} {'Sizes / DOF':<12} {'Baseline Δ':<14} {R_SQUARED:<6} Reason",
            f"  {'─'*32:<34} {'─'*14:<16} {'─'*10:<12} {'─'*12:<14} {'─'*5:<6} {'─'*24}",
        ]
        for entry in data.unreliable:
            name = Presentation.truncate_middle(entry.name, 32)
            delta = entry.change_vs_base.format_short() if entry.change_vs_base else Style.dim("n/a")
            dof_str = f"{entry.sizes_count} / {entry.residual_dof}"
            reason_badge = (
                Style.yellow("🟡 " + entry.reason)
                if "need" in entry.reason or "inconclusive" in entry.reason
                else Style.red("🔴 " + entry.reason)
            )
            lines.append(
                f"  {name:<34} {entry.range_str:<16} {dof_str:<12} {delta:<14} "
                f"{entry.model.r_squared:.3f}  {reason_badge}"
            )
        return lines

    @staticmethod
    def _scaling_lines(data: SummaryData) -> list[str]:
        lines: list[str] = ["", f"{Style.bold('SCALING BREAKDOWN:')}"]
        for kind, count in data.scaling_counts.items():
            if count > 0:
                lines.append(
                    f"  {kind.short_label:<14}  {kind.breakdown_description}:"
                    f" {count} series"
                )
        return lines

    @staticmethod
    def _constant_lines(data: SummaryData, width: int) -> list[str]:
        if not data.constant:
            return []
        lines: list[str] = ["", f"{Style.bold('NEAR-CONSTANT (no scaling concern):')}"]
        for entry in data.constant:
            name = Presentation.truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            lines.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {Presentation.format_seconds(entry.mean_seconds):>8}  all sizes"
            )
        return lines


class SeriesPlotRenderer:
    """Renders responsive terminal plots (single latency, or latency+throughput combined)."""

    def render(self, analysis: SeriesAnalysis, width: int | None = None) -> None:
        width = Presentation.terminal_width() if width is None else width

        if width >= COMBINED_PLOT_THRESHOLD and analysis.has_throughput:
            self._render_combined_plot(analysis, width)
        else:
            self._render_single_latency_plot(analysis, width)

    @staticmethod
    def _spans_orders_of_magnitude(x: Sequence[float]) -> bool:
        """True when x spans more than one order of magnitude: a linear axis would
        crush most points into a sliver near the origin, so prefer log-x instead."""
        positive = [v for v in x if v > 0]
        return bool(positive) and max(positive) / min(positive) >= 10

    @staticmethod
    def _plot_latency(plt, analysis: SeriesAnalysis, x: list[float], scale: float) -> None:
        """Measured points (95% CI error bars) plus, when trusted, the fit curve as a
        smooth 'braille' line, visually distinct from the measured crosshairs, plus a
        dim reference line at the previous baseline mean when a comparison exists."""
        y = [p.mean_seconds * scale for p in analysis.data_points]
        yerr = [(p.upper_seconds - p.lower_seconds) / 2 * scale for p in analysis.data_points]
        plt.error(x, y, yerr=yerr, color=Style.plot_color("cyan"), label="measured (95% CI)")

        if analysis.is_fit_trusted:
            curve_x = np.linspace(min(x), max(x), 100)
            curve_y = [analysis.best_model.predict(float(val)) * scale for val in curve_x]
            plt.plot(
                curve_x.tolist(),
                curve_y,
                label=f"fit: {analysis.best_model.kind.short_label}",
                color=Style.plot_color("yellow"),
                marker="braille",
            )

        latest = analysis.largest_measurement
        change = latest.change_vs_base
        if change and change.time_pct != -100.0:
            baseline_seconds = latest.mean_seconds / (1.0 + change.time_pct / 100.0)
            plt.hline(baseline_seconds * scale, color=Style.plot_color("magenta"))

    def _render_single_latency_plot(self, analysis: SeriesAnalysis, width: int) -> None:
        import plotext as plt

        plt.clear_figure()
        plt.plotsize(min(PLOT_MAX_WIDTH, max(PLOT_MIN_WIDTH, width - 4)), PLOT_HEIGHT)
        plt.theme("clear")
        plt.title("LATENCY & SCALING FIT (T vs n)")
        plt.xlabel(f"Input Size: n ({analysis.input_unit})")

        x = [p.input_size for p in analysis.data_points]
        if self._spans_orders_of_magnitude(x):
            plt.xscale("log")
        max_time = max(p.mean_seconds for p in analysis.data_points)
        unit, scale = Presentation.time_unit(max_time)
        plt.ylabel(f"Time ({unit})")

        self._plot_latency(plt, analysis, x, scale)
        plt.show()
        print()

    def _render_combined_plot(self, analysis: SeriesAnalysis, width: int) -> None:
        """Latency (left axis, with fit + error bars) and throughput (right axis) on
        one plot sharing a single x-axis, so both are directly comparable at the same
        input size instead of paying for two independent, half-width x-axes."""
        import plotext as plt

        plt.clear_figure()
        plt.plotsize(min(PLOT_MAX_WIDTH, max(PLOT_MIN_WIDTH, width - 4)), PLOT_HEIGHT)
        plt.theme("clear")
        plt.title("LATENCY & THROUGHPUT (T, Rate vs n)")
        plt.xlabel(f"n ({analysis.input_unit})")

        x = [p.input_size for p in analysis.data_points]
        if self._spans_orders_of_magnitude(x):
            plt.xscale("log")
        max_time = max(p.mean_seconds for p in analysis.data_points)
        unit, scale = Presentation.time_unit(max_time)
        plt.ylabel(f"Time ({unit})")
        self._plot_latency(plt, analysis, x, scale)

        th_values = [p.throughput_rate_value for p in analysis.data_points]
        valid_th = [v for v in th_values if v is not None]
        if valid_th:
            max_th = max(valid_th)
            if analysis.data_points[0].throughput_bytes is not None:
                th_unit = "GB/s" if max_th >= 1e9 else "MB/s" if max_th >= 1e6 else "KB/s"
                th_scale = 1e-9 if max_th >= 1e9 else 1e-6 if max_th >= 1e6 else 1e-3
            else:
                th_unit = "M elem/s" if max_th >= 1e6 else "K elem/s"
                th_scale = 1e-6 if max_th >= 1e6 else 1e-3

            th_y = [(v * th_scale if v is not None else 0) for v in th_values]
            plt.ylabel(f"Rate ({th_unit})", yside="right")
            plt.scatter(
                x, th_y, label="rate", color=Style.plot_color("green"), marker="dot", yside="right"
            )
            plt.plot(x, th_y, color=Style.plot_color("green"), marker="dot", yside="right")

        plt.show()
        print()


