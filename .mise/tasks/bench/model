@dataclass(frozen=True, slots=True)
class CliOptions:
    """Resolved command-line options for one invocation."""

    criterion_dir: Path
    plot: bool = False
    summary: bool = False
    worst_count: int = DEFAULT_WORST_COUNT

    @classmethod
    def from_env(cls, argv: Sequence[str] | None = None) -> CliOptions:
        raw_argv = sys.argv[1:] if argv is None else list(argv)

        parser = argparse.ArgumentParser(add_help=False)
        parser.add_argument(
            "criterion_dir",
            nargs="?",
            default=os.environ.get("usage_criterion_dir", DEFAULT_CRITERION_DIR),
        )
        parser.add_argument("-p", "--plot", action="store_true")
        parser.add_argument(
            "-s",
            "--summary",
            nargs="?",
            const=DEFAULT_WORST_COUNT,
            type=int,
            default=None,
        )

        args, _ = parser.parse_known_args(raw_argv)

        env_summary = os.environ.get("usage_summary")
        summary_active = args.summary is not None or env_summary is not None
        worst_count = DEFAULT_WORST_COUNT

        if args.summary is not None:
            worst_count = args.summary
        elif env_summary:
            try:
                worst_count = int(env_summary)
            except ValueError:
                raise SystemExit(
                    f"invalid --summary count: {env_summary!r}"
                    " (need a positive integer)"
                ) from None

        if worst_count < 1:
            raise SystemExit(
                f"invalid --summary count: {worst_count}"
                " (need a positive integer)"
            )

        plot_active = args.plot or os.environ.get("usage_plot") == "true"

        return cls(
            criterion_dir=Path(args.criterion_dir),
            plot=plot_active,
            summary=summary_active,
            worst_count=worst_count,
        )


def main(argv: Sequence[str] | None = None) -> int:
    """Run the `load -> fit -> render` pipeline."""
    options = CliOptions.from_env(argv)

    try:
        series_map = CriterionRepository(options.criterion_dir).load_series()
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    if not series_map:
        print(
            "No usable benchmark series found under "
            f"{options.criterion_dir} (need numeric input-size parameters).",
            file=sys.stderr,
        )
        return 1

    fitter = ModelFitter()
    analyses: list[SeriesAnalysis] = []
    had_failure = False
    for name in sorted(series_map):
        series = series_map[name]
        if len(series) < MIN_POINTS_TO_FIT:
            had_failure = True
            continue
        models = fitter.fit(series)
        if not models:
            had_failure = True
            continue
        analyses.append(SeriesAnalysis(series=series, models=models))

    if options.summary:
        data = build_summary(analyses)
        print(SummaryReporter(worst_count=options.worst_count).render(data))
    else:
        reporter = SeriesReporter()
        plot_renderer = SeriesPlotRenderer()

        groups: dict[str, list[SeriesAnalysis]] = {}
        for analysis in analyses:
            groups.setdefault(analysis.group, []).append(analysis)

        # One unit per standalone series, or per group of 2+ variants sharing a
        # Criterion group (rendered once, compactly, at its first occurrence).
        units: list[tuple[str, list[SeriesAnalysis]]] = []
        seen_groups: set[str] = set()
        for analysis in analyses:
            if analysis.group in seen_groups:
                continue
            members = groups[analysis.group]
            if len(members) > 1:
                seen_groups.add(analysis.group)
            units.append((analysis.group, members))

        width = Presentation.terminal_width()
        total = len(units)
        for i, (group, members) in enumerate(units, 1):
            print()
            print(Style.dim(f"[{i}/{total}]"))
            if len(members) > 1 and width >= WIDESCREEN_THRESHOLD:
                print(reporter.render_group_card(group, members, width))
                continue
            for analysis in members:
                print(reporter.render_card(analysis, width))
                if options.plot:
                    print()
                    plot_renderer.render(analysis, width)

    return 1 if had_failure else 0


if __name__ == "__main__":
    sys.exit(main())
