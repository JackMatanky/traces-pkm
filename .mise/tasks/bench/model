#                         Model Fitting                         #
# ------------------------------------------------------------- #


class ModelFitter:
    """Fits OLS candidate models and ranks them by leave-one-out error."""

    def fit(
        self, series: BenchmarkSeries | Sequence[BenchmarkDataPoint]
    ) -> tuple[FittedModel, ...]:
        """Fit every candidate kind, ordered by leave-one-out RMSE."""
        data_points = (
            series.data_points if isinstance(series, BenchmarkSeries) else series
        )
        x = np.array([point.input_size for point in data_points])
        y = np.array([point.mean_seconds for point in data_points])
        if np.var(y) == 0:
            return ()

        kinds = [ModelKind.LINEAR, ModelKind.LOG]
        if len(data_points) >= MIN_POINTS_FOR_COMBINED:
            kinds.append(ModelKind.COMBINED)
        models = [self._fit_kind(kind, x, y) for kind in kinds]
        return tuple(sorted(models, key=self._rank_key))

    @staticmethod
    def _rank_key(model: FittedModel) -> tuple[float, float, int]:
        """Rank by RMSE (relative) then R² (absolute), then declaration order.

        Different least-squares solvers can disagree in the last float bits
        on degenerate inputs (e.g. a constant or two-point ``x``), which
        would otherwise make the winning candidate depend on which solver
        ran rather than on real fit quality. RMSE spans nanoseconds to
        seconds, so it needs *relative* rounding (9 significant figures);
        R² is bounded near ``[0, 1]``, so noise shows up as tiny deviations
        around zero where relative rounding does nothing, needing *absolute*
        rounding instead. Both snap solver noise into exact ties, which then
        fall back to ``ModelKind`` declaration order (simplest model first)
        via the enum ordinal, instead of leaving the tiebreak an incidental
        side effect of sort stability.
        """
        return (
            float(f"{model.validation_rmse:.9g}"),
            round(-model.r_squared, 9),
            tuple(ModelKind).index(model.kind),
        )

    @staticmethod
    def _ols_fit(features: np.ndarray, y: np.ndarray) -> tuple[np.ndarray, float]:
        """Fit ``y = features @ coeffs[:-1] + coeffs[-1]`` via least squares.

        Returns the coefficient vector (feature weights then intercept) and
        the in-sample R² score. Plain ``numpy.linalg.lstsq`` reproduces
        scikit-learn's ``LinearRegression`` exactly for this two-to-three
        parameter design, avoiding a whole extra dependency for one OLS solve.
        """
        design = np.column_stack([features, np.ones(len(y))])
        coeffs, *_ = np.linalg.lstsq(design, y, rcond=None)
        residuals = y - design @ coeffs
        ss_res = float(np.sum(residuals**2))
        ss_tot = float(np.sum((y - y.mean()) ** 2))
        r_squared = 1.0 - ss_res / ss_tot if ss_tot > 0 else 1.0
        return coeffs, r_squared

    @staticmethod
    def _fit_kind(kind: ModelKind, x: np.ndarray, y: np.ndarray) -> FittedModel:
        features = kind.design_matrix(x)
        coeffs, r_squared = ModelFitter._ols_fit(features, y)
        *feature_coeffs, intercept = coeffs
        return FittedModel(
            kind=kind,
            coeff_n=float(feature_coeffs[0]),
            coeff_nlogn=float(feature_coeffs[1])
            if kind is ModelKind.COMBINED
            else 0.0,
            coeff_intercept=float(intercept),
            r_squared=r_squared,
            validation_rmse=ModelFitter._leave_one_out_rmse(features, y),
        )

    @staticmethod
    def _leave_one_out_rmse(features: np.ndarray, y: np.ndarray) -> float:
        if len(y) - 1 < features.shape[1] + 1:
            return float("inf")
        errors = np.empty(len(y))
        for index in range(len(y)):
            mask = np.ones(len(y), dtype=bool)
            mask[index] = False
            coeffs, _ = ModelFitter._ols_fit(features[mask], y[mask])
            design_row = np.append(features[index], 1.0)
            errors[index] = y[index] - design_row @ coeffs
        return float(np.sqrt(np.mean(np.square(errors))))


