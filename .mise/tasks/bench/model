@dataclass(frozen=True, slots=True)
class CliOptions:
    """Resolved command-line options for one invocation.

    Attributes:
        criterion_dir: Criterion output directory to read.
        plot: Render per-series terminal plots (default mode only).
        summary: Print the single summary box instead of per-series boxes.
        worst_count: Rows in the summary's worst-performer list.
    """

    criterion_dir: Path
    plot: bool = False
    summary: bool = False
    worst_count: int = DEFAULT_WORST_COUNT

    @classmethod
    def from_env(cls, argv: Sequence[str] | None = None) -> CliOptions:
        """Build options from mise ``usage_*`` environment variables.

        ``--summary`` is a value-optional flag: the variable is unset when
        the flag is absent, ``""`` when given bare (default worst count),
        and the count itself when given a value. Direct (non-``mise``)
        invocation falls back to ``argv`` for the directory.

        Args:
            argv: Positional arguments (defaults to ``sys.argv[1:]``).

        Returns:
            Parsed options.

        Raises:
            SystemExit: If ``--summary``'s count is not a positive integer.
        """
        argv = sys.argv[1:] if argv is None else argv
        raw_summary = os.environ.get("usage_summary")
        summary = raw_summary is not None
        worst_count = DEFAULT_WORST_COUNT
        if raw_summary:
            try:
                worst_count = int(raw_summary)
                if worst_count < 1:
                    raise ValueError
            except ValueError:
                raise SystemExit(
                    f"invalid --summary count: {raw_summary!r}"
                    " (need a positive integer)"
                ) from None

        positional = next(
            (arg for arg in argv if not arg.startswith("-") and arg != "--"),
            None,
        )
        criterion_dir = os.environ.get("usage_criterion_dir") or (
            positional or DEFAULT_CRITERION_DIR
        )
        return cls(
            criterion_dir=Path(criterion_dir),
            plot=os.environ.get("usage_plot") == "true"
            or "-p" in argv
            or "--plot" in argv,
            summary=summary,
            worst_count=worst_count,
        )


def main(argv: Sequence[str] | None = None) -> int:
    """Run the `load -> fit -> render` pipeline.

    Args:
        argv: Positional arguments (defaults to ``sys.argv[1:]``).

    Returns:
        ``0`` when every series fit; ``1`` on missing/empty criterion output or any
        per-series fit failure (failures never abort the loop; successful series
        still report).
    """
    options = CliOptions.from_env(argv)

    try:
        series = CriterionRepository(options.criterion_dir).load_series()
    except FileNotFoundError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    if not series:
        print(
            "No usable benchmark series found under "
            f"{options.criterion_dir} (need numeric input-size parameters).",
            file=sys.stderr,
        )
        return 1

    fitter = ModelFitter()
    analyses: list[SeriesAnalysis] = []
    had_failure = False
    for name in sorted(series):
        data_points = tuple(series[name])
        if len(data_points) < MIN_POINTS_TO_FIT:
            print(
                f"Skipping {name}: need >= {MIN_POINTS_TO_FIT} data points,"
                f" found {len(data_points)}.",
                file=sys.stderr,
            )
            had_failure = True
            continue
        models = fitter.fit(data_points)
        if not models:
            print(
                f"Could not fit models for {name} (zero variance).",
                file=sys.stderr,
            )
            had_failure = True
            continue
        analyses.append(
            SeriesAnalysis(name=name, data_points=data_points, models=models)
        )

    if options.summary:
        data = build_summary(analyses)
        print(SummaryReporter(worst_count=options.worst_count).render(data))
    else:
        reporter = SeriesReporter()
        for analysis in analyses:
            print()
            print(reporter.render_summary(analysis))
            if options.plot:
                SeriesPlotRenderer().render(analysis)
            print(reporter.render_details(analysis))

    return 1 if had_failure else 0


if __name__ == "__main__":
    sys.exit(main())
