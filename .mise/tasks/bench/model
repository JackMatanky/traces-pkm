class ModelKind(Enum):
    """Complexity class of a fitted performance model."""

    LINEAR = ("O(n) + constant", "O(n)", "linear cost", 2)
    LOG = ("O(n·ln n) + constant", "O(n·ln n)", "n·ln n cost", 2)
    COMBINED = (
        "O(n) + O(n·ln n) + constant",
        "O(n)+O(n·ln n)",
        "combined cost",
        3,
    )

    def __init__(
        self,
        label: str,
        short_label: str,
        breakdown_description: str,
        parameter_count: int,
    ) -> None:
        self.label = label
        self.short_label = short_label
        self.breakdown_description = breakdown_description
        self.parameter_count = parameter_count

    def design_matrix(self, x: np.ndarray) -> np.ndarray:
        """Construct the regression feature matrix for input array ``x``."""
        match self:
            case ModelKind.LINEAR:
                return x.reshape(-1, 1)
            case ModelKind.LOG:
                return (x * np.log(x)).reshape(-1, 1)
            case ModelKind.COMBINED:
                return np.column_stack([x, x * np.log(x)])


class FitTrust(Enum):
    """Ordered evidence outcomes for model reporting and forecasting."""

    INSUFFICIENT_INPUT_SIZES = (
        "INCONCLUSIVE",
        f"need at least {MIN_POINTS_FOR_TRUSTED_FIT} input sizes",
    )
    INSUFFICIENT_RESIDUAL_DOF = (
        "INCONCLUSIVE",
        f"need at least {MIN_RESIDUAL_DOF} residual DOF",
    )
    UNVALIDATED = ("UNVALIDATED", "leave-one-out validation is unavailable")
    WEAK_R_SQUARED = (
        "WEAK",
        f"in-sample {R_SQUARED} is below {R2_RELIABLE_THRESHOLD:.2f}",
    )
    EXPLORATORY = ("EXPLORATORY", "supported")

    def __init__(self, label: str, reason: str) -> None:
        self.label = label
        self.reason = reason

    @property
    def is_trusted(self) -> bool:
        """Whether the status permits drawing a fit curve and extrapolations."""
        return self is FitTrust.EXPLORATORY

    def format_badge(self) -> str:
        """Return a colored badge for terminal presentation."""
        match self:
            case FitTrust.EXPLORATORY:
                return f"{Style.green('🟢 ' + self.label)}"
            case FitTrust.INSUFFICIENT_INPUT_SIZES | FitTrust.INSUFFICIENT_RESIDUAL_DOF:
                return f"{Style.yellow('🟡 ' + self.label)}"
            case FitTrust.WEAK_R_SQUARED:
                return f"{Style.red('🔴 ' + self.label)}"
            case _:
                return f"{Style.dim('⚪ ' + self.label)}"


