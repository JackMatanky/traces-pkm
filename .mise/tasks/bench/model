#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy", "scikit-learn", "plotext<6"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" help="Criterion output directory" default="target/criterion"
# [USAGE] flag "-p --plot" help="Render scatter plots with fitted curves in the terminal"
# [USAGE] flag "-s --summary [count]" value_optional=#true help="Print one high-level summary box; optional count caps the worst-performer list (default: 10)"

"""Fit performance models to Criterion benchmark output.

Pipeline (`load -> fit -> analyze -> render`):

1. :class:`CriterionRepository` walks the Criterion JSON tree and groups
   measurements into series (a group's flat sweep, or ``<group>/<function>``
   for groups with named sub-benchmarks).
2. :class:`ModelFitter` fits candidate complexity models (:class:`ModelKind`)
   to each series via OLS.
3. :class:`SeriesAnalysis` wraps a fitted series with derived insights (fit
   quality, constant detection, extrapolation eligibility).
4. Renderers turn analyses into box-drawn terminal reports: one box per series
   by default, or a single :class:`SummaryReporter` box with
   ``--summary [count]``.

Exit code ``1`` if the criterion directory is missing, no usable series are found,
or any series failed to fit; every series that could fit is still reported.
"""

from __future__ import annotations

import json
import os
import sys
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import Any, Final

import numpy as np
from sklearn.linear_model import LinearRegression

# ------------------------------------------------------------- #
#                           Constants                           #
# ------------------------------------------------------------- #

# Defaults & sweep sizes
DEFAULT_CRITERION_DIR: Final = "target/criterion"
WORKSPACE_POINTS: Final = frozenset({50, 200, 1000, 5000, 20000, 40000})
EXTRAPOLATION_TARGETS: Final = (50_000, 100_000)
SUMMARY_TARGET: Final = 100_000
DEFAULT_WORST_COUNT: Final = 10

# Fit-quality thresholds
MIN_POINTS_TO_FIT: Final = 2
MIN_POINTS_FOR_COMBINED: Final = 5
COMBINED_MIN_RESIDUAL_DOF: Final = 3
CONSTANT_SPREAD_EPSILON: Final = 1e-4

# R² quality grades
R2_RELIABLE_THRESHOLD: Final = 0.95
R2_QUALITY_LEVELS: Final = (
    (0.99, "excellent"),
    (0.95, "good"),
    (0.90, "fair"),
)
R_SQUARED: Final = "R²"

# Report box and plot dimensions
SERIES_BOX_WIDTH: Final = 60
SUMMARY_BOX_WIDTH: Final = 64
SUMMARY_NAME_WIDTH: Final = 32
PLOT_WIDTH: Final = 60
PLOT_HEIGHT: Final = 10


# ------------------------------------------------------------- #
#                        Model Complexity                       #
# ------------------------------------------------------------- #


class ModelKind(Enum):
    """Complexity class of a fitted performance model.

    Each member owns its label, formula, and coefficient meanings so nothing
    string-matches model names.
    """

    LINEAR = "linear"
    LOG = "log"
    COMBINED = "combined"

    @property
    def label(self) -> str:
        """Complexity including the constant term."""
        match self:
            case ModelKind.LINEAR:
                return "O(n) + constant"
            case ModelKind.LOG:
                return "O(n·ln n) + constant"
            case ModelKind.COMBINED:
                return "O(n) + O(n·ln n) + constant"

    @property
    def short_label(self) -> str:
        """Compact complexity for table columns."""
        match self:
            case ModelKind.LINEAR:
                return "O(n)"
            case ModelKind.LOG:
                return "O(n·ln n)"
            case ModelKind.COMBINED:
                return "O(n)+O(n·ln n)"

    @property
    def formula(self) -> str:
        """Mathematical formula shown on plots."""
        match self:
            case ModelKind.LINEAR:
                return "y = a·n + b"
            case ModelKind.LOG:
                return "y = a·n·ln(n) + b"
            case ModelKind.COMBINED:
                return "y = a·n + b·n·ln(n) + c"

    @property
    def coefficient_specs(self) -> tuple[tuple[str, str], ...]:
        """Ordered ``(symbol, meaning)`` pairs matching
        :attr:`FittedModel.coefficients`."""
        match self:
            case ModelKind.LINEAR:
                return (
                    ("a", "per-file linear cost"),
                    ("b", "fixed overhead"),
                )
            case ModelKind.LOG:
                return (
                    ("a", "sort/comparison overhead per file"),
                    ("b", "fixed overhead"),
                )
            case ModelKind.COMBINED:
                return (
                    ("a", "per-file linear cost"),
                    ("b", "sort/comparison overhead per file"),
                    ("c", "fixed overhead"),
                )

    @property
    def breakdown_description(self) -> str:
        """One-line meaning for the summary's scaling breakdown."""
        match self:
            case ModelKind.LINEAR:
                return "linear per-file cost"
            case ModelKind.LOG:
                return "sort/comparison cost"
            case ModelKind.COMBINED:
                return "mixed cost"


# ------------------------------------------------------------- #
#                          Domain model                         #
# ------------------------------------------------------------- #


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """A single measured benchmark result from Criterion output.

    Attributes:
        group: Benchmark group name (e.g. ``FileIndex::build``); the
            subdirectory under ``target/criterion/``.
        file_count: Parameter value (the workspace size that was benchmarked).
        mean_seconds: Mean wall-clock time in seconds, converted from
            Criterion's nanosecond ``point_estimate``.
        function: Sub-benchmark name within the group (e.g. ``sort_only``);
            empty for a flat sweep.
    """

    group: str
    file_count: float
    mean_seconds: float
    function: str = ""


@dataclass(frozen=True, slots=True)
class Coefficient:
    """One fitted coefficient with its symbolic name and plain meaning.

    Attributes:
        symbol: Formula symbol (``a``, ``b``, or ``c``).
        value: Fitted numeric value.
        meaning: Human explanation of what the coefficient charges for.
    """

    symbol: str
    value: float
    meaning: str


@dataclass(frozen=True, slots=True)
class FittedModel:
    """A regression model fitted to benchmark data.

    Attributes:
        kind: Complexity class the coefficients belong to.
        coeff_n: Slope of the primary term (``a``).
        coeff_intercept: Constant term (``b`` for linear/log, ``c`` for
            combined).
        r_squared: Coefficient of determination; 1.0 is a perfect fit.
        coeff_nlogn: Slope of the ``n·ln(n)`` term; 0.0 unless combined.
    """

    kind: ModelKind
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    coeff_nlogn: float = 0.0

    @property
    def label(self) -> str:
        return self.kind.label

    @property
    def formula(self) -> str:
        return self.kind.formula

    @property
    def is_reliable(self) -> bool:
        """Whether R² is high enough for extrapolation."""
        return self.r_squared >= R2_RELIABLE_THRESHOLD

    @property
    def quality(self) -> str:
        """Fit-quality word: excellent / good / fair / poor."""
        for threshold, label in R2_QUALITY_LEVELS:
            if self.r_squared >= threshold:
                return label
        return "poor"

    @property
    def coefficients(self) -> tuple[Coefficient, ...]:
        """Coefficients ordered to match :attr:`ModelKind.coefficient_specs`."""
        values = {
            "a": self.coeff_n,
            "b": self.coeff_nlogn
            if self.kind is ModelKind.COMBINED
            else self.coeff_intercept,
            "c": self.coeff_intercept,
        }
        return tuple(
            Coefficient(symbol, values[symbol], meaning)
            for symbol, meaning in self.kind.coefficient_specs
        )

    def predict(self, file_count: float) -> float:
        """Predict mean seconds at the given workspace size.

        Args:
            file_count: Workspace size; must be > 0 for log/combined kinds.

        Returns:
            Predicted mean wall-clock time in seconds.
        """
        n = file_count
        match self.kind:
            case ModelKind.LINEAR:
                return self.coeff_n * n + self.coeff_intercept
            case ModelKind.LOG:
                return self.coeff_n * n * np.log(n) + self.coeff_intercept
            case ModelKind.COMBINED:
                return (
                    self.coeff_n * n
                    + self.coeff_nlogn * n * np.log(n)
                    + self.coeff_intercept
                )

    def dominant_term(self, file_count: float) -> str | None:
        """Which cost component dominates at ``file_count``.

        Only meaningful for the combined model (which has two growing terms);
        returns ``None`` for linear/log models.

        Args:
            file_count: Workspace size at which to compare term magnitudes.

        Returns:
            ``"linear"``, ``"O(n·ln n) sort"``, or ``"mixed"`` for combined
            models; ``None`` otherwise.
        """
        if self.kind is not ModelKind.COMBINED:
            return None
        n = float(file_count)
        linear = abs(self.coeff_n * n)
        log = abs(self.coeff_nlogn * n * np.log(n))
        if linear > 2 * log:
            return "linear"
        if log > 2 * linear:
            return "O(n·ln n) sort"
        return "mixed"


@dataclass(frozen=True, slots=True)
class Extrapolation:
    """A predicted time for a target workspace size.

    Attributes:
        file_count: Target workspace size (e.g. 50_000).
        predicted_seconds: Predicted mean wall-clock time in seconds.
        model_kind: Complexity class used for the prediction.
    """

    file_count: int
    predicted_seconds: float
    model_kind: ModelKind


@dataclass(frozen=True, slots=True)
class SeriesAnalysis:
    """One benchmark series with its fitted models and derived insights.

    All classification decisions (fit quality, constant detection, extrapolation
    eligibility) live here so reporters only format.

    Attributes:
        name: Series key (the group, or ``<group>/<function>`` for nested
            sweeps).
        data_points: Measurements sorted ascending by file count.
        models: Fitted models sorted best-first (R² descending).
    """

    name: str
    data_points: tuple[BenchmarkDataPoint, ...]
    models: tuple[FittedModel, ...]

    @property
    def best_model(self) -> FittedModel:
        return self.models[0]

    @property
    def file_counts(self) -> tuple[int, ...]:
        """Measured workspace sizes as integers."""
        return tuple(int(point.file_count) for point in self.data_points)

    @property
    def size_range(self) -> str:
        """``"<min> → <max>"`` display string for measured sizes."""
        counts = [point.file_count for point in self.data_points]
        return f"{min(counts):,.0f} → {max(counts):,.0f}"

    @property
    def mean_seconds(self) -> float:
        """Mean of the measured times (for constant-series reporting)."""
        return float(
            np.mean([point.mean_seconds for point in self.data_points])
        )

    @property
    def is_constant(self) -> bool:
        """True when the spread across sizes is negligible (fixed cost)."""
        times = [point.mean_seconds for point in self.data_points]
        return max(times) - min(times) < CONSTANT_SPREAD_EPSILON

    @property
    def is_workspace_series(self) -> bool:
        """True when every measured size is a known workspace size.

        Only workspace-parameterized series have a meaningful "N notes"
        interpretation, so only they get extrapolation rows.
        """
        return set(self.file_counts).issubset(WORKSPACE_POINTS)

    @property
    def residual_dof(self) -> int | None:
        """Residual degrees of freedom when the combined model is best."""
        if self.best_model.kind is not ModelKind.COMBINED:
            return None
        return len(self.data_points) - 3

    @property
    def has_low_dof(self) -> bool:
        """Combined model with too few points for its 3 free parameters."""
        dof = self.residual_dof
        return dof is not None and dof < COMBINED_MIN_RESIDUAL_DOF

    @property
    def extrapolations(self) -> tuple[Extrapolation, ...]:
        """Predictions at :data:`EXTRAPOLATION_TARGETS`, or empty.

        Empty when the best fit is unreliable or the series is not
        workspace-parameterized.
        """
        best = self.best_model
        if not best.is_reliable or not self.is_workspace_series:
            return ()
        return tuple(
            Extrapolation(size, best.predict(float(size)), best.kind)
            for size in EXTRAPOLATION_TARGETS
        )

    @property
    def has_negative_extrapolation(self) -> bool:
        """True when any prediction goes negative (model broken at scale)."""
        return any(ext.predicted_seconds < 0 for ext in self.extrapolations)

    @property
    def prediction_at_summary_target(self) -> float | None:
        """Reliable prediction at :data:`SUMMARY_TARGET`, for ranking."""
        if not self.best_model.is_reliable:
            return None
        return self.best_model.predict(float(SUMMARY_TARGET))


# ------------------------------------------------------------- #
#                       Criterion Loading                       #
# ------------------------------------------------------------- #


class CriterionRepository:
    """Reads benchmark measurements from a Criterion output directory.

    Expected directory layout (both sweep styles)::

        criterion_dir/
        ├── FileIndex__build/
        │   ├── 50/new/{benchmark,estimates}.json          <- flat
        │   └── ...
        └── QueryService__run__sort_by_metadata/
            ├── sort_only/
            │   ├── 5000/new/{benchmark,estimates}.json    <- nested
            │   └── ...
            └── sort_only_desc/
                └── ...

    Args:
        root: Criterion output directory, typically ``target/criterion``.
    """

    def __init__(self, root: Path) -> None:
        self._root = root

    def load_series(self) -> dict[str, list[BenchmarkDataPoint]]:
        """Load all measurements grouped by series key.

        Flat sweeps key on the group name; nested sweeps key on
        ``<group>/<function>`` so distinct sub-benchmarks (ascending vs.
        descending sort) never blend into one regression.

        Returns:
            Data points per series, each sorted ascending by file count. Series
            with fewer than 2 points are still returned; the caller checks the
            minimum.

        Raises:
            FileNotFoundError: If ``root`` does not exist.
        """
        if not self._root.exists():
            raise FileNotFoundError(f"Criterion output not found: {self._root}")

        series: dict[str, list[BenchmarkDataPoint]] = {}
        for group_dir in sorted(self._root.iterdir()):
            if group_dir.is_dir():
                self._load_group(series, group_dir)
        for points in series.values():
            points.sort(key=lambda point: point.file_count)
        return series

    def _load_group(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group_dir: Path,
    ) -> None:
        """Load one group directory (flat and/or nested sweeps)."""
        for child_dir in sorted(group_dir.iterdir()):
            if not child_dir.is_dir():
                continue
            if (child_dir / "new").is_dir():
                point = self._parse(group_dir.name, "", child_dir / "new")
                if point is not None:
                    series.setdefault(group_dir.name, []).append(point)
                continue
            self._load_nested(series, group_dir.name, child_dir)

    def _load_nested(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group: str,
        function_dir: Path,
    ) -> None:
        """Load one ``<group>/<function>/`` sub-benchmark sweep."""
        for size_dir in sorted(function_dir.iterdir()):
            if not size_dir.is_dir():
                continue
            results_dir = size_dir / "new"
            if not results_dir.is_dir():
                continue
            point = self._parse(group, function_dir.name, results_dir)
            if point is not None:
                series.setdefault(f"{group}/{function_dir.name}", []).append(
                    point
                )

    @staticmethod
    def _parse(
        group: str,
        function: str,
        results_dir: Path,
    ) -> BenchmarkDataPoint | None:
        """Parse one result from its ``new/`` directory.

        Reads ``benchmark.json`` for the parameter value and ``estimates.json``
        for the mean timing.

        Returns:
            A parsed point, or ``None`` if files are missing, malformed, or hold
            unexpected values (normal for un-run benchmarks).
        """
        try:
            bench: dict[str, Any] = json.loads(
                (results_dir / "benchmark.json").read_text()
            )
            estimates: dict[str, Any] = json.loads(
                (results_dir / "estimates.json").read_text()
            )
            file_count = float(bench["value_str"])
            mean_seconds = estimates["mean"]["point_estimate"] / 1e9
        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
        ):
            return None
        return BenchmarkDataPoint(
            group=group,
            file_count=file_count,
            mean_seconds=mean_seconds,
            function=function,
        )


# ------------------------------------------------------------- #
#                         Model Fitting                         #
# ------------------------------------------------------------- #


class ModelFitter:
    """Fits candidate complexity models to one benchmark series.

    Candidates are linear (``O(n)``) and log (``O(n·ln n)``) always, plus the
    combined model when there are at least :data:`MIN_POINTS_FOR_COMBINED`
    points (3 free parameters need room).
    """

    def fit(
        self, data_points: Sequence[BenchmarkDataPoint]
    ) -> tuple[FittedModel, ...]:
        """Fit every candidate kind and return models sorted by R².

        Args:
            data_points: Benchmark measurements for one series.

        Returns:
            Models best-first; empty when the data has zero variance
            (R² undefined for constant measurements).
        """
        x = np.array([point.file_count for point in data_points])
        y = np.array([point.mean_seconds for point in data_points])
        if np.var(y) == 0:
            return ()

        kinds = [ModelKind.LINEAR, ModelKind.LOG]
        if len(data_points) >= MIN_POINTS_FOR_COMBINED:
            kinds.append(ModelKind.COMBINED)
        models = [self._fit_kind(kind, x, y) for kind in kinds]
        return tuple(
            sorted(models, key=lambda model: model.r_squared, reverse=True)
        )

    @staticmethod
    def _fit_kind(kind: ModelKind, x: np.ndarray, y: np.ndarray) -> FittedModel:
        """OLS-fit one kind via scikit-learn on its design matrix."""
        features = ModelFitter._design_matrix(kind, x)
        regression = LinearRegression().fit(features, y)
        return FittedModel(
            kind=kind,
            coeff_n=float(regression.coef_[0]),
            coeff_nlogn=float(regression.coef_[1])
            if kind is ModelKind.COMBINED
            else 0.0,
            coeff_intercept=float(regression.intercept_),
            r_squared=float(regression.score(features, y)),
        )

    @staticmethod
    def _design_matrix(kind: ModelKind, x: np.ndarray) -> np.ndarray:
        """Build the feature columns for one model kind.

        Args:
            kind: Complexity class to design for.
            x: File counts (> 0 for log-bearing kinds).

        Returns:
            Column matrix: ``[x]``, ``[x·ln(x)]``, or ``[x, x·ln(x)]``.
        """
        match kind:
            case ModelKind.LINEAR:
                return x.reshape(-1, 1)
            case ModelKind.LOG:
                return (x * np.log(x)).reshape(-1, 1)
            case ModelKind.COMBINED:
                return np.column_stack([x, x * np.log(x)])


