@dataclass(frozen=True, slots=True)
class TimingInterval:
    """Mean wall-clock timing and its 95% bootstrap confidence interval."""

    mean_seconds: float
    lower_seconds: float
    upper_seconds: float

    @classmethod
    def from_criterion_nanoseconds(
        cls,
        point_estimate_ns: float,
        lower_ns: float,
        upper_ns: float,
    ) -> TimingInterval:
        """Construct from raw Criterion nanosecond estimates."""
        return cls(
            mean_seconds=float(point_estimate_ns) / 1e9,
            lower_seconds=float(lower_ns) / 1e9,
            upper_seconds=float(upper_ns) / 1e9,
        )

    def format_with_ci(self) -> str:
        """Format the estimate and 95% confidence bounds with auto-scaled units."""
        unit, scale = Presentation.time_unit(self.mean_seconds)
        precision = 2 if unit == "s" else 1
        return (
            f"{self.mean_seconds * scale:.{precision}f}{unit} "
            f"[{self.lower_seconds * scale:.{precision}f}, "
            f"{self.upper_seconds * scale:.{precision}f}]"
        )


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """One Criterion timing estimate at a measured input size."""

    group: str
    input_size: float
    input_unit: str
    timing: TimingInterval
    mild_outlier_count: int = 0
    severe_outlier_count: int = 0
    function: str = ""

    @property
    def mean_seconds(self) -> float:
        return self.timing.mean_seconds

    @property
    def lower_seconds(self) -> float:
        return self.timing.lower_seconds

    @property
    def upper_seconds(self) -> float:
        return self.timing.upper_seconds


@dataclass(frozen=True, slots=True)
class BenchmarkSeries:
    """A series of benchmark data points sharing a group/function key."""

    name: str
    data_points: tuple[BenchmarkDataPoint, ...]

    def __post_init__(self) -> None:
        # Guarantee points are strictly sorted ascending by input size
        if any(
            self.data_points[i].input_size > self.data_points[i + 1].input_size
            for i in range(len(self.data_points) - 1)
        ):
            sorted_points = tuple(
                sorted(self.data_points, key=lambda p: p.input_size)
            )
            object.__setattr__(self, "data_points", sorted_points)

    def __len__(self) -> int:
        return len(self.data_points)

    @property
    def input_sizes(self) -> tuple[int, ...]:
        return tuple(int(point.input_size) for point in self.data_points)

    @property
    def input_unit(self) -> str:
        units = {point.input_unit for point in self.data_points}
        return units.pop() if len(units) == 1 else "input units"

    @property
    def size_range(self) -> str:
        sizes = [point.input_size for point in self.data_points]
        return f"{min(sizes):,.0f} → {max(sizes):,.0f}"

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        return self.data_points[-1]

    @property
    def mean_seconds(self) -> float:
        return float(np.mean([point.mean_seconds for point in self.data_points]))

    @property
    def is_constant(self) -> bool:
        times = [point.mean_seconds for point in self.data_points]
        return max(times) - min(times) < CONSTANT_SPREAD_EPSILON


@dataclass(frozen=True, slots=True)
class FittedModel:
    """An OLS complexity model with in-sample and held-out evidence."""

    kind: ModelKind
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    validation_rmse: float
    coeff_nlogn: float = 0.0

    @property
    def label(self) -> str:
        return self.kind.label

    @property
    def parameter_count(self) -> int:
        return self.kind.parameter_count

    @property
    def has_high_r_squared(self) -> bool:
        return self.r_squared >= R2_RELIABLE_THRESHOLD

    def predict(self, input_size: float) -> float:
        """Predict mean seconds at a positive input size."""
        n = input_size
        match self.kind:
            case ModelKind.LINEAR:
                return self.coeff_n * n + self.coeff_intercept
            case ModelKind.LOG:
                return self.coeff_n * n * np.log(n) + self.coeff_intercept
            case ModelKind.COMBINED:
                return (
                    self.coeff_n * n
                    + self.coeff_nlogn * n * np.log(n)
                    + self.coeff_intercept
                )


@dataclass(frozen=True, slots=True)
class Extrapolation:
    """A model prediction beyond the measured input domain."""

    input_size: int
    predicted_seconds: float
    model_kind: ModelKind


@dataclass(frozen=True, slots=True)
class SeriesAnalysis:
    """One benchmark series with fitted models and trust decisions."""

    series: BenchmarkSeries
    models: tuple[FittedModel, ...]

    @property
    def name(self) -> str:
        return self.series.name

    @property
    def data_points(self) -> tuple[BenchmarkDataPoint, ...]:
        return self.series.data_points

    @property
    def best_model(self) -> FittedModel:
        return self.models[0]

    @property
    def input_sizes(self) -> tuple[int, ...]:
        return self.series.input_sizes

    @property
    def input_unit(self) -> str:
        return self.series.input_unit

    @property
    def size_range(self) -> str:
        return self.series.size_range

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        return self.series.largest_measurement

    @property
    def mean_seconds(self) -> float:
        return self.series.mean_seconds

    @property
    def is_constant(self) -> bool:
        return self.series.is_constant

    @property
    def residual_dof(self) -> int:
        return len(self.series) - self.best_model.parameter_count

    @property
    def trust(self) -> FitTrust:
        checks = (
            (
                FitTrust.INSUFFICIENT_INPUT_SIZES,
                len(self.series) < MIN_POINTS_FOR_TRUSTED_FIT,
            ),
            (
                FitTrust.INSUFFICIENT_RESIDUAL_DOF,
                self.residual_dof < MIN_RESIDUAL_DOF,
            ),
            (
                FitTrust.UNVALIDATED,
                not np.isfinite(self.best_model.validation_rmse),
            ),
            (FitTrust.WEAK_R_SQUARED, not self.best_model.has_high_r_squared),
        )
        return next(
            (status for status, failed in checks if failed),
            FitTrust.EXPLORATORY,
        )

    @property
    def is_fit_trusted(self) -> bool:
        return self.trust.is_trusted

    @property
    def extrapolations(self) -> tuple[Extrapolation, ...]:
        if not self.is_fit_trusted:
            return ()
        return tuple(
            Extrapolation(
                size,
                self.best_model.predict(float(size)),
                self.best_model.kind,
            )
            for size in EXTRAPOLATION_TARGETS
            if size > self.largest_measurement.input_size
        )

    @property
    def has_negative_extrapolation(self) -> bool:
        return any(ext.predicted_seconds < 0 for ext in self.extrapolations)

    @property
    def prediction_at_summary_target(self) -> float | None:
        if not self.is_fit_trusted:
            return None
        return self.best_model.predict(float(SUMMARY_TARGET))


