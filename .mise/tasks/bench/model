#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy", "scikit-learn", "plotext<6"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" default="target/criterion" {
# [USAGE]   help "Criterion output directory"
# [USAGE] }
# [USAGE] flag "-p --plot" {
# [USAGE]   help "Render measured input-size plots and supported fit curves in the terminal"
# [USAGE] }
# [USAGE] flag "-s --summary [count]" value_optional=#true {
# [USAGE]   help "Print one high-level summary table; optional count caps the worst-performer list (default: 10)"
# [USAGE] }

"""Fit performance models to Criterion benchmark output.

Pipeline (load -> fit -> analyze -> render):

1. CriterionRepository walks the Criterion JSON tree and produces BenchmarkSeries.
2. ModelFitter fits OLS complexity candidates and selects the lowest
   leave-one-out cross-validation error.
3. SeriesAnalysis evaluates evidence trust, outlook, and diagnostics.
4. SeriesReporter and SummaryReporter render clean, scan-first terminal reports.

Exit code 1 if the criterion directory is missing, no usable series are found,
or any series failed to fit; every series that could fit is still reported.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import Any, Final

import numpy as np
from sklearn.linear_model import LinearRegression

# ------------------------------------------------------------- #
#                           Constants                           #
# ------------------------------------------------------------- #

DEFAULT_CRITERION_DIR: Final[str] = "target/criterion"
EXTRAPOLATION_TARGETS: Final[tuple[int, ...]] = (50_000, 100_000)
SUMMARY_TARGET: Final[int] = 100_000
DEFAULT_WORST_COUNT: Final[int] = 10

MIN_POINTS_TO_FIT: Final[int] = 3
MIN_POINTS_FOR_COMBINED: Final[int] = 5
MIN_POINTS_FOR_TRUSTED_FIT: Final[int] = 6
MIN_RESIDUAL_DOF: Final[int] = 3
CONSTANT_SPREAD_EPSILON: Final[float] = 1e-4
R2_RELIABLE_THRESHOLD: Final[float] = 0.95
R_SQUARED: Final[str] = "R²"

SUMMARY_NAME_WIDTH: Final[int] = 34
PLOT_MIN_WIDTH: Final[int] = 54
PLOT_MAX_WIDTH: Final[int] = 90
PLOT_HEIGHT: Final[int] = 10


# ------------------------------------------------------------- #
#                        Model Complexity                       #
# ------------------------------------------------------------- #


class ModelKind(Enum):
    """Complexity class of a fitted performance model."""

    LINEAR = ("O(n) + constant", "O(n)", "linear cost", 2)
    LOG = ("O(n·ln n) + constant", "O(n·ln n)", "n·ln n cost", 2)
    COMBINED = (
        "O(n) + O(n·ln n) + constant",
        "O(n)+O(n·ln n)",
        "combined cost",
        3,
    )

    def __init__(
        self,
        label: str,
        short_label: str,
        breakdown_description: str,
        parameter_count: int,
    ) -> None:
        self.label = label
        self.short_label = short_label
        self.breakdown_description = breakdown_description
        self.parameter_count = parameter_count

    def design_matrix(self, x: np.ndarray) -> np.ndarray:
        """Construct the regression feature matrix for input array ``x``."""
        match self:
            case ModelKind.LINEAR:
                return x.reshape(-1, 1)
            case ModelKind.LOG:
                return (x * np.log(x)).reshape(-1, 1)
            case ModelKind.COMBINED:
                return np.column_stack([x, x * np.log(x)])


class FitTrust(Enum):
    """Ordered evidence outcomes for model reporting and forecasting."""

    INSUFFICIENT_INPUT_SIZES = (
        "INCONCLUSIVE",
        f"need at least {MIN_POINTS_FOR_TRUSTED_FIT} input sizes",
    )
    INSUFFICIENT_RESIDUAL_DOF = (
        "INCONCLUSIVE",
        f"need at least {MIN_RESIDUAL_DOF} residual DOF",
    )
    UNVALIDATED = ("UNVALIDATED", "leave-one-out validation is unavailable")
    WEAK_R_SQUARED = (
        "WEAK",
        f"in-sample {R_SQUARED} is below {R2_RELIABLE_THRESHOLD:.2f}",
    )
    EXPLORATORY = ("EXPLORATORY", "supported")

    def __init__(self, label: str, reason: str) -> None:
        self.label = label
        self.reason = reason

    @property
    def is_trusted(self) -> bool:
        """Whether the status permits drawing a fit curve and extrapolations."""
        return self is FitTrust.EXPLORATORY


