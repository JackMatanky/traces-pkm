#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy", "scikit-learn", "plotext<6"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" help="Criterion output directory" default="target/criterion"
# [USAGE] flag "-p --plot" help="Render measured input-size plots and supported fit curves in the terminal"
# [USAGE] flag "-s --summary [count]" value_optional=#true help="Print one high-level summary box; optional count caps the worst-performer list (default: 10)"

"""Fit performance models to Criterion benchmark output.

Pipeline (load -> fit -> analyze -> render):

1. CriterionRepository walks the Criterion JSON tree and groups measurements
   into series.
2. ModelFitter fits OLS complexity candidates and selects the lowest
   leave-one-out error.
3. SeriesAnalysis derives trust and extrapolation decisions.
4. Renderers emit a scan-first summary, optional terminal plot, and evidence
   table; --summary [count] renders the aggregate view.

Exit code 1 if the criterion directory is missing, no usable series are found,
or any series failed to fit; every series that could fit is still reported.
"""
from __future__ import annotations

import json
import os
import sys
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import Any, Final

import numpy as np
from sklearn.linear_model import LinearRegression

# ------------------------------------------------------------- #
#                           Constants                           #
# ------------------------------------------------------------- #

# Defaults & sweep sizes
DEFAULT_CRITERION_DIR: Final = "target/criterion"
EXTRAPOLATION_TARGETS: Final = (50_000, 100_000)
SUMMARY_TARGET: Final = 100_000
DEFAULT_WORST_COUNT: Final = 10

# Fit-trust thresholds
MIN_POINTS_TO_FIT: Final = 3
MIN_POINTS_FOR_COMBINED: Final = 5
MIN_POINTS_FOR_TRUSTED_FIT: Final = 6
MIN_RESIDUAL_DOF: Final = 3
CONSTANT_SPREAD_EPSILON: Final = 1e-4
R2_RELIABLE_THRESHOLD: Final = 0.95
R_SQUARED: Final = "R²"
# Report box and plot dimensions
SERIES_BOX_WIDTH: Final = 60
SUMMARY_BOX_WIDTH: Final = 64
SUMMARY_NAME_WIDTH: Final = 32
PLOT_MIN_WIDTH: Final = 60
PLOT_MAX_WIDTH: Final = 100
PLOT_HEIGHT: Final = 14


# ------------------------------------------------------------- #
#                        Model Complexity                       #
# ------------------------------------------------------------- #


class ModelKind(Enum):
    """Complexity class of a fitted performance model."""

    LINEAR = "linear"
    LOG = "log"
    COMBINED = "combined"

    @property
    def label(self) -> str:
        """Complexity including the constant term."""
        return MODEL_TEXT[self]["label"]

    @property
    def short_label(self) -> str:
        """Compact complexity for table columns."""
        return MODEL_TEXT[self]["short_label"]

    @property
    def breakdown_description(self) -> str:
        """One-line meaning for the summary's scaling breakdown."""
        return MODEL_TEXT[self]["breakdown_description"]


MODEL_TEXT: Final = {
    ModelKind.LINEAR: {
        "label": "O(n) + constant",
        "short_label": "O(n)",
        "breakdown_description": "linear cost",
    },
    ModelKind.LOG: {
        "label": "O(n·ln n) + constant",
        "short_label": "O(n·ln n)",
        "breakdown_description": "n·ln n cost",
    },
    ModelKind.COMBINED: {
        "label": "O(n) + O(n·ln n) + constant",
        "short_label": "O(n)+O(n·ln n)",
        "breakdown_description": "combined cost",
    },
}

# ------------------------------------------------------------- #
#                          Domain model                         #
# ------------------------------------------------------------- #


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """One Criterion timing estimate at a measured input size."""

    group: str
    input_size: float
    input_unit: str
    mean_seconds: float
    lower_seconds: float
    upper_seconds: float
    mild_outlier_count: int = 0
    severe_outlier_count: int = 0
    function: str = ""


@dataclass(frozen=True, slots=True)
class FittedModel:
    """An OLS complexity model with in-sample and held-out evidence."""

    kind: ModelKind
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    validation_rmse: float
    coeff_nlogn: float = 0.0

    @property
    def label(self) -> str:
        return self.kind.label

    @property
    def parameter_count(self) -> int:
        """Number of fitted coefficients, including the intercept."""
        return 3 if self.kind is ModelKind.COMBINED else 2

    @property
    def has_high_r_squared(self) -> bool:
        """Whether the in-sample score clears the reporting threshold."""
        return self.r_squared >= R2_RELIABLE_THRESHOLD

    def predict(self, input_size: float) -> float:
        """Predict mean seconds at a positive input size."""
        n = input_size
        match self.kind:
            case ModelKind.LINEAR:
                return self.coeff_n * n + self.coeff_intercept
            case ModelKind.LOG:
                return self.coeff_n * n * np.log(n) + self.coeff_intercept
            case ModelKind.COMBINED:
                return (
                    self.coeff_n * n
                    + self.coeff_nlogn * n * np.log(n)
                    + self.coeff_intercept
                )


@dataclass(frozen=True, slots=True)
class Extrapolation:
    """A model prediction beyond the measured input domain."""

    input_size: int
    predicted_seconds: float
    model_kind: ModelKind


@dataclass(frozen=True, slots=True)
class SeriesAnalysis:
    """One benchmark series with fitted models and trust decisions."""

    name: str
    data_points: tuple[BenchmarkDataPoint, ...]
    models: tuple[FittedModel, ...]

    @property
    def best_model(self) -> FittedModel:
        return self.models[0]

    @property
    def input_sizes(self) -> tuple[int, ...]:
        """Measured input sizes as integers."""
        return tuple(int(point.input_size) for point in self.data_points)

    @property
    def input_unit(self) -> str:
        """Shared Criterion throughput unit, or a neutral fallback."""
        units = {point.input_unit for point in self.data_points}
        return units.pop() if len(units) == 1 else "input units"

    @property
    def size_range(self) -> str:
        """Display string for the measured input-size domain."""
        sizes = [point.input_size for point in self.data_points]
        return f"{min(sizes):,.0f} → {max(sizes):,.0f}"

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        """Largest measured input, after repository ordering."""
        return self.data_points[-1]

    @property
    def mean_seconds(self) -> float:
        """Mean measured time for constant-series reporting."""
        return float(np.mean([point.mean_seconds for point in self.data_points]))

    @property
    def is_constant(self) -> bool:
        """True when the spread across input sizes is negligible."""
        times = [point.mean_seconds for point in self.data_points]
        return max(times) - min(times) < CONSTANT_SPREAD_EPSILON

    @property
    def residual_dof(self) -> int:
        """Residual degrees of freedom for the selected candidate."""
        return len(self.data_points) - self.best_model.parameter_count

    @property
    def has_insufficient_evidence(self) -> bool:
        """Whether data quantity or residual evidence blocks extrapolation."""
        return (
            len(self.data_points) < MIN_POINTS_FOR_TRUSTED_FIT
            or self.residual_dof < MIN_RESIDUAL_DOF
        )

    @property
    def trust_reason(self) -> str:
        """Human-readable reason forecasts are withheld, when applicable."""
        if len(self.data_points) < MIN_POINTS_FOR_TRUSTED_FIT:
            return f"need at least {MIN_POINTS_FOR_TRUSTED_FIT} input sizes"
        if self.residual_dof < MIN_RESIDUAL_DOF:
            return f"need at least {MIN_RESIDUAL_DOF} residual DOF"
        if not np.isfinite(self.best_model.validation_rmse):
            return "leave-one-out validation is unavailable"
        if not self.best_model.has_high_r_squared:
            return f"in-sample {R_SQUARED} is below {R2_RELIABLE_THRESHOLD:.2f}"
        return "supported"

    @property
    def is_fit_trusted(self) -> bool:
        """Whether the fit may be drawn and used for extrapolation."""
        return (
            not self.has_insufficient_evidence
            and self.best_model.has_high_r_squared
            and np.isfinite(self.best_model.validation_rmse)
        )

    @property
    def fit_status(self) -> str:
        """Concise evidence status for the scan-first summary."""
        if self.has_insufficient_evidence:
            return "INCONCLUSIVE"
        if not np.isfinite(self.best_model.validation_rmse):
            return "UNVALIDATED"
        if not self.best_model.has_high_r_squared:
            return "WEAK"
        return "EXPLORATORY"

    @property
    def extrapolations(self) -> tuple[Extrapolation, ...]:
        """Predictions outside the observed domain, or none when untrusted."""
        if not self.is_fit_trusted:
            return ()
        return tuple(
            Extrapolation(size, self.best_model.predict(float(size)), self.best_model.kind)
            for size in EXTRAPOLATION_TARGETS
            if size > self.largest_measurement.input_size
        )

    @property
    def has_negative_extrapolation(self) -> bool:
        """True when a trusted model becomes negative beyond the data."""
        return any(ext.predicted_seconds < 0 for ext in self.extrapolations)

    @property
    def prediction_at_summary_target(self) -> float | None:
        """Trusted prediction at the summary target for ranking."""
        if not self.is_fit_trusted:
            return None
        return self.best_model.predict(float(SUMMARY_TARGET))



