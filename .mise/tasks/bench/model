#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["numpy", "plotext<6"]
# ///
# [MISE] description="Fit performance models to criterion output"
# [MISE] hide=true
# [USAGE] arg "[criterion_dir]" default="target/criterion" {
# [USAGE]   help "Criterion output directory"
# [USAGE] }
# [USAGE] flag "-p --plot" {
# [USAGE]   help "Render measured input-size plots and supported fit curves in the terminal"
# [USAGE] }
# [USAGE] flag "-s --summary [count]" value_optional=#true {
# [USAGE]   help "Print one high-level summary table; optional count caps the worst-performer list (default: 10)"
# [USAGE] }

"""Fit performance models to Criterion benchmark output.

Pipeline (load -> fit -> analyze -> render):

1. CriterionRepository walks the Criterion JSON tree and parses rich statistics
   (mean, median, MAD, std_dev, slope, slope R², throughput with CIs, baseline Δ%
   for time & throughput, p-values, and Tukey outlier counts/percentages).
2. ModelFitter fits OLS complexity candidates and selects the lowest
   leave-one-out cross-validation error.
3. SeriesAnalysis evaluates evidence trust, capacity forecasts, and diagnostics.
4. SeriesReporter and SummaryReporter render responsive widescreen cards
   (or compact multi-row cards for series sharing a Criterion group),
   dual-column diagnostic grids, and aggregate summary tables.
5. SeriesPlotRenderer renders responsive terminal plots with 95% CI error
   bars, a log-x scale on wide-range series, and a baseline reference line:
   - On wide terminals (>= 110 cols) with throughput data: one plot with
     latency (left axis) and throughput (right axis) sharing one x-axis.
   - Otherwise: a single latency graph.

Exit code 1 if the criterion directory is missing, no usable series are found,
or any series failed to fit; every series that could fit is still reported.
"""
from __future__ import annotations

