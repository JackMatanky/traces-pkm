class SeriesReporter:
    """Renders the default per-series report box.

    Sections: data range, best model with coefficient meanings, R² quality,
    warnings (low DOF / low R² / negative predictions), and extrapolation with a
    dominant-term note.

    Args:
        width: Minimum box width.
    """

    def __init__(self, width: int = SERIES_BOX_WIDTH) -> None:
        self._box = Box(width)

    def render(self, analysis: SeriesAnalysis) -> str:
        """Render one series as a box.

        Args:
            analysis: Fitted series to report.

        Returns:
            Multi-line box string (no trailing newline).
        """
        best = analysis.best_model
        rows: list[BoxRow] = [
            "",
            f"Data: {len(analysis.data_points)} points"
            f"  |  Sizes: {analysis.size_range}",
            "",
            f"Best fit: {best.label}",
            DIVIDER,
            *self._coefficient_rows(best),
            self._r2_row(best),
            *self._warning_rows(analysis),
            *self._extrapolation_rows(analysis),
        ]
        return self._box.render(analysis.name, rows)

    @staticmethod
    def _coefficient_rows(model: FittedModel) -> list[str]:
        return [
            f"  {coeff.symbol} = {format_scientific(coeff.value):<9}  "
            f"{coeff.meaning}"
            for coeff in model.coefficients
        ]

    @staticmethod
    def _r2_row(model: FittedModel) -> str:
        return (
            f"  {R_SQUARED} = {f'{model.r_squared:.4f}':<9}  "
            f"{model.quality} fit"
        )

    @staticmethod
    def _warning_rows(analysis: SeriesAnalysis) -> list[BoxRow]:
        rows: list[BoxRow] = []
        if analysis.has_low_dof:
            rows += [
                "",
                f"  ⚠ {analysis.residual_dof} residual DOF"
                f": {R_SQUARED} may be optimistic",
            ]
        return rows

    @staticmethod
    def _extrapolation_rows(analysis: SeriesAnalysis) -> list[BoxRow]:
        best = analysis.best_model
        if not best.is_reliable:
            return [
                "",
                f"  ⚠ Low {R_SQUARED}: extrapolation unreliable",
                "  Measure directly at target sizes instead.",
            ]
        extrapolations = analysis.extrapolations
        if not extrapolations:
            return []
        if analysis.has_negative_extrapolation:
            return [
                "",
                "  ⚠ Predictions negative: extrapolation suppressed",
            ]
        rows: list[BoxRow] = ["", "Extrapolation:"]
        rows += [
            f"    {ext.file_count:>6,} notes"
            f" → {format_seconds(ext.predicted_seconds)}"
            for ext in extrapolations
        ]
        probe = max(analysis.file_counts) * 2.5
        dominant = best.dominant_term(probe)
        if dominant is not None:
            rows += [
                "",
                f"Scaling: {dominant} dominates at 2.5× the largest"
                " measured size",
            ]
        return rows


class SummaryReporter:
    """Renders the single-box overview of every fitted series.

    Sections: counts, worst performers at the summary target (capped at
    ``worst_count``), unreliable fits, scaling breakdown, and near-constant
    series.

    Args:
        worst_count: Maximum rows in the worst-performers list.
        width: Minimum box width.
        target: Workspace size predictions are made at.
    """

    def __init__(
        self,
        worst_count: int = DEFAULT_WORST_COUNT,
        width: int = SUMMARY_BOX_WIDTH,
        target: int = SUMMARY_TARGET,
    ) -> None:
        self._worst_count = worst_count
        self._box = Box(width)
        self._target = target

    def render(self, data: SummaryData) -> str:
        """Render the summary as one box.

        Args:
            data: Classified series from :func:`build_summary`.

        Returns:
            Multi-line box string (no trailing newline).
        """
        rows: list[BoxRow] = [
            "",
            self._stats_row(data),
            *self._ranked_rows(data),
            *self._unreliable_rows(data),
            *self._scaling_rows(data),
            *self._constant_rows(data),
        ]
        return self._box.render("Performance Summary", rows)

    @staticmethod
    def _stats_row(data: SummaryData) -> str:
        return (
            f"{data.total_series} series  |  {data.good_fit_count} good fits"
            f"  |  {data.unreliable_count} unreliable"
            f"  |  {data.constant_count} constant"
        )

    def _ranked_rows(self, data: SummaryData) -> list[BoxRow]:
        if not data.ranked:
            return []
        shown = data.ranked[: self._worst_count]
        rows: list[BoxRow] = [
            "",
            f"WORST AT {self._target // 1000}K (top {len(shown)}):",
            DIVIDER,
        ]
        for rank, entry in enumerate(shown, start=1):
            name = truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            rows.append(
                f"  {rank:>2}. {name:<{SUMMARY_NAME_WIDTH}}"
                f" {format_seconds(entry.predicted_seconds):>8}"
                f"  {entry.model.kind.short_label:<14}"
                f" {R_SQUARED}={entry.model.r_squared:.3f}"
            )
        return rows

    @staticmethod
    def _unreliable_rows(data: SummaryData) -> list[BoxRow]:
        if not data.unreliable:
            return []
        rows: list[BoxRow] = ["", "UNRELIABLE FITS:", DIVIDER]
        for entry in data.unreliable:
            name = truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            rows.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {R_SQUARED}={entry.model.r_squared:.3f}  {entry.reason}"
            )
        return rows

    @staticmethod
    def _scaling_rows(data: SummaryData) -> list[BoxRow]:
        rows: list[BoxRow] = ["", "SCALING BREAKDOWN:", DIVIDER]
        for kind, count in data.scaling_counts.items():
            if count > 0:
                rows.append(
                    f"  {kind.short_label:<14}  {kind.breakdown_description}:"
                    f" {count} series"
                )
        return rows

    @staticmethod
    def _constant_rows(data: SummaryData) -> list[BoxRow]:
        if not data.constant:
            return []
        rows: list[BoxRow] = [
            "",
            "NEAR-CONSTANT (no scaling concern):",
            DIVIDER,
        ]
        for entry in data.constant:
            name = truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            rows.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {format_seconds(entry.mean_seconds):>8}  all sizes"
            )
        return rows


class SeriesPlotRenderer:
    """Renders a scatter plot with the fitted curve via `plotext`.

    One plot block per series; imports `plotext` lazily so the default report path
    never pays for it.
    """

    def render(self, analysis: SeriesAnalysis) -> None:
        """Draw the measured points and best-fit curve to the terminal.

        Args:
            analysis: Fitted series to plot.
        """
        import plotext as plt

        best = analysis.best_model
        x = [point.file_count for point in analysis.data_points]
        y = [point.mean_seconds for point in analysis.data_points]

        plt.clear_figure()
        plt.plotsize(PLOT_WIDTH, PLOT_HEIGHT)
        plt.title(analysis.name)
        plt.xlabel("n (files)")
        plt.ylabel("time (s)")
        plt.scatter(x, y, label="measured", color="cyan")

        x_min, x_max = min(x), max(x)
        pad = max((x_max - x_min) * 0.1, 1)
        curve_x = np.linspace(max(x_min - pad, 1), x_max + pad, 100)
        curve_y = np.array([best.predict(float(value)) for value in curve_x])
        plt.plot(
            curve_x.tolist(),
            curve_y.tolist(),
            label=best.kind.value,
            color="yellow",
        )
        plt.show()
        print()


