#                       Criterion Loading                       #
# ------------------------------------------------------------- #


class CriterionRepository:
    """Reads benchmark measurements from a Criterion output directory."""

    def __init__(self, root: Path) -> None:
        self._root = root

    def load_series(self) -> dict[str, list[BenchmarkDataPoint]]:
        """Load measurements grouped and ordered by numeric input size."""
        if not self._root.exists():
            raise FileNotFoundError(f"Criterion output not found: {self._root}")

        series: dict[str, list[BenchmarkDataPoint]] = {}
        for group_dir in sorted(self._root.iterdir()):
            if group_dir.is_dir():
                self._load_group(series, group_dir)
        for points in series.values():
            points.sort(key=lambda point: point.input_size)
        return series

    def _load_group(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group_dir: Path,
    ) -> None:
        """Load one group directory, including nested function sweeps."""
        for child_dir in sorted(group_dir.iterdir()):
            if not child_dir.is_dir():
                continue
            if (child_dir / "new").is_dir():
                point = self._parse(group_dir.name, "", child_dir / "new")
                if point is not None:
                    series.setdefault(group_dir.name, []).append(point)
                continue
            self._load_nested(series, group_dir.name, child_dir)

    def _load_nested(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group: str,
        function_dir: Path,
    ) -> None:
        """Load one group/function sweep."""
        for size_dir in sorted(function_dir.iterdir()):
            if not size_dir.is_dir():
                continue
            results_dir = size_dir / "new"
            if not results_dir.is_dir():
                continue
            point = self._parse(group, function_dir.name, results_dir)
            if point is not None:
                series.setdefault(f"{group}/{function_dir.name}", []).append(point)

    @staticmethod
    def _parse(
        group: str,
        function: str,
        results_dir: Path,
    ) -> BenchmarkDataPoint | None:
        """Parse a Criterion estimate and its input-size metadata."""
        try:
            bench: dict[str, Any] = json.loads(
                (results_dir / "benchmark.json").read_text()
            )
            estimates: dict[str, Any] = json.loads(
                (results_dir / "estimates.json").read_text()
            )
            input_size, input_unit = CriterionRepository._parse_input(bench)
            mean = estimates["mean"]
            interval = mean["confidence_interval"]
            mean_seconds = float(mean["point_estimate"]) / 1e9
            lower_seconds = float(interval["lower_bound"]) / 1e9
            upper_seconds = float(interval["upper_bound"]) / 1e9
        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
        ):
            return None
        mild_outliers, severe_outliers = CriterionRepository._outlier_counts(
            results_dir
        )
        return BenchmarkDataPoint(
            group=group,
            input_size=input_size,
            input_unit=input_unit,
            mean_seconds=mean_seconds,
            lower_seconds=lower_seconds,
            upper_seconds=upper_seconds,
            mild_outlier_count=mild_outliers,
            severe_outlier_count=severe_outliers,
            function=function,
        )

    @staticmethod
    def _outlier_counts(results_dir: Path) -> tuple[int, int]:
        """Count Criterion's mild and severe Tukey outliers, if available."""
        try:
            sample: dict[str, list[float]] = json.loads(
                (results_dir / "sample.json").read_text()
            )
            lower_severe, lower_mild, upper_mild, upper_severe = (
                float(value)
                for value in json.loads((results_dir / "tukey.json").read_text())
            )
            values = [
                float(time) / float(iterations)
                for time, iterations in zip(
                    sample["times"], sample["iters"], strict=True
                )
            ]
        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
            ZeroDivisionError,
        ):
            return 0, 0
        mild = sum(
            lower_severe <= value < lower_mild
            or upper_mild < value <= upper_severe
            for value in values
        )
        severe = sum(
            value < lower_severe or value > upper_severe for value in values
        )
        return mild, severe

    @staticmethod
    def _parse_input(benchmark: Mapping[str, Any]) -> tuple[float, str]:
        """Return Criterion throughput when present, else its numeric value."""
        throughput = benchmark.get("throughput")
        if isinstance(throughput, Mapping) and len(throughput) == 1:
            kind, value = next(iter(throughput.items()))
            if isinstance(value, int | float) and value > 0:
                return float(value), CriterionRepository._throughput_unit(str(kind))
        return float(benchmark["value_str"]), "input units"

    @staticmethod
    def _throughput_unit(kind: str) -> str:
        """Map Criterion's serialized throughput kind to a display label."""
        return {
            "Elements": "elements",
            "Bytes": "bytes",
            "BytesDecimal": "bytes",
        }.get(kind, kind.replace("_", " ").lower())


# ------------------------------------------------------------- #
#                         Model Fitting                         #
# ------------------------------------------------------------- #


class ModelFitter:
    """Fits OLS candidate models and ranks them by leave-one-out error."""

    def fit(
        self, data_points: Sequence[BenchmarkDataPoint]
    ) -> tuple[FittedModel, ...]:
        """Fit every candidate kind, ordered by leave-one-out RMSE."""
        x = np.array([point.input_size for point in data_points])
        y = np.array([point.mean_seconds for point in data_points])
        if np.var(y) == 0:
            return ()

        kinds = [ModelKind.LINEAR, ModelKind.LOG]
        if len(data_points) >= MIN_POINTS_FOR_COMBINED:
            kinds.append(ModelKind.COMBINED)
        models = [self._fit_kind(kind, x, y) for kind in kinds]
        return tuple(
            sorted(models, key=lambda model: (model.validation_rmse, -model.r_squared))
        )

    @staticmethod
    def _fit_kind(kind: ModelKind, x: np.ndarray, y: np.ndarray) -> FittedModel:
        """OLS-fit one candidate and calculate its leave-one-out RMSE."""
        features = ModelFitter._design_matrix(kind, x)
        regression = LinearRegression().fit(features, y)
        return FittedModel(
            kind=kind,
            coeff_n=float(regression.coef_[0]),
            coeff_nlogn=float(regression.coef_[1])
            if kind is ModelKind.COMBINED
            else 0.0,
            coeff_intercept=float(regression.intercept_),
            r_squared=float(regression.score(features, y)),
            validation_rmse=ModelFitter._leave_one_out_rmse(features, y),
        )

    @staticmethod
    def _leave_one_out_rmse(features: np.ndarray, y: np.ndarray) -> float:
        """Calculate prediction RMSE with each measurement held out once."""
        if len(y) - 1 < features.shape[1] + 1:
            return float("inf")
        errors = np.empty(len(y))
        for index in range(len(y)):
            mask = np.ones(len(y), dtype=bool)
            mask[index] = False
            regression = LinearRegression().fit(features[mask], y[mask])
            prediction = regression.predict(features[index : index + 1])[0]
            errors[index] = y[index] - prediction
        return float(np.sqrt(np.mean(np.square(errors))))

    @staticmethod
    def _design_matrix(kind: ModelKind, x: np.ndarray) -> np.ndarray:
        """Build the feature columns for one model kind."""
        match kind:
            case ModelKind.LINEAR:
                return x.reshape(-1, 1)
            case ModelKind.LOG:
                return (x * np.log(x)).reshape(-1, 1)
            case ModelKind.COMBINED:
                return np.column_stack([x, x * np.log(x)])



# ------------------------------------------------------------- #
#                        Summary Analysis                       #
# ------------------------------------------------------------- #


@dataclass(frozen=True, slots=True)
class RankedFit:
    """A supported fit ranked by its estimate at the summary target."""

    name: str
    model: FittedModel
    predicted_seconds: float


@dataclass(frozen=True, slots=True)
class UnreliableFit:
    """A series excluded from extrapolated ranking with its evidence status."""

    name: str
    model: FittedModel
    reason: str


@dataclass(frozen=True, slots=True)
class ConstantFit:
    """A series whose time barely changes with input size."""

    name: str
    mean_seconds: float


@dataclass(frozen=True, slots=True)
class SummaryData:
    """Classification of every fitted series for the aggregate report."""

    total_series: int
    ranked: tuple[RankedFit, ...]
    unreliable: tuple[UnreliableFit, ...]
    constant: tuple[ConstantFit, ...]
    scaling_counts: Mapping[ModelKind, int]

    @property
    def supported_fit_count(self) -> int:
        """Series with supported, positive summary estimates."""
        return len(self.ranked)

    @property
    def unreliable_count(self) -> int:
        return len(self.unreliable)

    @property
    def constant_count(self) -> int:
        return len(self.constant)


def build_summary(
    analyses: Sequence[SeriesAnalysis],
    target: int = SUMMARY_TARGET,
) -> SummaryData:
    """Classify analyses into constant, untrusted, and ranked buckets."""
    ranked: list[RankedFit] = []
    unreliable: list[UnreliableFit] = []
    constant: list[ConstantFit] = []
    scaling = dict.fromkeys(ModelKind, 0)

    for analysis in analyses:
        if analysis.is_constant:
            constant.append(ConstantFit(analysis.name, analysis.mean_seconds))
            continue
        best = analysis.best_model
        scaling[best.kind] += 1
        if not analysis.is_fit_trusted:
            unreliable.append(
                UnreliableFit(analysis.name, best, analysis.fit_status.lower())
            )
            continue
        predicted = best.predict(float(target))
        if predicted <= 0:
            unreliable.append(
                UnreliableFit(analysis.name, best, "negative prediction")
            )
            continue
        ranked.append(RankedFit(analysis.name, best, predicted))

    ranked.sort(key=lambda entry: entry.predicted_seconds, reverse=True)
    return SummaryData(
        total_series=len(analyses),
        ranked=tuple(ranked),
        unreliable=tuple(unreliable),
        constant=tuple(constant),
        scaling_counts=scaling,
    )


# ------------------------------------------------------------- #
#                           Formatting                          #
# ------------------------------------------------------------- #


class _Divider:
    """Sentinel row that renders as a full-width horizontal rule."""

    __slots__ = ()


DIVIDER: Final = _Divider()
BoxRow = str | _Divider


def time_unit(seconds: float) -> tuple[str, float]:
    """Return a readable time unit and seconds-to-unit scale."""
    magnitude = abs(seconds)
    if magnitude < 0.001:
        return "µs", 1_000_000
    if magnitude < 1.0:
        return "ms", 1_000
    return "s", 1


def format_seconds(seconds: float) -> str:
    """Format seconds with a unit chosen by magnitude."""
    unit, scale = time_unit(seconds)
    precision = 2 if unit == "s" else 1
    return f"{seconds * scale:.{precision}f}{unit}"


def format_interval(
    estimate_seconds: float,
    lower_seconds: float,
    upper_seconds: float,
) -> str:
    """Format one timing estimate and its Criterion confidence interval."""
    unit, scale = time_unit(estimate_seconds)
    precision = 2 if unit == "s" else 1
    return (
        f"{estimate_seconds * scale:.{precision}f}{unit} "
        f"[{lower_seconds * scale:.{precision}f}, "
        f"{upper_seconds * scale:.{precision}f}]"
    )


def format_outlier_summary(data_points: Sequence[BenchmarkDataPoint]) -> str:
    """Summarize Criterion's Tukey outliers without removing measurements."""
    mild = sum(point.mild_outlier_count for point in data_points)
    severe = sum(point.severe_outlier_count for point in data_points)
    if mild == severe == 0:
        return "none"
    parts = [
        f"{count} {kind}"
        for count, kind in ((mild, "mild"), (severe, "severe"))
        if count
    ]
    return f"{' · '.join(parts)} across {len(data_points)} sizes"


def truncate_middle(text: str, max_len: int) -> str:
    """Shorten ``text`` to ``max_len`` keeping both ends.

    Preserves the group prefix and the ``/function`` suffix, which are the
    distinguishing parts of a series key.

    Args:
        text: String to shorten.
        max_len: Maximum length including the ellipsis.

    Returns:
        Unmodified text, or head + ``…`` + tail.
    """
    if len(text) <= max_len:
        return text
    keep = max_len - 1
    head = (keep + 1) // 2
    tail = keep - head
    return f"{text[:head]}…{text[-tail:]}" if tail else f"{text[:head]}…"


class Box:
    """Renders box-drawing frames with consistent alignment.

    Every line (borders included) has the same display width: the requested
    minimum widened to fit the longest row or the title, so content can never
    overflow the frame.

    Args:
        min_width: Minimum total width of the rendered box.
    """

    def __init__(self, min_width: int = SERIES_BOX_WIDTH) -> None:
        self._min_width = min_width

    def render(self, title: str, rows: Sequence[BoxRow]) -> str:
        """Render a complete box.

        Args:
            title: Text centered in the top border.
            rows: Body rows; strings become padded content, blank strings
                become blank lines, and :data:`DIVIDER` becomes a rule.

        Returns:
            Multi-line box string.
        """
        width = self._resolve_width(title, rows)
        inner = width - 4
        body = [
            self._row("─" * inner, inner)
            if isinstance(row, _Divider)
            else self._row(row, inner)
            for row in rows
        ]
        return "\n".join([self._top(title, width), *body, self._bottom(width)])

    def _resolve_width(self, title: str, rows: Sequence[BoxRow]) -> int:
        longest = max(
            (len(row) for row in rows if isinstance(row, str)),
            default=0,
        )
        return max(self._min_width, len(title) + 4, longest + 4)

    @staticmethod
    def _row(content: str, inner: int) -> str:
        return f"│ {content.ljust(inner)} │"

    @staticmethod
    def _top(title: str, width: int) -> str:
        title_part = f" {title} "
        pad = width - 2 - len(title_part)
        left = pad // 2
        return f"┌{'─' * left}{title_part}{'─' * (pad - left)}┐"

    @staticmethod
    def _bottom(width: int) -> str:
        return f"└{'─' * (width - 2)}┘"


# ------------------------------------------------------------- #
#                           Reporting                           #
# ------------------------------------------------------------- #


class SeriesReporter:
    """Renders a scan-first report before a plot and evidence table after it."""

    def __init__(self, width: int = SERIES_BOX_WIDTH) -> None:
        self._box = Box(width)

    def render_summary(self, analysis: SeriesAnalysis) -> str:
        """Render the operational result that appears before the plot."""
        best = analysis.best_model
        latest = analysis.largest_measurement
        rows: list[BoxRow] = [
            "INPUT",
            f"  n: {analysis.input_unit} · {len(analysis.data_points)} sizes",
            f"  observed: {analysis.size_range} {analysis.input_unit}",
            "",
            f"FIT  {analysis.fit_status}",
            f"  Candidate: {best.label}",
            f"  Evidence: {len(analysis.data_points)} input sizes · "
            f"{analysis.residual_dof} residual DOF",
            f"  Largest input: {latest.input_size:,.0f} {analysis.input_unit}",
            f"  Time: {format_interval(latest.mean_seconds, latest.lower_seconds, latest.upper_seconds)}  95% CI",
            *self._outlook_rows(analysis),
        ]
        return self._box.render(analysis.name, rows)

    def render_details(self, analysis: SeriesAnalysis) -> str:
        """Render evidence and selection diagnostics after the plot."""
        best = analysis.best_model
        extrapolation = (
            "enabled" if analysis.is_fit_trusted else "withheld: insufficient evidence"
        )
        rows: list[BoxRow] = [
            f"{'item':<28} value",
            DIVIDER,
            f"  {'candidate model':<26} {best.label}",
            f"  {'fit status':<26} {analysis.fit_status.lower()}",
            f"  {'selection':<26} lowest leave-one-out RMSE",
            f"  {'leave-one-out RMSE':<26} {format_seconds(best.validation_rmse)}",
            f"  {'in-sample ' + R_SQUARED:<26} {best.r_squared:.4f}",
            f"  {'residual DOF':<26} {analysis.residual_dof}",
            f"  {'sample outliers':<26} "
            f"{format_outlier_summary(analysis.data_points)}",
            f"  {'extrapolation':<26} {extrapolation}",
            f"  {'coefficients':<26} omitted; terms are not interpreted",
        ]
        return self._box.render("Details", rows)

    @staticmethod
    def _outlook_rows(analysis: SeriesAnalysis) -> list[BoxRow]:
        if not analysis.is_fit_trusted:
            return [
                "",
                "FORECASTS WITHHELD",
                f"  {analysis.trust_reason}.",
                "",
                "NEXT",
                "  Add input sizes before using this model for capacity estimates.",
            ]
        if analysis.has_negative_extrapolation:
            return [
                "",
                "NEXT",
                "  Forecasts withheld: the model becomes negative beyond the data.",
            ]
        latest = analysis.largest_measurement
        rows: list[BoxRow] = [
            "",
            "OUTLOOK — model-based",
            "  input size           time                     basis",
            DIVIDER,
            "  "
            f"{latest.input_size:>8,.0f} {analysis.input_unit:<10} "
            f"{format_interval(latest.mean_seconds, latest.lower_seconds, latest.upper_seconds):<24} "
            "measured · 95% CI",
        ]
        for extrapolation in analysis.extrapolations:
            distance = extrapolation.input_size / latest.input_size
            rows.append(
                "  "
                f"{extrapolation.input_size:>8,} {analysis.input_unit:<10} "
                f"{format_seconds(extrapolation.predicted_seconds):<24} "
                f"extrapolated · {distance:.1f}× range"
            )
        return rows



class SummaryReporter:
    """Renders the single-box overview of every fitted series.

    Sections: counts, worst performers at the summary target (capped at
    ``worst_count``), unreliable fits, scaling breakdown, and near-constant
    series.

    Args:
        worst_count: Maximum rows in the worst-performers list.
        width: Minimum box width.
        target: Workspace size predictions are made at.
    """

    def __init__(
        self,
        worst_count: int = DEFAULT_WORST_COUNT,
        width: int = SUMMARY_BOX_WIDTH,
        target: int = SUMMARY_TARGET,
    ) -> None:
        self._worst_count = worst_count
        self._box = Box(width)
        self._target = target

    def render(self, data: SummaryData) -> str:
        """Render the summary as one box.

        Args:
            data: Classified series from :func:`build_summary`.

        Returns:
            Multi-line box string (no trailing newline).
        """
        rows: list[BoxRow] = [
            "",
            self._stats_row(data),
            *self._ranked_rows(data),
            *self._unreliable_rows(data),
            *self._scaling_rows(data),
            *self._constant_rows(data),
        ]
        return self._box.render("Performance Summary", rows)

    @staticmethod
    def _stats_row(data: SummaryData) -> str:
        return (
            f"{data.total_series} series  |  {data.supported_fit_count} supported"
            f"  |  {data.unreliable_count} unreliable"
            f"  |  {data.constant_count} constant"
        )

    def _ranked_rows(self, data: SummaryData) -> list[BoxRow]:
        if not data.ranked:
            return []
        shown = data.ranked[: self._worst_count]
        rows: list[BoxRow] = [
            "",
            f"WORST AT {self._target // 1000}K (top {len(shown)}):",
            DIVIDER,
        ]
        for rank, entry in enumerate(shown, start=1):
            name = truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            rows.append(
                f"  {rank:>2}. {name:<{SUMMARY_NAME_WIDTH}}"
                f" {format_seconds(entry.predicted_seconds):>8}"
                f"  {entry.model.kind.short_label:<14}"
                f" {R_SQUARED}={entry.model.r_squared:.3f}"
            )
        return rows

    @staticmethod
    def _unreliable_rows(data: SummaryData) -> list[BoxRow]:
        if not data.unreliable:
            return []
        rows: list[BoxRow] = ["", "UNRELIABLE FITS:", DIVIDER]
        for entry in data.unreliable:
            name = truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            rows.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {R_SQUARED}={entry.model.r_squared:.3f}  {entry.reason}"
            )
        return rows

    @staticmethod
    def _scaling_rows(data: SummaryData) -> list[BoxRow]:
        rows: list[BoxRow] = ["", "SCALING BREAKDOWN:", DIVIDER]
        for kind, count in data.scaling_counts.items():
            if count > 0:
                rows.append(
                    f"  {kind.short_label:<14}  {kind.breakdown_description}:"
                    f" {count} series"
                )
        return rows

    @staticmethod
    def _constant_rows(data: SummaryData) -> list[BoxRow]:
        if not data.constant:
            return []
        rows: list[BoxRow] = [
            "",
            "NEAR-CONSTANT (no scaling concern):",
            DIVIDER,
        ]
        for entry in data.constant:
            name = truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            rows.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {format_seconds(entry.mean_seconds):>8}  all sizes"
            )
        return rows


class SeriesPlotRenderer:
    """Renders measured values and supported fit curves with plotext."""

    def render(self, analysis: SeriesAnalysis) -> None:
        """Draw measured confidence intervals and an in-domain fit when trusted."""
        import plotext as plt

        x = [point.input_size for point in analysis.data_points]
        max_time = max(point.mean_seconds for point in analysis.data_points)
        unit, scale = time_unit(max_time)
        y = [point.mean_seconds * scale for point in analysis.data_points]

        plt.clear_figure()
        plt.plotsize(self._width(), PLOT_HEIGHT)
        plt.xlabel(f"n ({analysis.input_unit})")
        plt.ylabel(f"time ({unit})")
        for point in analysis.data_points:
            plt.plot(
                [point.input_size, point.input_size],
                [point.lower_seconds * scale, point.upper_seconds * scale],
                color="cyan",
            )
        plt.scatter(x, y, label="measured · 95% CI", color="cyan")

        if analysis.is_fit_trusted:
            curve_x = np.linspace(min(x), max(x), 100)
            curve_y = [
                analysis.best_model.predict(float(value)) * scale
                for value in curve_x
            ]
            plt.plot(
                curve_x.tolist(),
                curve_y,
                label=f"fit: {analysis.best_model.kind.short_label}",
                color="yellow",
            )
        plt.show()
        print()

    @staticmethod
    def _width() -> int:
        """Fit the plot to the terminal without exceeding a readable maximum."""
        try:
            columns = os.get_terminal_size().columns
        except OSError:
            return PLOT_MIN_WIDTH
        return min(PLOT_MAX_WIDTH, max(PLOT_MIN_WIDTH, columns - 2))



