@dataclass(frozen=True, slots=True)
class TimingInterval:
    """Mean wall-clock timing and its 95% bootstrap confidence interval."""

    mean_seconds: float
    lower_seconds: float
    upper_seconds: float

    @classmethod
    def from_criterion_nanoseconds(
        cls,
        point_estimate_ns: float,
        lower_ns: float,
        upper_ns: float,
    ) -> TimingInterval:
        """Construct from raw Criterion nanosecond estimates."""
        return cls(
            mean_seconds=float(point_estimate_ns) / 1e9,
            lower_seconds=float(lower_ns) / 1e9,
            upper_seconds=float(upper_ns) / 1e9,
        )

    def format_with_ci(self) -> str:
        """Format the estimate and 95% confidence bounds with auto-scaled units."""
        unit, scale = Presentation.time_unit(self.mean_seconds)
        est = self.mean_seconds * scale
        low = self.lower_seconds * scale
        high = self.upper_seconds * scale
        prec = Presentation.precision_for(unit, est)
        return f"{est:.{prec}f}{unit} [{low:.{prec}f}, {high:.{prec}f}]"


@dataclass(frozen=True, slots=True)
class EstimateInterval:
    """Point estimate and confidence interval for general statistical metrics."""

    point_estimate: float
    lower_bound: float
    upper_bound: float

    @classmethod
    def from_dict(cls, data: Mapping[str, Any], scale: float = 1.0) -> EstimateInterval | None:
        try:
            pt = float(data["point_estimate"]) * scale
            ci = data["confidence_interval"]
            low = float(ci["lower_bound"]) * scale
            high = float(ci["upper_bound"]) * scale
            return cls(point_estimate=pt, lower_bound=low, upper_bound=high)
        except (KeyError, TypeError, ValueError):
            return None


@dataclass(frozen=True, slots=True)
class BaselineChange:
    """Criterion relative change estimate for time and throughput vs base."""

    time_pct: float
    time_lower_pct: float
    time_upper_pct: float
    p_value: float = 0.05
    thrpt_pct: float | None = None
    thrpt_lower_pct: float | None = None
    thrpt_upper_pct: float | None = None

    @classmethod
    def from_dict(cls, data: Mapping[str, Any]) -> BaselineChange | None:
        try:
            mean = data.get("mean", {})
            ci = mean.get("confidence_interval", {})
            point_est = float(mean.get("point_estimate", 0.0)) * 100.0
            lower = float(ci.get("lower_bound", 0.0)) * 100.0
            upper = float(ci.get("upper_bound", 0.0)) * 100.0

            std_err = float(mean.get("standard_error", 0.0))
            z = abs(mean.get("point_estimate", 0.0)) / std_err if std_err > 0 else 0
            p_val = 2.0 * (1.0 - 0.5 * (1.0 + math.erf(z / math.sqrt(2))))

            # Invert time change for throughput delta
            t_pt = -point_est / (1.0 + point_est / 100.0) if point_est != -100.0 else None
            t_low = -upper / (1.0 + upper / 100.0) if upper != -100.0 else None
            t_high = -lower / (1.0 + lower / 100.0) if lower != -100.0 else None

            return cls(
                time_pct=point_est,
                time_lower_pct=lower,
                time_upper_pct=upper,
                p_value=p_val,
                thrpt_pct=t_pt,
                thrpt_lower_pct=t_low,
                thrpt_upper_pct=t_high,
            )
        except (KeyError, TypeError, ValueError, ZeroDivisionError):
            return None

    @property
    def is_significant(self) -> bool:
        """A real change: statistically detected AND beyond Criterion's noise floor."""
        return self.p_value < SIGNIFICANCE_P_THRESHOLD and abs(self.time_pct) >= NOISE_THRESHOLD_PCT

    @property
    def is_within_noise(self) -> bool:
        """Statistically detected a difference, but it's within Criterion's documented
        ~1% noise threshold: neither a real regression nor a real improvement."""
        return self.p_value < SIGNIFICANCE_P_THRESHOLD and abs(self.time_pct) < NOISE_THRESHOLD_PCT

    def format_badge(self) -> str:
        sign = "+" if self.time_pct > 0 else ""
        text = f"{sign}{self.time_pct:.1f}% [{self.time_lower_pct:.1f}%, {self.time_upper_pct:.1f}%] vs base"
        # "≈" not "=": this is a Gaussian z-test approximation on the bootstrap SE, not
        # Criterion's own bootstrap T-test statistic (which isn't persisted to disk).
        p_str = f"p≈{self.p_value:.3f} < 0.05" if self.p_value < SIGNIFICANCE_P_THRESHOLD else f"p≈{self.p_value:.2f} > 0.05"
        if self.is_significant:
            if self.time_pct < 0:
                return f"{Style.green('🟢 ' + text + f' ({p_str})')}"
            return f"{Style.red('🔴 ' + text + f' ({p_str})')}"
        if self.is_within_noise:
            return f"{Style.yellow('🟡 ' + text + f' ({p_str})')}"
        return f"{Style.dim('⚪ ' + text + f' ({p_str})')}"

    def format_short(self) -> str:
        sign = "+" if self.time_pct > 0 else ""
        text = f"{sign}{self.time_pct:.1f}%"
        if self.is_significant:
            return Style.green(text) if self.time_pct < 0 else Style.red(text)
        return Style.dim(text)

    def format_decision_line(self) -> str:
        if self.is_within_noise:
            return Style.yellow("Change within noise threshold.")
        if not self.is_significant:
            return Style.dim("No change in performance detected.")
        if self.time_pct < 0:
            return Style.green(f"Improved performance detected: {abs(self.time_pct):.1f}% faster runtime.")
        return Style.red(f"Regressed performance detected: {self.time_pct:.1f}% slower runtime.")


@dataclass(frozen=True, slots=True)
class OutlierStats:
    """Breakdown of Tukey mild and severe outliers."""

    total_samples: int = 0
    low_severe: int = 0
    low_mild: int = 0
    high_mild: int = 0
    high_severe: int = 0

    @property
    def total_outliers(self) -> int:
        return self.low_severe + self.low_mild + self.high_mild + self.high_severe

    @property
    def outlier_pct(self) -> float:
        return (self.total_outliers / self.total_samples * 100.0) if self.total_samples > 0 else 0.0

    def format_summary(self) -> str:
        if self.total_outliers == 0:
            return "none"
        parts = []
        if self.high_mild:
            parts.append(f"{self.high_mild} high mild")
        if self.high_severe:
            parts.append(f"{self.high_severe} high severe")
        if self.low_mild:
            parts.append(f"{self.low_mild} low mild")
        if self.low_severe:
            parts.append(f"{self.low_severe} low severe")
        desc = " · ".join(parts)
        return f"{desc} ({self.outlier_pct:.1f}% of {self.total_samples} samples)"


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """One Criterion timing estimate at a measured input size."""

    group: str
    input_size: float
    input_unit: str
    timing: TimingInterval
    median: EstimateInterval | None = None
    mad: EstimateInterval | None = None
    std_dev: EstimateInterval | None = None
    slope: EstimateInterval | None = None
    slope_r_squared: float | None = None
    throughput_bytes: float | None = None
    throughput_elements: float | None = None
    change_vs_base: BaselineChange | None = None
    outliers: OutlierStats = OutlierStats()
    function: str = ""

    @property
    def mean_seconds(self) -> float:
        return self.timing.mean_seconds

    @property
    def lower_seconds(self) -> float:
        return self.timing.lower_seconds

    @property
    def upper_seconds(self) -> float:
        return self.timing.upper_seconds

    @property
    def throughput_rate_value(self) -> float | None:
        """Raw throughput rate value (bytes/sec or elements/sec)."""
        if self.mean_seconds <= 0:
            return None
        if self.throughput_bytes is not None and self.throughput_bytes > 0:
            return self.throughput_bytes / self.mean_seconds
        if self.throughput_elements is not None and self.throughput_elements > 0:
            return self.throughput_elements / self.mean_seconds
        return None

    @property
    def throughput_rate_str(self) -> str | None:
        """Format throughput with confidence intervals if available."""
        if self.mean_seconds <= 0:
            return None
        if self.throughput_bytes is not None and self.throughput_bytes > 0:
            bps = self.throughput_bytes / self.mean_seconds
            bps_low = self.throughput_bytes / self.upper_seconds
            bps_high = self.throughput_bytes / self.lower_seconds
            return f"{Presentation.format_bytes_per_sec(bps)} [{Presentation.format_bytes_per_sec(bps_low)}, {Presentation.format_bytes_per_sec(bps_high)}]"
        if self.throughput_elements is not None and self.throughput_elements > 0:
            eps = self.throughput_elements / self.mean_seconds
            eps_low = self.throughput_elements / self.upper_seconds
            eps_high = self.throughput_elements / self.lower_seconds
            return f"{Presentation.format_elements_per_sec(eps)} [{Presentation.format_elements_per_sec(eps_low)}, {Presentation.format_elements_per_sec(eps_high)}]"
        return None


@dataclass(frozen=True, slots=True)
class BenchmarkSeries:
    """A series of benchmark data points sharing a group/function key."""

    name: str
    data_points: tuple[BenchmarkDataPoint, ...]

    def __post_init__(self) -> None:
        if any(
            self.data_points[i].input_size > self.data_points[i + 1].input_size
            for i in range(len(self.data_points) - 1)
        ):
            sorted_points = tuple(
                sorted(self.data_points, key=lambda p: p.input_size)
            )
            object.__setattr__(self, "data_points", sorted_points)

    def __len__(self) -> int:
        return len(self.data_points)

    @property
    def input_sizes(self) -> tuple[int, ...]:
        return tuple(int(point.input_size) for point in self.data_points)

    @property
    def input_unit(self) -> str:
        units = {point.input_unit for point in self.data_points}
        return units.pop() if len(units) == 1 else "input units"

    @property
    def size_range(self) -> str:
        sizes = [point.input_size for point in self.data_points]
        return f"{min(sizes):,.0f} → {max(sizes):,.0f}"

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        return self.data_points[-1]

    @property
    def mean_seconds(self) -> float:
        return float(np.mean([point.mean_seconds for point in self.data_points]))

    @property
    def is_constant(self) -> bool:
        times = [point.mean_seconds for point in self.data_points]
        return max(times) - min(times) < CONSTANT_SPREAD_EPSILON

    @property
    def has_throughput(self) -> bool:
        return any(
            p.throughput_bytes is not None or p.throughput_elements is not None
            for p in self.data_points
        )


@dataclass(frozen=True, slots=True)
class FittedModel:
    """An OLS complexity model with in-sample and held-out evidence."""

    kind: ModelKind
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    validation_rmse: float
    coeff_nlogn: float = 0.0

    @property
    def label(self) -> str:
        return self.kind.label

    @property
    def parameter_count(self) -> int:
        return self.kind.parameter_count

    @property
    def has_high_r_squared(self) -> bool:
        return self.r_squared >= R2_RELIABLE_THRESHOLD

    def predict(self, input_size: float) -> float:
        """Predict mean seconds at a positive input size."""
        n = input_size
        match self.kind:
            case ModelKind.LINEAR:
                return self.coeff_n * n + self.coeff_intercept
            case ModelKind.LOG:
                return self.coeff_n * n * np.log(n) + self.coeff_intercept
            case ModelKind.COMBINED:
                return (
                    self.coeff_n * n
                    + self.coeff_nlogn * n * np.log(n)
                    + self.coeff_intercept
                )


@dataclass(frozen=True, slots=True)
class Extrapolation:
    """A model prediction beyond the measured input domain."""

    input_size: int
    predicted_seconds: float
    model_kind: ModelKind
    throughput_rate_str: str | None = None


@dataclass(frozen=True, slots=True)
class SeriesAnalysis:
    """One benchmark series with fitted models, baseline changes, and trust decisions."""

    series: BenchmarkSeries
    models: tuple[FittedModel, ...]

    @property
    def name(self) -> str:
        return self.series.name

    @property
    def data_points(self) -> tuple[BenchmarkDataPoint, ...]:
        return self.series.data_points

    @property
    def best_model(self) -> FittedModel:
        return self.models[0]

    @property
    def input_sizes(self) -> tuple[int, ...]:
        return self.series.input_sizes

    @property
    def input_unit(self) -> str:
        return self.series.input_unit

    @property
    def size_range(self) -> str:
        return self.series.size_range

    @property
    def group(self) -> str:
        """Criterion benchmark_group_id shared by all variants of one function sweep."""
        return self.series.data_points[0].group

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        return self.series.largest_measurement

    @property
    def mean_seconds(self) -> float:
        return self.series.mean_seconds

    @property
    def is_constant(self) -> bool:
        return self.series.is_constant

    @property
    def has_throughput(self) -> bool:
        return self.series.has_throughput

    @property
    def residual_dof(self) -> int:
        return len(self.series) - self.best_model.parameter_count

    @property
    def trust(self) -> FitTrust:
        checks = (
            (
                FitTrust.INSUFFICIENT_INPUT_SIZES,
                len(self.series) < MIN_POINTS_FOR_TRUSTED_FIT,
            ),
            (
                FitTrust.INSUFFICIENT_RESIDUAL_DOF,
                self.residual_dof < MIN_RESIDUAL_DOF,
            ),
            (
                FitTrust.UNVALIDATED,
                not np.isfinite(self.best_model.validation_rmse),
            ),
            (FitTrust.WEAK_R_SQUARED, not self.best_model.has_high_r_squared),
        )
        return next(
            (status for status, failed in checks if failed),
            FitTrust.EXPLORATORY,
        )

    @property
    def is_fit_trusted(self) -> bool:
        return self.trust.is_trusted

    @property
    def latest_change(self) -> BaselineChange | None:
        return self.largest_measurement.change_vs_base

    @property
    def extrapolations(self) -> tuple[Extrapolation, ...]:
        if not self.is_fit_trusted:
            return ()
        results: list[Extrapolation] = []
        latest = self.largest_measurement
        for size in EXTRAPOLATION_TARGETS:
            if size <= latest.input_size:
                continue
            pred_time = self.best_model.predict(float(size))
            rate_str = None
            if pred_time > 0:
                if latest.throughput_bytes and latest.input_size > 0:
                    bytes_at_size = (latest.throughput_bytes / latest.input_size) * size
                    rate_str = Presentation.format_bytes_per_sec(bytes_at_size / pred_time)
                elif latest.throughput_elements and latest.input_size > 0:
                    elems_at_size = (latest.throughput_elements / latest.input_size) * size
                    rate_str = Presentation.format_elements_per_sec(elems_at_size / pred_time)
            results.append(Extrapolation(size, pred_time, self.best_model.kind, rate_str))
        return tuple(results)

    @property
    def has_negative_extrapolation(self) -> bool:
        return any(ext.predicted_seconds < 0 for ext in self.extrapolations)

    @property
    def prediction_at_summary_target(self) -> float | None:
        if not self.is_fit_trusted:
            return None
        return self.best_model.predict(float(SUMMARY_TARGET))


# ------------------------------------------------------------- #
#                       Criterion Loading                       #
# ------------------------------------------------------------- #


class CriterionRepository:
    """Reads benchmark measurements from a Criterion output directory."""

    def __init__(self, root: Path) -> None:
        self._root = root

    def load_series(self) -> dict[str, BenchmarkSeries]:
        """Load measurements grouped and ordered by numeric input size."""
        if not self._root.exists():
            raise FileNotFoundError(f"Criterion output not found: {self._root}")

        points_by_key: dict[str, list[BenchmarkDataPoint]] = {}
        for group_dir in sorted(self._root.iterdir()):
            if group_dir.is_dir() and not group_dir.name.startswith("."):
                self._load_group(points_by_key, group_dir)

        return {
            key: BenchmarkSeries(name=key, data_points=tuple(points))
            for key, points in points_by_key.items()
        }

    def _load_group(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group_dir: Path,
    ) -> None:
        """Load one group directory, including nested function sweeps."""
        for child_dir in sorted(group_dir.iterdir()):
            if not child_dir.is_dir() or child_dir.name in ("report", "change"):
                continue
            if (child_dir / "new").is_dir():
                point = self._parse(group_dir.name, "", child_dir)
                if point is not None:
                    series.setdefault(group_dir.name, []).append(point)
                continue
            self._load_nested(series, group_dir.name, child_dir)

    def _load_nested(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group: str,
        function_dir: Path,
    ) -> None:
        """Load one group/function sweep."""
        for size_dir in sorted(function_dir.iterdir()):
            if not size_dir.is_dir() or size_dir.name in ("report", "change"):
                continue
            if (size_dir / "new").is_dir():
                point = self._parse(group, function_dir.name, size_dir)
                if point is not None:
                    series.setdefault(f"{group}/{function_dir.name}", []).append(point)

    @staticmethod
    def _parse(
        group: str,
        function: str,
        sweep_dir: Path,
    ) -> BenchmarkDataPoint | None:
        """Parse a Criterion estimate, statistics, throughput, and baseline change."""
        results_dir = sweep_dir / "new"
        change_dir = sweep_dir / "change"
        try:
            bench: dict[str, Any] = json.loads(
                (results_dir / "benchmark.json").read_text()
            )
            estimates: dict[str, Any] = json.loads(
                (results_dir / "estimates.json").read_text()
            )
            input_size, input_unit, th_bytes, th_elems = (
                CriterionRepository._parse_input(bench)
            )

            mean = estimates["mean"]
            interval = mean["confidence_interval"]
            timing = TimingInterval.from_criterion_nanoseconds(
                point_estimate_ns=mean["point_estimate"],
                lower_ns=interval["lower_bound"],
                upper_ns=interval["upper_bound"],
            )

            median = (
                EstimateInterval.from_dict(estimates["median"], scale=1e-9)
                if "median" in estimates
                else None
            )
            mad = (
                EstimateInterval.from_dict(estimates["median_abs_dev"], scale=1e-9)
                if "median_abs_dev" in estimates
                else None
            )
            std_dev = (
                EstimateInterval.from_dict(estimates["std_dev"], scale=1e-9)
                if "std_dev" in estimates
                else None
            )
            slope = (
                EstimateInterval.from_dict(estimates["slope"], scale=1e-9)
                if "slope" in estimates
                else None
            )
            slope_r2 = (
                float(estimates["slope"]["r_squared"])
                if "slope" in estimates and "r_squared" in estimates["slope"]
                else None
            )

        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
        ):
            return None

        # Load baseline delta if present
        change_vs_base = None
        change_estimates_file = change_dir / "estimates.json"
        if change_estimates_file.exists():
            try:
                change_data = json.loads(change_estimates_file.read_text())
                change_vs_base = BaselineChange.from_dict(change_data)
            except Exception:
                change_vs_base = None

        outliers = CriterionRepository._parse_outliers(results_dir)
        return BenchmarkDataPoint(
            group=group,
            input_size=input_size,
            input_unit=input_unit,
            timing=timing,
            median=median,
            mad=mad,
            std_dev=std_dev,
            slope=slope,
            slope_r_squared=slope_r2,
            throughput_bytes=th_bytes,
            throughput_elements=th_elems,
            change_vs_base=change_vs_base,
            outliers=outliers,
            function=function,
        )

    @staticmethod
    def _parse_outliers(results_dir: Path) -> OutlierStats:
        """Count Criterion's mild and severe Tukey outliers with sample totals."""
        try:
            sample: dict[str, list[float]] = json.loads(
                (results_dir / "sample.json").read_text()
            )
            lower_severe, lower_mild, upper_mild, upper_severe = (
                float(value)
                for value in json.loads((results_dir / "tukey.json").read_text())
            )
            values = [
                float(time) / float(iterations)
                for time, iterations in zip(
                    sample["times"], sample["iters"], strict=True
                )
            ]
        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
            ZeroDivisionError,
        ):
            return OutlierStats()

        total = len(values)
        low_sev = sum(v < lower_severe for v in values)
        low_mld = sum(lower_severe <= v < lower_mild for v in values)
        high_mld = sum(upper_mild < v <= upper_severe for v in values)
        high_sev = sum(v > upper_severe for v in values)

        return OutlierStats(
            total_samples=total,
            low_severe=low_sev,
            low_mild=low_mld,
            high_mild=high_mld,
            high_severe=high_sev,
        )

    @staticmethod
    def _parse_input(
        benchmark: Mapping[str, Any]
    ) -> tuple[float, str, float | None, float | None]:
        """Return numeric size, unit, and optional bytes/elements throughput."""
        throughput = benchmark.get("throughput")
        th_bytes = None
        th_elems = None

        if isinstance(throughput, Mapping):
            if "Bytes" in throughput or "BytesDecimal" in throughput:
                th_bytes = float(
                    throughput.get("Bytes") or throughput.get("BytesDecimal", 0)
                )
            if "Elements" in throughput:
                th_elems = float(throughput["Elements"])

            if len(throughput) == 1:
                kind, value = next(iter(throughput.items()))
                if isinstance(value, int | float) and value > 0:
                    unit_label = CriterionRepository._throughput_unit(str(kind))
                    return float(value), unit_label, th_bytes, th_elems

        return float(benchmark.get("value_str", 1)), "input units", th_bytes, th_elems

    @staticmethod
    def _throughput_unit(kind: str) -> str:
        return {
            "Elements": "elements",
            "Bytes": "bytes",
            "BytesDecimal": "bytes",
        }.get(kind, kind.replace("_", " ").lower())


