class Presentation:
    """Shared formatting utilities for units, intervals, and text clipping."""

    @staticmethod
    def time_unit(seconds: float) -> tuple[str, float]:
        magnitude = abs(seconds)
        if magnitude < 0.000_001:
            return "ns", 1_000_000_000
        if magnitude < 0.001:
            return "µs", 1_000_000
        if magnitude < 1.0:
            return "ms", 1_000
        return "s", 1

    @staticmethod
    def precision_for(unit: str, scaled_value: float) -> int:
        if unit == "s":
            return 2
        return 2 if scaled_value < 10.0 else 1

    @staticmethod
    def format_seconds(seconds: float) -> str:
        unit, scale = Presentation.time_unit(seconds)
        scaled = seconds * scale
        prec = Presentation.precision_for(unit, scaled)
        return f"{scaled:.{prec}f}{unit}"

    @staticmethod
    def format_bytes_per_sec(bps: float) -> str:
        if bps >= 1e9:
            return f"{bps / 1e9:.2f} GB/s"
        if bps >= 1e6:
            return f"{bps / 1e6:.2f} MB/s"
        if bps >= 1e3:
            return f"{bps / 1e3:.1f} KB/s"
        return f"{bps:.0f} B/s"

    @staticmethod
    def format_elements_per_sec(eps: float) -> str:
        if eps >= 1e6:
            return f"{eps / 1e6:.2f}M elem/s"
        if eps >= 1e3:
            return f"{eps / 1e3:.1f}K elem/s"
        return f"{eps:.0f} elem/s"

    @staticmethod
    def format_outlier_summary(data_points: Sequence[BenchmarkDataPoint]) -> str:
        mild = sum(point.mild_outlier_count for point in data_points)
        severe = sum(point.severe_outlier_count for point in data_points)
        if mild == severe == 0:
            return "none"
        parts = [
            f"{count} {kind}"
            for count, kind in ((mild, "mild"), (severe, "severe"))
            if count
        ]
        return f"{' · '.join(parts)} across {len(data_points)} sizes"

    @staticmethod
    def truncate_middle(text: str, max_len: int) -> str:
        if len(text) <= max_len:
            return text
        keep = max_len - 1
        head = (keep + 1) // 2
        tail = keep - head
        return f"{text[:head]}…{text[-tail:]}" if tail else f"{text[:head]}…"

    @staticmethod
    def terminal_width() -> int:
        cols_env = os.environ.get("COLUMNS")
        if cols_env:
            try:
                val = int(cols_env)
                if val > 0:
                    return val
            except ValueError:
                pass
        try:
            return os.get_terminal_size().columns
        except OSError:
            return 100

