@dataclass(frozen=True, slots=True)
class TimingInterval:
    """Mean wall-clock timing and its 95% bootstrap confidence interval."""

    mean_seconds: float
    lower_seconds: float
    upper_seconds: float

    @classmethod
    def from_criterion_nanoseconds(
        cls,
        point_estimate_ns: float,
        lower_ns: float,
        upper_ns: float,
    ) -> TimingInterval:
        """Construct from raw Criterion nanosecond estimates."""
        return cls(
            mean_seconds=float(point_estimate_ns) / 1e9,
            lower_seconds=float(lower_ns) / 1e9,
            upper_seconds=float(upper_ns) / 1e9,
        )

    def format_with_ci(self) -> str:
        """Format the estimate and 95% confidence bounds with auto-scaled units."""
        unit, scale = Presentation.time_unit(self.mean_seconds)
        est = self.mean_seconds * scale
        low = self.lower_seconds * scale
        high = self.upper_seconds * scale
        prec = Presentation.precision_for(unit, est)
        return f"{est:.{prec}f}{unit} [{low:.{prec}f}, {high:.{prec}f}]"


@dataclass(frozen=True, slots=True)
class BenchmarkDataPoint:
    """One Criterion timing estimate at a measured input size."""

    group: str
    input_size: float
    input_unit: str
    timing: TimingInterval
    mild_outlier_count: int = 0
    severe_outlier_count: int = 0
    function: str = ""

    @property
    def mean_seconds(self) -> float:
        return self.timing.mean_seconds

    @property
    def lower_seconds(self) -> float:
        return self.timing.lower_seconds

    @property
    def upper_seconds(self) -> float:
        return self.timing.upper_seconds


@dataclass(frozen=True, slots=True)
class BenchmarkSeries:
    """A series of benchmark data points sharing a group/function key."""

    name: str
    data_points: tuple[BenchmarkDataPoint, ...]

    def __post_init__(self) -> None:
        if any(
            self.data_points[i].input_size > self.data_points[i + 1].input_size
            for i in range(len(self.data_points) - 1)
        ):
            sorted_points = tuple(
                sorted(self.data_points, key=lambda p: p.input_size)
            )
            object.__setattr__(self, "data_points", sorted_points)

    def __len__(self) -> int:
        return len(self.data_points)

    @property
    def input_sizes(self) -> tuple[int, ...]:
        return tuple(int(point.input_size) for point in self.data_points)

    @property
    def input_unit(self) -> str:
        units = {point.input_unit for point in self.data_points}
        return units.pop() if len(units) == 1 else "input units"

    @property
    def size_range(self) -> str:
        sizes = [point.input_size for point in self.data_points]
        return f"{min(sizes):,.0f} → {max(sizes):,.0f}"

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        return self.data_points[-1]

    @property
    def mean_seconds(self) -> float:
        return float(np.mean([point.mean_seconds for point in self.data_points]))

    @property
    def is_constant(self) -> bool:
        times = [point.mean_seconds for point in self.data_points]
        return max(times) - min(times) < CONSTANT_SPREAD_EPSILON


@dataclass(frozen=True, slots=True)
class FittedModel:
    """An OLS complexity model with in-sample and held-out evidence."""

    kind: ModelKind
    coeff_n: float
    coeff_intercept: float
    r_squared: float
    validation_rmse: float
    coeff_nlogn: float = 0.0

    @property
    def label(self) -> str:
        return self.kind.label

    @property
    def parameter_count(self) -> int:
        return self.kind.parameter_count

    @property
    def has_high_r_squared(self) -> bool:
        return self.r_squared >= R2_RELIABLE_THRESHOLD

    def predict(self, input_size: float) -> float:
        """Predict mean seconds at a positive input size."""
        n = input_size
        match self.kind:
            case ModelKind.LINEAR:
                return self.coeff_n * n + self.coeff_intercept
            case ModelKind.LOG:
                return self.coeff_n * n * np.log(n) + self.coeff_intercept
            case ModelKind.COMBINED:
                return (
                    self.coeff_n * n
                    + self.coeff_nlogn * n * np.log(n)
                    + self.coeff_intercept
                )


@dataclass(frozen=True, slots=True)
class Extrapolation:
    """A model prediction beyond the measured input domain."""

    input_size: int
    predicted_seconds: float
    model_kind: ModelKind


@dataclass(frozen=True, slots=True)
class SeriesAnalysis:
    """One benchmark series with fitted models and trust decisions."""

    series: BenchmarkSeries
    models: tuple[FittedModel, ...]

    @property
    def name(self) -> str:
        return self.series.name

    @property
    def data_points(self) -> tuple[BenchmarkDataPoint, ...]:
        return self.series.data_points

    @property
    def best_model(self) -> FittedModel:
        return self.models[0]

    @property
    def input_sizes(self) -> tuple[int, ...]:
        return self.series.input_sizes

    @property
    def input_unit(self) -> str:
        return self.series.input_unit

    @property
    def size_range(self) -> str:
        return self.series.size_range

    @property
    def largest_measurement(self) -> BenchmarkDataPoint:
        return self.series.largest_measurement

    @property
    def mean_seconds(self) -> float:
        return self.series.mean_seconds

    @property
    def is_constant(self) -> bool:
        return self.series.is_constant

    @property
    def residual_dof(self) -> int:
        return len(self.series) - self.best_model.parameter_count

    @property
    def trust(self) -> FitTrust:
        checks = (
            (
                FitTrust.INSUFFICIENT_INPUT_SIZES,
                len(self.series) < MIN_POINTS_FOR_TRUSTED_FIT,
            ),
            (
                FitTrust.INSUFFICIENT_RESIDUAL_DOF,
                self.residual_dof < MIN_RESIDUAL_DOF,
            ),
            (
                FitTrust.UNVALIDATED,
                not np.isfinite(self.best_model.validation_rmse),
            ),
            (FitTrust.WEAK_R_SQUARED, not self.best_model.has_high_r_squared),
        )
        return next(
            (status for status, failed in checks if failed),
            FitTrust.EXPLORATORY,
        )

    @property
    def is_fit_trusted(self) -> bool:
        return self.trust.is_trusted

    @property
    def extrapolations(self) -> tuple[Extrapolation, ...]:
        if not self.is_fit_trusted:
            return ()
        return tuple(
            Extrapolation(
                size,
                self.best_model.predict(float(size)),
                self.best_model.kind,
            )
            for size in EXTRAPOLATION_TARGETS
            if size > self.largest_measurement.input_size
        )

    @property
    def has_negative_extrapolation(self) -> bool:
        return any(ext.predicted_seconds < 0 for ext in self.extrapolations)

    @property
    def prediction_at_summary_target(self) -> float | None:
        if not self.is_fit_trusted:
            return None
        return self.best_model.predict(float(SUMMARY_TARGET))


# ------------------------------------------------------------- #
#                       Criterion Loading                       #
# ------------------------------------------------------------- #


class CriterionRepository:
    """Reads benchmark measurements from a Criterion output directory."""

    def __init__(self, root: Path) -> None:
        self._root = root

    def load_series(self) -> dict[str, BenchmarkSeries]:
        """Load measurements grouped and ordered by numeric input size."""
        if not self._root.exists():
            raise FileNotFoundError(f"Criterion output not found: {self._root}")

        points_by_key: dict[str, list[BenchmarkDataPoint]] = {}
        for group_dir in sorted(self._root.iterdir()):
            if group_dir.is_dir():
                self._load_group(points_by_key, group_dir)

        return {
            key: BenchmarkSeries(name=key, data_points=tuple(points))
            for key, points in points_by_key.items()
        }

    def _load_group(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group_dir: Path,
    ) -> None:
        """Load one group directory, including nested function sweeps."""
        for child_dir in sorted(group_dir.iterdir()):
            if not child_dir.is_dir():
                continue
            if (child_dir / "new").is_dir():
                point = self._parse(group_dir.name, "", child_dir / "new")
                if point is not None:
                    series.setdefault(group_dir.name, []).append(point)
                continue
            self._load_nested(series, group_dir.name, child_dir)

    def _load_nested(
        self,
        series: dict[str, list[BenchmarkDataPoint]],
        group: str,
        function_dir: Path,
    ) -> None:
        """Load one group/function sweep."""
        for size_dir in sorted(function_dir.iterdir()):
            if not size_dir.is_dir():
                continue
            results_dir = size_dir / "new"
            if not results_dir.is_dir():
                continue
            point = self._parse(group, function_dir.name, results_dir)
            if point is not None:
                series.setdefault(f"{group}/{function_dir.name}", []).append(point)

    @staticmethod
    def _parse(
        group: str,
        function: str,
        results_dir: Path,
    ) -> BenchmarkDataPoint | None:
        """Parse a Criterion estimate and its input-size metadata."""
        try:
            bench: dict[str, Any] = json.loads(
                (results_dir / "benchmark.json").read_text()
            )
            estimates: dict[str, Any] = json.loads(
                (results_dir / "estimates.json").read_text()
            )
            input_size, input_unit = CriterionRepository._parse_input(bench)
            mean = estimates["mean"]
            interval = mean["confidence_interval"]
            timing = TimingInterval.from_criterion_nanoseconds(
                point_estimate_ns=mean["point_estimate"],
                lower_ns=interval["lower_bound"],
                upper_ns=interval["upper_bound"],
            )
        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
        ):
            return None
        mild_outliers, severe_outliers = CriterionRepository._outlier_counts(
            results_dir
        )
        return BenchmarkDataPoint(
            group=group,
            input_size=input_size,
            input_unit=input_unit,
            timing=timing,
            mild_outlier_count=mild_outliers,
            severe_outlier_count=severe_outliers,
            function=function,
        )

    @staticmethod
    def _outlier_counts(results_dir: Path) -> tuple[int, int]:
        """Count Criterion's mild and severe Tukey outliers, if available."""
        try:
            sample: dict[str, list[float]] = json.loads(
                (results_dir / "sample.json").read_text()
            )
            lower_severe, lower_mild, upper_mild, upper_severe = (
                float(value)
                for value in json.loads((results_dir / "tukey.json").read_text())
            )
            values = [
                float(time) / float(iterations)
                for time, iterations in zip(
                    sample["times"], sample["iters"], strict=True
                )
            ]
        except (
            FileNotFoundError,
            json.JSONDecodeError,
            KeyError,
            TypeError,
            ValueError,
            ZeroDivisionError,
        ):
            return 0, 0
        mild = sum(
            lower_severe <= value < lower_mild
            or upper_mild < value <= upper_severe
            for value in values
        )
        severe = sum(
            value < lower_severe or value > upper_severe for value in values
        )
        return mild, severe

    @staticmethod
    def _parse_input(benchmark: Mapping[str, Any]) -> tuple[float, str]:
        """Return Criterion throughput when present, else its numeric value."""
        throughput = benchmark.get("throughput")
        if isinstance(throughput, Mapping) and len(throughput) == 1:
            kind, value = next(iter(throughput.items()))
            if isinstance(value, int | float) and value > 0:
                return float(value), CriterionRepository._throughput_unit(str(kind))
        return float(benchmark["value_str"]), "input units"

    @staticmethod
    def _throughput_unit(kind: str) -> str:
        """Map Criterion's serialized throughput kind to a display label."""
        return {
            "Elements": "elements",
            "Bytes": "bytes",
            "BytesDecimal": "bytes",
        }.get(kind, kind.replace("_", " ").lower())


# ------------------------------------------------------------- #
#                         Model Fitting                         #
# ------------------------------------------------------------- #


class ModelFitter:
    """Fits OLS candidate models and ranks them by leave-one-out error."""

    def fit(
        self, series: BenchmarkSeries | Sequence[BenchmarkDataPoint]
    ) -> tuple[FittedModel, ...]:
        """Fit every candidate kind, ordered by leave-one-out RMSE."""
        data_points = (
            series.data_points if isinstance(series, BenchmarkSeries) else series
        )
        x = np.array([point.input_size for point in data_points])
        y = np.array([point.mean_seconds for point in data_points])
        if np.var(y) == 0:
            return ()

        kinds = [ModelKind.LINEAR, ModelKind.LOG]
        if len(data_points) >= MIN_POINTS_FOR_COMBINED:
            kinds.append(ModelKind.COMBINED)
        models = [self._fit_kind(kind, x, y) for kind in kinds]
        return tuple(
            sorted(models, key=lambda model: (model.validation_rmse, -model.r_squared))
        )

    @staticmethod
    def _fit_kind(kind: ModelKind, x: np.ndarray, y: np.ndarray) -> FittedModel:
        """OLS-fit one candidate and calculate its leave-one-out RMSE."""
        features = kind.design_matrix(x)
        regression = LinearRegression().fit(features, y)
        return FittedModel(
            kind=kind,
            coeff_n=float(regression.coef_[0]),
            coeff_nlogn=float(regression.coef_[1])
            if kind is ModelKind.COMBINED
            else 0.0,
            coeff_intercept=float(regression.intercept_),
            r_squared=float(regression.score(features, y)),
            validation_rmse=ModelFitter._leave_one_out_rmse(features, y),
        )

    @staticmethod
    def _leave_one_out_rmse(features: np.ndarray, y: np.ndarray) -> float:
        """Calculate prediction RMSE with each measurement held out once."""
        if len(y) - 1 < features.shape[1] + 1:
            return float("inf")
        errors = np.empty(len(y))
        for index in range(len(y)):
            mask = np.ones(len(y), dtype=bool)
            mask[index] = False
            regression = LinearRegression().fit(features[mask], y[mask])
            prediction = regression.predict(features[index : index + 1])[0]
            errors[index] = y[index] - prediction
        return float(np.sqrt(np.mean(np.square(errors))))


# ------------------------------------------------------------- #
#                        Summary Analysis                       #
# ------------------------------------------------------------- #


@dataclass(frozen=True, slots=True)
class RankedFit:
    """A supported fit ranked by its estimate at the summary target."""

    name: str
    model: FittedModel
    predicted_seconds: float


@dataclass(frozen=True, slots=True)
class UnreliableFit:
    """A series excluded from extrapolated ranking with its evidence status."""

    name: str
    model: FittedModel
    reason: str


@dataclass(frozen=True, slots=True)
class ConstantFit:
    """A series whose time barely changes with input size."""

    name: str
    mean_seconds: float


@dataclass(frozen=True, slots=True)
class SummaryData:
    """Classification of every fitted series for the aggregate report."""

    total_series: int
    ranked: tuple[RankedFit, ...]
    unreliable: tuple[UnreliableFit, ...]
    constant: tuple[ConstantFit, ...]
    scaling_counts: Mapping[ModelKind, int]

    @property
    def supported_fit_count(self) -> int:
        return len(self.ranked)

    @property
    def unreliable_count(self) -> int:
        return len(self.unreliable)

    @property
    def constant_count(self) -> int:
        return len(self.constant)


def build_summary(
    analyses: Sequence[SeriesAnalysis],
    target: int = SUMMARY_TARGET,
) -> SummaryData:
    """Classify analyses into constant, untrusted, and ranked buckets."""
    ranked: list[RankedFit] = []
    unreliable: list[UnreliableFit] = []
    constant: list[ConstantFit] = []
    scaling = dict.fromkeys(ModelKind, 0)

    for analysis in analyses:
        if analysis.is_constant:
            constant.append(ConstantFit(analysis.name, analysis.mean_seconds))
            continue
        best = analysis.best_model
        scaling[best.kind] += 1
        if not analysis.is_fit_trusted:
            unreliable.append(
                UnreliableFit(analysis.name, best, analysis.trust.label.lower())
            )
            continue
        predicted = best.predict(float(target))
        if predicted <= 0:
            unreliable.append(
                UnreliableFit(analysis.name, best, "negative prediction")
            )
            continue
        ranked.append(RankedFit(analysis.name, best, predicted))

    ranked.sort(key=lambda entry: entry.predicted_seconds, reverse=True)
    return SummaryData(
        total_series=len(analyses),
        ranked=tuple(ranked),
        unreliable=tuple(unreliable),
        constant=tuple(constant),
        scaling_counts=scaling,
    )


# ------------------------------------------------------------- #
#                           Formatting                          #
# ------------------------------------------------------------- #


class Presentation:
    """Shared formatting utilities for units, intervals, and text clipping."""

    @staticmethod
    def time_unit(seconds: float) -> tuple[str, float]:
        """Return a readable time unit and seconds-to-unit scale."""
        magnitude = abs(seconds)
        if magnitude < 0.000_001:
            return "ns", 1_000_000_000
        if magnitude < 0.001:
            return "µs", 1_000_000
        if magnitude < 1.0:
            return "ms", 1_000
        return "s", 1

    @staticmethod
    def precision_for(unit: str, scaled_value: float) -> int:
        """Select readable decimal precision avoiding loss of resolution."""
        if unit == "s":
            return 2
        return 2 if scaled_value < 10.0 else 1

    @staticmethod
    def format_seconds(seconds: float) -> str:
        """Format seconds with a unit and precision chosen by magnitude."""
        unit, scale = Presentation.time_unit(seconds)
        scaled = seconds * scale
        prec = Presentation.precision_for(unit, scaled)
        return f"{scaled:.{prec}f}{unit}"

    @staticmethod
    def format_outlier_summary(data_points: Sequence[BenchmarkDataPoint]) -> str:
        """Summarize Criterion's Tukey outliers without discarding data."""
        mild = sum(point.mild_outlier_count for point in data_points)
        severe = sum(point.severe_outlier_count for point in data_points)
        if mild == severe == 0:
            return "none"
        parts = [
            f"{count} {kind}"
            for count, kind in ((mild, "mild"), (severe, "severe"))
            if count
        ]
        return f"{' · '.join(parts)} across {len(data_points)} sizes"

    @staticmethod
    def truncate_middle(text: str, max_len: int) -> str:
        """Shorten ``text`` to ``max_len`` keeping prefix and suffix."""
        if len(text) <= max_len:
            return text
        keep = max_len - 1
        head = (keep + 1) // 2
        tail = keep - head
        return f"{text[:head]}…{text[-tail:]}" if tail else f"{text[:head]}…"


# ------------------------------------------------------------- #
#                           Reporting                           #
# ------------------------------------------------------------- #


class SeriesReporter:
    """Renders a clean, scan-first report before a plot and evidence table after it."""

    def render_summary(self, analysis: SeriesAnalysis) -> str:
        """Render the primary operational answer that leads the view."""
        best = analysis.best_model
        latest = analysis.largest_measurement
        lines: list[str] = [
            f"{analysis.name:<46} {len(analysis.data_points)} sizes · {analysis.size_range} {analysis.input_unit}",
            "",
            f"FIT  {analysis.trust.label}",
            f"  Candidate: {best.label}",
            f"  Evidence: {len(analysis.data_points)} input sizes · {analysis.residual_dof} residual DOF",
            f"  Largest input: {latest.input_size:,.0f} {analysis.input_unit}",
            f"  Measured time: {latest.timing.format_with_ci()}  95% CI",
            *self._outlook_lines(analysis),
        ]
        return "\n".join(lines)

    def render_details(self, analysis: SeriesAnalysis) -> str:
        """Render evidence and selection diagnostics after the plot."""
        best = analysis.best_model
        extrapolation = (
            "enabled"
            if analysis.is_fit_trusted
            else "withheld: insufficient evidence"
        )
        lines: list[str] = [
            "DETAILS",
            f"  {'candidate model':<23} {best.label}",
            f"  {'fit status':<23} {analysis.trust.label.lower()}",
            f"  {'selection':<23} lowest leave-one-out RMSE",
            (
                f"  {'leave-one-out RMSE':<23} "
                f"{Presentation.format_seconds(best.validation_rmse)}"
            ),
            f"  {'in-sample ' + R_SQUARED:<23} {best.r_squared:.4f}",
            f"  {'residual DOF':<23} {analysis.residual_dof}",
            (
                f"  {'sample outliers':<23} "
                f"{Presentation.format_outlier_summary(analysis.data_points)}"
            ),
            f"  {'extrapolation':<23} {extrapolation}",
            f"  {'coefficients':<23} omitted; terms are not interpreted",
        ]
        return "\n".join(lines)

    @staticmethod
    def _outlook_lines(analysis: SeriesAnalysis) -> list[str]:
        if not analysis.is_fit_trusted:
            return [
                "",
                "FORECASTS WITHHELD",
                f"  {analysis.trust.reason}.",
                "  Add input sizes before using this model for capacity estimates.",
            ]
        if analysis.has_negative_extrapolation:
            return [
                "",
                "FORECASTS WITHHELD",
                "  The model becomes negative beyond the measured data range.",
            ]
        latest = analysis.largest_measurement
        lines: list[str] = [
            "",
            "OUTLOOK (model-based estimates)",
            f"  {'input size':<18} {'time':<22} basis",
            f"  {'-' * 16:<18} {'-' * 20:<22} ----------------------------",
            (
                f"  {f'{latest.input_size:,.0f} {analysis.input_unit}':<18} "
                f"{latest.timing.format_with_ci():<22} measured · 95% CI"
            ),
        ]
        for extrapolation in analysis.extrapolations:
            distance = extrapolation.input_size / latest.input_size
            lines.append(
                f"  {f'{extrapolation.input_size:,} {analysis.input_unit}':<18} "
                f"{Presentation.format_seconds(extrapolation.predicted_seconds):<22} "
                f"extrapolated · {distance:.1f}× range"
            )
        return lines


class SummaryReporter:
    """Renders the overview of every fitted series in a clean, scan-friendly layout."""

    def __init__(
        self,
        worst_count: int = DEFAULT_WORST_COUNT,
        target: int = SUMMARY_TARGET,
    ) -> None:
        self._worst_count = worst_count
        self._target = target

    def render(self, data: SummaryData) -> str:
        """Render the aggregate summary."""
        lines: list[str] = [
            "PERFORMANCE SUMMARY",
            (
                f"{data.total_series} series  |  {data.supported_fit_count} supported"
                f"  |  {data.unreliable_count} unreliable"
                f"  |  {data.constant_count} constant"
            ),
            *self._ranked_lines(data),
            *self._unreliable_lines(data),
            *self._scaling_lines(data),
            *self._constant_lines(data),
        ]
        return "\n".join(lines)

    def _ranked_lines(self, data: SummaryData) -> list[str]:
        if not data.ranked:
            return []
        shown = data.ranked[: self._worst_count]
        lines: list[str] = [
            "",
            f"WORST AT {self._target // 1000}K (top {len(shown)}):",
        ]
        for rank, entry in enumerate(shown, start=1):
            name = Presentation.truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            lines.append(
                f"  {rank:>2}. {name:<{SUMMARY_NAME_WIDTH}}"
                f" {Presentation.format_seconds(entry.predicted_seconds):>8}"
                f"  {entry.model.kind.short_label:<14}"
                f" {R_SQUARED}={entry.model.r_squared:.3f}"
            )
        return lines

    @staticmethod
    def _unreliable_lines(data: SummaryData) -> list[str]:
        if not data.unreliable:
            return []
        lines: list[str] = ["", "UNRELIABLE FITS:"]
        for entry in data.unreliable:
            name = Presentation.truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            lines.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {R_SQUARED}={entry.model.r_squared:.3f}  {entry.reason}"
            )
        return lines

    @staticmethod
    def _scaling_lines(data: SummaryData) -> list[str]:
        lines: list[str] = ["", "SCALING BREAKDOWN:"]
        for kind, count in data.scaling_counts.items():
            if count > 0:
                lines.append(
                    f"  {kind.short_label:<14}  {kind.breakdown_description}:"
                    f" {count} series"
                )
        return lines

    @staticmethod
    def _constant_lines(data: SummaryData) -> list[str]:
        if not data.constant:
            return []
        lines: list[str] = ["", "NEAR-CONSTANT (no scaling concern):"]
        for entry in data.constant:
            name = Presentation.truncate_middle(entry.name, SUMMARY_NAME_WIDTH)
            lines.append(
                f"  {name:<{SUMMARY_NAME_WIDTH}}"
                f" {Presentation.format_seconds(entry.mean_seconds):>8}  all sizes"
            )
        return lines


class SeriesPlotRenderer:
    """Renders measured values and supported fit curves cleanly with plotext."""

    def render(self, analysis: SeriesAnalysis) -> None:
        """Draw a clear, high-contrast terminal plot with distinct dot markers."""
        import plotext as plt

        x = [point.input_size for point in analysis.data_points]
        max_time = max(point.mean_seconds for point in analysis.data_points)
        unit, scale = Presentation.time_unit(max_time)
        y = [point.mean_seconds * scale for point in analysis.data_points]

        plt.clear_figure()
        plt.plotsize(self._width(), PLOT_HEIGHT)
        plt.theme("clear")
        plt.xlabel(f"n ({analysis.input_unit})")
        plt.ylabel(f"time ({unit})")

        # Measured points as clean, unambiguous dots
        plt.scatter(x, y, label="measured (mean)", color="cyan", marker="dot")

        if analysis.is_fit_trusted:
            curve_x = np.linspace(min(x), max(x), 100)
            curve_y = [
                analysis.best_model.predict(float(value)) * scale
                for value in curve_x
            ]
            plt.plot(
                curve_x.tolist(),
                curve_y,
                label=f"fit: {analysis.best_model.kind.short_label}",
                color="yellow",
                marker="dot",
            )
        plt.show()
        print()

    @staticmethod
    def _width() -> int:
        """Fit the plot to the terminal width comfortably."""
        try:
            columns = os.get_terminal_size().columns
        except OSError:
            return PLOT_MIN_WIDTH
        return min(PLOT_MAX_WIDTH, max(PLOT_MIN_WIDTH, columns - 4))


