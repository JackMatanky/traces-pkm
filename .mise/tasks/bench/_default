#!/bin/bash
#MISE description="Run Criterion benchmarks"
#MISE sources=["@group:bench"]
#MISE outputs=[]
#MISE cache = { enabled = false }
#MISE output = "interleave"
#MISE depends_post = ["bench:report"]
#MISE extends="bench"
#USAGE flag "-f --files <pattern>" {
#USAGE   help "Select bench targets (`benches/*.rs`) by file-name substring"
#USAGE   long_help """
#USAGE   Matches bench target file names under `benches/*.rs` by substring (e.g. `-f note` runs `benches/note_parsing.rs`).
#USAGE
#USAGE   Note: This selects bench target files, not Criterion benchmark names. To filter benchmark functions within a target, pass a regex in `[args]` after `--` (e.g. `mise run bench -f note -- fast`).
#USAGE   """
#USAGE }
#USAGE // `complete "pattern"` completes the flag's value (what follows
#USAGE // `-f`/`--files`), not the flag name itself. `-r` has no completion: its
#USAGE // value is a user-chosen save name.
#USAGE complete "pattern" run="ls benches | grep '[.]rs$' | sed 's/[.]rs$//'"
#USAGE flag "-m --mod <module>" {
#USAGE   help "Run benchmarks for one module (matches `benches/<module>*.rs`)"
#USAGE   long_help """
#USAGE   Runs benchmarks matching `benches/<module>*.rs` (e.g. `-m index` runs `benches/index_bench.rs`).
#USAGE   """
#USAGE }
#USAGE flag "--mode <mode>" {
#USAGE   choices "quick" "test" "normal"
#USAGE   default "normal"
#USAGE   help "Execution mode: `normal` (default), `quick` (fast), `test` (smoke)"
#USAGE   long_help """
#USAGE   - `normal`: measure with project defaults from `benches/common::criterion_config()` (`20` samples, `1s` measurement, `0.5s` warm-up); precedence: group pin > `[args]` > `criterion_config()`.
#USAGE   - `quick`: criterion's native `--quick`: stop at the significance level or when measurement time runs out (project cap `1s`), `--noplot`; for indicative and comparative use only.
#USAGE   - `test`: smoke-run each selected target once without measurement via `cargo test` (criterion's documented CI path); measurement/report flags (`-r`/`--no-report`/`--compare`/`--verbose`) and `[args]` are ignored.
#USAGE   """
#USAGE }
#USAGE flag "-r --report [name]" value_optional=#true {
#USAGE   help "Save a named baseline (default: auto-named from `git` branch+sha)"
#USAGE   long_help """
#USAGE   - Auto-naming: Bare `-r` names the baseline `<branch>-<short-sha>[-dirty][-quick]`. Rerunning on the same commit overwrites that name's stored results; a new commit or branch gets its own name, so distinct auto-names accumulate, one nested copy under every benchmark, and baseline storage grows with every commit checkpointed.
#USAGE   - Explicit naming: Pass a value for an explicit, memorable name instead, e.g. for a long-lived comparison point: `mise run bench -r position-refactor`
#USAGE   - First-run behavior: A first run on a commit has no `change:` line; the verdict appears only once the same auto-name runs again. Compare across commits with `--compare <baseline>` (`critcmp <name> new`).
#USAGE   - Quick mode: Under `--mode quick`, every saved baseline (explicit names included) is saved as `<name>-quick` instead (e.g. `-r foo` saves `foo-quick`, not `foo`), so quick runs never clobber normal-mode baselines; the run header echoes the final saved name.
#USAGE   - Conflicts: Criterion rejects combining `--save-baseline` with forwarded `--baseline`/`--baseline-lenient`/`--discard-baseline`. Note the task appends `--save-baseline` `<git-name>` by default even without `-r`: if you forward baseline flags, pass `--no-report`; otherwise the run fails with criterion's own argument-validation error (`--load-baseline` additionally requires `--baseline`).
#USAGE   """
#USAGE }
#USAGE flag "--no-report" help="Skip saving a named baseline (criterion uses its default `base`)"
#USAGE flag "--compare <baseline>" {
#USAGE   help "Compare against a saved baseline via `critcmp`"
#USAGE   long_help """
#USAGE   - Two-column comparison: Runs `critcmp <name> new` after the measurement run: `<baseline>` is a saved baseline (listed by `critcmp --baselines`, offered by completion) and `new` is the run just measured, displaying a two-column comparison table with change ratios.
#USAGE   - Fail-fast validation: The baseline name is pre-validated before measurement: an unknown name fails fast with an error naming it: `mise run bench --compare main-abc123`
#USAGE   - Name collision gotcha: If one run passes `-r <name>` and `--compare <baseline>` with the same name, criterion overwrites that baseline during the run and the comparison sees this run against itself (every ratio 1.00).
#USAGE   """
#USAGE }
#USAGE complete "baseline" run="critcmp --baselines 2>/dev/null"
#USAGE flag "--verbose" negate="--no-verbose" default=#true help="Criterion detailed reporting (default on; `--no-verbose` terse)"
#USAGE arg "[args]" var=#true {
#USAGE   help "Extra arguments forwarded to `cargo bench`"
#USAGE   long_help """
#USAGE   Examples:
#USAGE   - `mise run bench -- --list` - list available benchmarks
#USAGE   - `mise run bench -f note_parsing -- fast` - filter benchmarks by regex (criterion filter)
#USAGE   - `mise run bench -m index -- --warm-up-time 1` - override warm-up time in seconds
#USAGE   - `mise run bench -- --noplot` - disable plot and HTML report generation
#USAGE   - `mise run bench -- --profile-time 5` - flamegraph hot loop with no statistical analysis
#USAGE   - `mise run bench -r main -- --noise-threshold 0.03` - ignore changes within ±3% noise
#USAGE   - `mise run bench -r main -- --significance-level 0.01` - stricter p-value (longer measurement)
#USAGE
#USAGE   Notes & Gotchas:
#USAGE   - Positional filter: The forwarded positional argument is evaluated as a regular expression by Criterion.
#USAGE   - Quiet conflict: Forwarded `--quiet` conflicts with the default `--verbose`. Pair with `--no-verbose` (`mise run bench --no-verbose -- --quiet`).
#USAGE   - Quick conflict: Forwarded `--sample-size` conflicts with `--quick` (criterion rejects both). Prefer `--mode quick` over forwarding `--quick`: only `--mode quick` sets `--noplot` and the `-quick` baseline suffix.
#USAGE   """
#USAGE }

# Run Criterion benchmarks: select bench targets under `benches/*.rs`, run them
# once via `cargo bench` (or as a `cargo test` smoke in `--mode test`), and
# optionally save/compare named baselines via `critcmp`.
#
# Task-level configuration and why:
#   `cache = false`: measurement gate. The task must run on every invocation
#   and must not enter the artifact-cache replay path, because Criterion output
#   is non-deterministic and replayed logs would mask results. `outputs = []`
#   is what prevents the freshness skip: baselines must never be skipped as
#   `fresh` (project policy).
#   `output = "interleave"`: raw criterion output. Verbose statistical tables
#   are unreadable when every line is prefixed `bench: …`.
# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

declare -a bench_files=()
declare -a targets=()
declare -a criterion_args=()

#######################################
# Collect bench target names and build `cargo`'s `--bench` target list.
#
# Collapses `-m`/`--mod` and `-f`/`--files` filters into one predicate over
# `benches/*.rs` (`mod` wins when both given); with neither flag every bench
# file is selected. One target list serves both the smoke and measure paths.
# Repeated `--bench` adds one target per occurrence.
#
# Globals:
#   `usage_mod`, `usage_files`: filters parsed by `mise`
#   `bench_files`: populated with selected target names (no path/extension)
#   `targets`: populated with repeated `--bench <name>` args
# Arguments:
#   None
# Outputs:
#   Diagnostic on `STDERR` when nothing matches
# Returns:
#   `2` if no bench file matches (`main` propagates this as the exit code),
#   otherwise `0`
#######################################
collect_bench_files() {
  local f bf name

  for f in benches/*.rs; do
    bf="${f##*/}"
    bf="${bf%.rs}"
    if [[ -n "${usage_mod:-}" ]]; then
      [[ "${bf}" == "${usage_mod}"* ]] || continue
    elif [[ -n "${usage_files:-}" ]]; then
      [[ "${bf}" == *"${usage_files}"* ]] || continue
    fi
    bench_files+=("${bf}")
  done

  if [[ "${#bench_files[@]}" -eq 0 ]]; then
    printf 'no benchmark files match -m or -f\n' >&2
    return 2
  fi

  for name in "${bench_files[@]}"; do
    targets+=(--bench "${name}")
  done
}

#######################################
# Smoke-run the selected bench targets via `cargo test`: criterion's documented
# CI path. `--features test-utils` is load-bearing: all `[[bench]]` targets
# declare `required-features`, and `cargo test` silently skips targets when
# unmet.
#
# Globals:
#   `usage_args`, `usage_compare`: flags parsed by `mise` (noted-and-ignored)
#   `bench_files`, `targets`: from `collect_bench_files`
# Arguments:
#   None
# Outputs:
#   Ignored-flag notes on `STDERR`; the `cargo test` run's output
# Returns:
#   Does not return: `exec` replaces this shell with `cargo test`
#######################################
run_smoke() {
  local count="${#bench_files[@]}"

  if [[ -n "${usage_args:-}" ]]; then
    printf \
      'note: [args] ignored in --mode test (smoke runs raw cargo test)\n' >&2
  fi
  if [[ -n "${usage_compare:-}" ]]; then
    printf '%s\n' \
      'note: --compare ignored in --mode test (no measurement to compare)' >&2
  fi
  printf '==> Smoke-testing %d benchmark target(s)\n' "${count}"
  exec cargo test --no-fail-fast --features test-utils "${targets[@]}"
}

#######################################
# Assemble criterion's argument list from the parsed usage flags.
#
# `extra_args`: `mise` pre-quotes each `usage_args` token so this `eval`
# reconstructs the argument list exactly as given. The `eval` is `mise`'s
# documented variadic pattern and a documented exception to the style guide's
# `eval` ban.
#
# Globals:
#   `usage_args`, `usage_mode`, `usage_verbose`: flags parsed by `mise`
#   `criterion_args`: criterion CLI arguments are appended to this array
# Arguments:
#   None
# Outputs:
#   None
#######################################
build_criterion_args() {
  declare -a extra_args
  eval "extra_args=(${usage_args:-})"

  # Timing defaults live in `benches/common::criterion_config()` and are
  # overridden by `[args]`; this task adds only `--quick` and `--noplot`.
  [[ "${usage_mode?}" == "quick" ]] && criterion_args+=(--quick --noplot)
  [[ "${usage_verbose?}" == "true" ]] && criterion_args+=(--verbose)
  criterion_args+=("${extra_args[@]+"${extra_args[@]}"}")
}

#######################################
# Print the baseline name for `--save-baseline`, or nothing if none.
#
# Criterion 0.8.2 rejects `--save-baseline` combined with forwarded
# `--baseline*` flags; we do not pre-validate, so the run fails loudly with
# criterion's own argument-validation error.
#
# Auto-names embed `branch+short-sha`; `-dirty` means the worktree has any
# tracked-modified or untracked non-ignored file (`git status --porcelain`
# lists both; gitignored paths such as `target/` never appear). A `git`
# failure (not a repository, broken index, …) prints an error to `stderr`
# and returns non-zero; it never yields a silent `-dirty`.
# Globals:
#   `usage_no_report`, `usage_report`: flags parsed by `mise`
# Arguments:
#   None
# Outputs:
#   Baseline name on `stdout` (no trailing newline); error message on `stderr`
#   when auto-naming fails
# Returns:
#   `0` on success (also for `--no-report` and explicit names),
#   `1` when `git` state cannot be read for auto-naming
#######################################
resolve_baseline_name() {
  local branch sha porcelain dirty

  if [[ "${usage_no_report:-false}" == "true" ]]; then
    return
  fi

  # Explicit `-r <name>`; bare `-r` parses as the literal `true` and falls
  # through to the auto-name below.
  if [[ -n "${usage_report:-}" && "${usage_report}" != "true" ]]; then
    printf '%s' "${usage_report}"
    return
  fi

  # Auto-name: `branch-sha[-dirty]` (dirty/error semantics in header above).
  if branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
    branch="${branch//\//-}"
    [[ "${branch}" == "HEAD" ]] && branch="detached"
    if ! sha="$(git rev-parse --short HEAD 2>&1)"; then
      printf 'bench: git rev-parse --short HEAD failed: %s\n' "${sha}" >&2
      return 1
    fi
    if ! porcelain="$(git status --porcelain 2>&1)"; then
      printf 'bench: git status --porcelain failed: %s\n' "${porcelain}" >&2
      return 1
    fi
    dirty=""
    [[ -n "${porcelain}" ]] && dirty="-dirty"
    printf '%s' "${branch}-${sha}${dirty}"
  else
    printf 'bench: cannot auto-name baseline: git rev-parse failed %s\n' \
      '(not a git repository?)' >&2
    return 1
  fi
}

#######################################
# Orchestrate a run: select targets, fail fast on unknown `--compare` baseline,
# build criterion args, run (or smoke in `--mode test`), then compare.
#
# Globals:
#   `usage_*` flags parsed by `mise`; `bench_files`, `targets`,
#   `criterion_args`, `baseline`
# Arguments:
#   None
# Outputs:
#   Progress lines and run output on `STDOUT`/`STDERR`
# Returns:
#   `2` if no bench file matches; otherwise the run's exit status
#######################################
main() {
  if ! collect_bench_files; then
    return 2
  fi

  local count="${#bench_files[@]}"

  if [[ "${usage_mode?}" == "test" ]]; then
    run_smoke
  fi

  # Compare pre-check: fail fast before any measurement.
  # `critcmp <unknown> new` exits `0` and silently drops unknown column:
  # one-column table, every ratio `1.00`; the task would "succeed" with
  # misleading output after a full measurement run. This check converts that
  # into a named fail-fast.
  local known_baselines
  if [[ -n "${usage_compare:-}" ]]; then
    known_baselines="$(critcmp --baselines 2>/dev/null || true)"
    if ! grep -Fxq -- "${usage_compare}" <<<"${known_baselines}"; then
      printf 'unknown baseline: %s (list with: critcmp --baselines)\n' \
        "${usage_compare}" >&2
      exit 2
    fi
  fi

  build_criterion_args

  local baseline
  baseline="$(resolve_baseline_name)"
  if [[ -n "${baseline}" ]]; then
    # Quick and normal runs use different statistical models and stored results
    # carry no mode metadata: one shared name would let a quick run silently
    # overwrite a normal baseline.
    [[ "${usage_mode?}" == "quick" ]] && baseline+="-quick"
    criterion_args+=(--save-baseline "${baseline}")
  fi

  printf '==> Running %d benchmark target(s) (mode: %s, baseline: %s)\n' \
    "${count}" "${usage_mode?}" "${baseline:-none}"
  local -a run_cmd=(
    cargo bench --no-fail-fast --features test-utils "${targets[@]}"
  )
  if [[ "${#criterion_args[@]}" -gt 0 ]]; then
    run_cmd+=(-- "${criterion_args[@]}")
  fi
  "${run_cmd[@]}"

  # Compare: saved baseline (positional `1`) vs this run (`new`).
  if [[ -n "${usage_compare:-}" ]]; then
    critcmp "${usage_compare}" new
  fi
}

main "$@"
