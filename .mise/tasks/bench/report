#!/bin/bash
#MISE description="Post-bench summary: parse criterion JSON output"
#MISE hide=true
#USAGE arg "[criterion_dir]" default="target/criterion" env="CRITERION_DIR" help="Criterion output directory"

# Prints a summary of which benchmark groups have results on disk after every
# bench execution. Runs automatically via depends_post (unconditionally —
# including after --mode test/quick and failed runs), so wording derives
# honesty from the tree itself, never from the run that just finished.

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

CRITERION_DIR="${usage_criterion_dir:-${CRITERION_DIR:-target/criterion}}"

#######################################
# Check if criterion output directory exists.
#
# Arguments:
#   None
# Returns:
#   0 if directory exists, 1 otherwise
#######################################
has_criterion_output() {
  [[ -d "${CRITERION_DIR}" ]]
}

#######################################
# Count parameter sizes with results in a benchmark group.
#
# Handles both directory layouts: flat sweeps
# (<group>/<size>/new/estimates.json, BenchmarkId::from_parameter) and nested
# multi-function sweeps (<group>/<function>/<size>/new/estimates.json,
# BenchmarkId::new(name, n)) are summed together so multi-function groups aren't
# silently omitted from the printed summary.
#
# Arguments:
#   group_dir — path to the group directory
# Outputs:
#   Writes count to stdout
#######################################
count_sizes_with_results() {
  local group_dir="${1}"
  local count=0
  local child_dir size_dir

  for child_dir in "${group_dir}"*/; do
    [[ -d "${child_dir}" ]] || continue
    # Parses criterion's private per-benchmark estimates.json layout —
    # version-coupled and unspecified (criterion's sanctioned machine
    # interfaces are raw.csv via the csv_output feature, or a
    # --message-format=json stream). Grep this file on criterion bumps.
    if [[ -f "${child_dir}/new/estimates.json" ]]; then
      (( count += 1 ))
      continue
    fi
    for size_dir in "${child_dir}"*/; do
      [[ -d "${size_dir}" ]] || continue
      if [[ -f "${size_dir}/new/estimates.json" ]]; then
        (( count += 1 ))
      fi
    done
  done

  echo "${count}"
}

#######################################
# Print a single benchmark group entry.
#
# Arguments:
#   group_dir — path to the group directory
# Outputs:
#   Writes "  - <name>: <count> sizes" to stdout
#######################################
print_group_entry() {
  local group_dir="${1}"
  local group_name size_count

  group_name="$(basename "${group_dir}")"
  size_count="$(count_sizes_with_results "${group_dir}")"

  if (( size_count > 0 )); then
    echo "  - ${group_name}: ${size_count} sizes"
  fi
}

#######################################
# Iterate groups and print those with results.
#
# Outputs:
#   Writes group entries to stdout
# Returns:
#   0 if any groups were printed, 1 otherwise
#######################################
print_groups() {
  local has_groups=false
  local group_dir group_name

  for group_dir in "${CRITERION_DIR}"/*/; do
    [[ -d "${group_dir}" ]] || continue
    group_name="$(basename "${group_dir}")"

    if [[ "${has_groups}" == "false" ]]; then
      # "on disk", not "measured": depends_post also runs after --mode test
      # (cargo test, no measurement) and --mode quick (measurement, but the
      # tree shown is whatever the disk already held).
      echo "### Groups with results on disk:"
      has_groups=true
    fi

    print_group_entry "${group_dir}"
  done

  if [[ "${has_groups}" == "false" ]]; then
    return 1
  fi

  return 0
}

#######################################
# Format the HTML report's modification time.
#
# The report is rewritten only by a full plotted run: --mode test never
# measures (cargo test path) and --mode quick passes --noplot (criterion
# clap help), so this mtime ages across those runs — that age is the
# staleness signal the footer prints.
#
# Arguments:
#   None
# Outputs:
#   Writes "YYYY-MM-DD HH:MM" to stdout
# Returns:
#   0 when the report exists and its mtime could be read, 1 otherwise
#   (set -e safe: callers use this in an `if` condition)
#######################################
report_generated_at() {
  local report_html="${CRITERION_DIR}/report/index.html"

  [[ -f "${report_html}" ]] || return 1
  # date -r FILE: portable across the BSD date this macOS ships and GNU
  # date (-r/--reference=FILE); no stat(1) flag is common to both.
  date -r "${report_html}" '+%Y-%m-%d %H:%M' 2>/dev/null || return 1
}

#######################################
# Print the summary footer with usage hints.
#
# The charts line offers `report/index.html` only when that file exists:
# criterion 0.8.2 writes exactly this path (criterion source:
# criterion-0.8.2 src/html/mod.rs joins "report/index.html"; its
# summary report template links bench.path/report/index.html the same way).
# The book still documents the plural `target/criterion/reports/index.html`
# (docs/refs/criterion_rs_book/02_user_guide/04_html_report.md, HTML Report
# section) — stale for criterion 0.8.x; do not "correct" this footer to
# match the book.
#
# Outputs:
#   Writes footer to stdout
#######################################
print_footer() {
  local report_html="${CRITERION_DIR}/report/index.html"
  local generated_at=""

  echo ""
  if generated_at="$(report_generated_at)"; then
    echo "Open \`${report_html}\` for detailed charts" \
      "(last full report: ${generated_at})."
  else
    echo "No HTML report on disk (no full plotted run yet, or it was cleaned)."
  fi
  echo "Run \`critcmp <baseline> new\`" \
    "(or \`mise run bench --compare <baseline>\`) for comparison."
  echo "Run \`mise run bench:model\` for performance summary."
  echo "Run \`mise run bench:model -- --plot\` for fitted curves in the terminal."
}

#######################################
# Main entry point.
#
# Arguments:
#   None
# Outputs:
#   Writes benchmark summary to stdout
#######################################
main() {
  if ! has_criterion_output; then
    echo "No criterion output found at ${CRITERION_DIR}"
    return 0
  fi

  echo "## Benchmark Summary"
  echo ""

  if ! print_groups; then
    echo "No benchmark groups found."
    return 0
  fi

  print_footer
}

main "$@"
