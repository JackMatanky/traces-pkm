#!/bin/bash
#MISE description="Post-bench summary: parse criterion JSON output"
#MISE hide=true
#USAGE arg "[criterion_dir]" default="target/criterion" env="CRITERION_DIR" help="Criterion output directory"

# Prints a summary of which benchmark groups were measured after every bench
# execution. Runs automatically via depends_post.

CRITERION_DIR="${usage_criterion_dir:-${CRITERION_DIR:-target/criterion}}"

#######################################
# Check if criterion output directory exists.
#
# Arguments:
#   None
# Returns:
#   0 if directory exists, 1 otherwise
#######################################
has_criterion_output() {
  [[ -d "${CRITERION_DIR}" ]]
}

#######################################
# Count parameter sizes with results in a benchmark group.
#
# Handles both directory layouts: flat sweeps
# (<group>/<size>/new/estimates.json, BenchmarkId::from_parameter) and nested
# multi-function sweeps (<group>/<function>/<size>/new/estimates.json,
# BenchmarkId::new(name, n)) are summed together so multi-function groups aren't
# silently omitted from the printed summary.
#
# Arguments:
#   group_dir — path to the group directory
# Outputs:
#   Writes count to stdout
#######################################
count_sizes_with_results() {
  local group_dir="${1}"
  local count=0
  local child_dir size_dir

  for child_dir in "${group_dir}"*/; do
    [[ -d "${child_dir}" ]] || continue
    if [[ -f "${child_dir}/new/estimates.json" ]]; then
      (( count += 1 ))
      continue
    fi
    for size_dir in "${child_dir}"*/; do
      [[ -d "${size_dir}" ]] || continue
      if [[ -f "${size_dir}/new/estimates.json" ]]; then
        (( count += 1 ))
      fi
    done
  done

  echo "${count}"
}

#######################################
# Print a single benchmark group entry.
#
# Arguments:
#   group_dir — path to the group directory
# Outputs:
#   Writes "  - <name>: <count> sizes" to stdout
#######################################
print_group_entry() {
  local group_dir="${1}"
  local group_name size_count

  group_name="$(basename "${group_dir}")"
  size_count="$(count_sizes_with_results "${group_dir}")"

  if (( size_count > 0 )); then
    echo "  - ${group_name}: ${size_count} sizes"
  fi
}

#######################################
# Iterate groups and print those with results.
#
# Outputs:
#   Writes group entries to stdout
# Returns:
#   0 if any groups were printed, 1 otherwise
#######################################
print_groups() {
  local has_groups=false
  local group_dir group_name

  for group_dir in "${CRITERION_DIR}"/*/; do
    [[ -d "${group_dir}" ]] || continue
    group_name="$(basename "${group_dir}")"

    # Skip baseline comparison directories (contain /)
    [[ "${group_name}" == *"/"* ]] && continue

    if [[ "${has_groups}" == "false" ]]; then
      echo "### Groups measured:"
      has_groups=true
    fi

    print_group_entry "${group_dir}"
  done

  if [[ "${has_groups}" == "false" ]]; then
    return 1
  fi

  return 0
}

#######################################
# Print the summary footer with usage hints.
#
# Outputs:
#   Writes footer to stdout
#######################################
print_footer() {
  echo ""
  if [[ -f target/criterion/report/index.html ]]; then
    echo "Open \`target/criterion/report/index.html\` for detailed charts."
  else
    echo "(No \`target/criterion/report/index.html\` right now — it returns after the next \`bench\` run.)"
  fi
  echo "Run \`mise run bench --compare <baseline>\` for comparison."
  echo "Run \`mise run bench --model\` for performance summary."
  echo "Run \`mise run bench --model -- --plot\` for fitted curves in the terminal."
}

#######################################
# Inject responsive CSS into criterion HTML reports.
#
# Criterion 0.8.2 hardcodes plot width (plotters_backend SIZE = 960x540)
# and the page container (.body { width: 960px } in index.html.tt) with
# no configuration knob, so reports overflow narrow windows and render
# oversized plots on laptops. Injects one marker-tagged <style> before
# </head>: the page body tracks the viewport (capped at 960px) and
# embedded plots shrink to at most 720px wide, height auto.
#
# Skips files already carrying the mise-responsive marker; criterion
# rewrites the HTML on the next bench run, dropping the marker so the
# patch reapplies then. Patches only *.html under CRITERION_DIR, quoted
# throughout: benchmark parameter names contain spaces.
#
# Arguments:
#   None
# Outputs:
#   Writes a count line when at least one page was patched
# Returns:
#   0 — patching is best-effort and must not break the summary
#######################################
apply_responsive_styles() {
  local style='<style id="mise-responsive">.body{width:100%;max-width:960px}img{max-width:min(100%,720px);height:auto}</style>'
  local html tmp count=0

  while IFS= read -r -d '' html; do
    grep -q 'mise-responsive' "${html}" && continue
    tmp="${html}.mise-patch"
    if awk -v inject="${style}" '/<\/head>/ && !done { print inject; done=1 } { print }' \
        "${html}" > "${tmp}" && grep -q 'mise-responsive' "${tmp}"; then
      mv "${tmp}" "${html}"
      count=$(( count + 1 ))
    else
      rm -f "${tmp}"
    fi
  done < <(find "${CRITERION_DIR}" -name '*.html' -print0)

  if (( count > 0 )); then
    echo "Applied responsive styles to ${count} report page(s)."
  fi
}

#######################################
# Main entry point.
#
# Arguments:
#   None
# Outputs:
#   Writes benchmark summary to stdout
#######################################
main() {
  if ! has_criterion_output; then
    echo "No criterion output found at ${CRITERION_DIR}"
    return 0
  fi

  apply_responsive_styles

  echo "## Benchmark Summary"
  echo ""

  if ! print_groups; then
    echo "No benchmark groups found."
    return 0
  fi

  print_footer
}

main "$@"
