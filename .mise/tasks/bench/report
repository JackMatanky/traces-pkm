#!/bin/bash
#MISE description="Summarize which bench groups have results on disk"
#MISE hide=true
#USAGE arg "[criterion_dir]" {
#USAGE   help "Criterion output directory"
#USAGE   default "target/criterion"
#USAGE   env "CRITERION_DIR"
#USAGE }

# Prints benchmark groups having results on disk. Wording describes what is
# on disk, never what the run did: runs after every `bench` mode, including
# failures.

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

CRITERION_DIR="${usage_criterion_dir:-${CRITERION_DIR:-target/criterion}}"

has_criterion_output() {
  [[ -d "${CRITERION_DIR}" ]]
}

#######################################
# Count sizes with results in one group.
#
# Handles flat (`<group>/<size>/new/`) and nested
# (`<group>/<function>/<size>/new/`) layouts, summed together so multi-function
# groups are not omitted from the summary.
#
# Arguments:
#   `group_dir`: path to the group directory
# Outputs:
#   Writes count to `stdout`
#######################################
count_sizes_with_results() {
  local group_dir="${1}"
  local count=0
  local child_dir size_dir

  for child_dir in "${group_dir}"*/; do
    [[ -d "${child_dir}" ]] || continue
    # `estimates.json` is criterion's private, version-coupled layout: `grep`
    # this file on criterion bumps. Sanctioned interfaces are `csv_output`
    # (`raw.csv`) and `--message-format=json`.
    if [[ -f "${child_dir}/new/estimates.json" ]]; then
      (( count += 1 ))
      continue
    fi
    for size_dir in "${child_dir}"*/; do
      [[ -d "${size_dir}" ]] || continue
      if [[ -f "${size_dir}/new/estimates.json" ]]; then
        (( count += 1 ))
      fi
    done
  done

  echo "${count}"
}

#######################################
# Print a single benchmark group entry.
#
# Arguments:
#   `group_dir`: path to the group directory
# Outputs:
#   Writes `  - <name>: <count> sizes` to `stdout`
#######################################
print_group_entry() {
  local group_dir="${1}"
  local group_name size_count

  group_name="$(basename "${group_dir}")"
  size_count="$(count_sizes_with_results "${group_dir}")"

  if (( size_count > 0 )); then
    local size_word="sizes"
    (( size_count == 1 )) && size_word="size"
    echo "  - ${group_name}: ${size_count} ${size_word}"
  fi
}

#######################################
# Iterate groups and print those with results.
#
# Outputs:
#   Writes group entries to `stdout`
# Returns:
#   0 if any groups were printed, 1 otherwise
#######################################
print_groups() {
  local has_groups=false
  local group_dir group_name

  for group_dir in "${CRITERION_DIR}"/*/; do
    [[ -d "${group_dir}" ]] || continue
    group_name="$(basename "${group_dir}")"

    if [[ "${has_groups}" == "false" ]]; then
      # "on disk", not "measured": `depends_post` also runs after
      # `--mode test`, which measures nothing.
      echo "### Groups with results on disk:"
      has_groups=true
    fi

    print_group_entry "${group_dir}"
  done

  if [[ "${has_groups}" == "false" ]]; then
    return 1
  fi

  return 0
}

#######################################
# Format the HTML report's modification time.
#
# Only a full plotted run rewrites the report: `--mode test` never measures and
# `--mode quick` passes `--noplot`, so mtime age is the staleness signal the
# footer prints.
#
# Arguments:
#   None
# Outputs:
#   Writes `YYYY-MM-DD HH:MM` to `stdout`
# Returns:
#   `0` if mtime printed, `1` otherwise; safe under `set -e` because
#   callers check in an if condition.
report_generated_at() {
  local report_html="${CRITERION_DIR}/report/index.html"

  [[ -f "${report_html}" ]] || return 1
  # `date -r FILE`: portable across BSD `date` (macOS) and GNU `date`
# (`-r`/`--reference=FILE`); no `stat(1)` flag is common to both.
  date -r "${report_html}" '+%Y-%m-%d %H:%M' 2>/dev/null || return 1
}

#######################################
# Print the summary footer with usage hints.
#
# Cite `report/index.html` only when it exists: criterion `0.8.2` joins exactly
# this path under each benchmark. Some writeups still show the plural
# `target/criterion/reports/index.html`, which is stale for `0.8.x`; do not
# "correct" this footer to match them.
#
# Outputs:
#   Writes footer to `stdout`
#######################################
print_footer() {
  local report_html="${CRITERION_DIR}/report/index.html"
  local generated_at=""

  echo ""
  if generated_at="$(report_generated_at)"; then
    echo "Open \`${report_html}\` for detailed charts" \
      "(last full report: ${generated_at})."
  else
    echo "No HTML report on disk (no full plotted run yet, or it was cleaned)."
  fi
  echo "Run \`critcmp <baseline> new\`" \
    "(or \`mise run bench --compare <baseline>\`) for comparison."
  echo "Run \`mise run bench:model\` for performance summary."
  echo "Run \`mise run bench:model -- --plot\` for fitted curves in the" \
    "terminal."
}

#######################################
# Main entry point.
#
# Arguments:
#   None
# Outputs:
#   Writes benchmark summary to `stdout`
#######################################
main() {
  if ! has_criterion_output; then
    echo "No criterion output found at ${CRITERION_DIR}"
    return 0
  fi

  echo "## Benchmark Summary"
  echo ""

  if ! print_groups; then
    echo "No benchmark groups found."
    return 0
  fi

  print_footer
}

main "$@"
