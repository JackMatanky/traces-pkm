#!/bin/bash
#MISE description="Run parallel mutation testing with `cargo-mutants`"
#MISE sources=["@group:rust"]
#MISE extends="mutants"
#MISE depends=["test"]
#MISE depends_post=["mutants:report"]
#USAGE flag "-f --file <file>" help="Run mutants in a specific file only (e.g. -f src/config.rs)"
#USAGE flag "-m --mod <module>" help="Run mutants in a specific module only (matches src/<module>/**/*.rs)"
#USAGE // `complete "module"` completes the value after `-m`/`--mod`, not the flag name.
#USAGE complete "module" run="sed -nE 's/^(pub )?mod ([a-z_]+);$/\\2/p' src/lib.rs"
#USAGE flag "--exclude <glob>" help="Exclude files matching glob"
#USAGE flag "--check" help="Build-only check: verify generated mutants compile without running tests"
#USAGE flag "--iterate" negate="--no-iterate" default=#true help="Incremental mode: skip mutants caught in previous runs"
#USAGE flag "--timeout <secs>" help="Override test timeout in seconds"
#USAGE flag "--no-config" help="Ignore .cargo/mutants.toml"
#USAGE flag "-L --level <level>" {
#USAGE   choices "trace" "debug" "info" "warn" "error"
#USAGE   help "Log verbosity level"
#USAGE }
#USAGE flag "-v --caught" help="Also print mutants caught by tests"
#USAGE flag "-V --unviable" help="Also print mutants that failed to build"
#USAGE flag "--all-logs" help="Print all Cargo output to stdout"
#USAGE flag "--json" help="Emit machine-readable output"
#USAGE arg "[args]" var=#true {
#USAGE   help "Extra arguments forwarded to cargo-mutants"
#USAGE   long_help """
#USAGE   Examples:
#USAGE   - `mise run mutants -- --list` - list mutants without running tests
#USAGE   - `mise run mutants -m index -- --list` - list mutants for module `index`
#USAGE   - `mise run mutants -m index` - test mutants for module `index`
#USAGE   - `mise run mutants -f src/config.rs` - test mutants in a single file
#USAGE   - `mise run mutants --check` - build check only (fast syntax/type validation)
#USAGE   """
#USAGE }

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

declare -a mutants_args=()

#######################################
# Appends base cargo-mutants compilation and profile arguments.
# Globals:
#   mutants_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
build_static_flags() {
  mutants_args+=(
    --baseline run
    --cap-lints true
    --build-timeout-multiplier 3
    --profile mutants
  )
}

#######################################
# Appends file, module, and exclusion filter arguments.
# Globals:
#   usage_file
#   usage_mod
#   usage_exclude
#   mutants_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
build_filter_flags() {
  [[ -n "${usage_file:-}" ]] && mutants_args+=(--file "${usage_file}")
  [[ -n "${usage_mod:-}" ]] && \
    mutants_args+=(--file "src/${usage_mod}/**/*.rs")
  [[ -n "${usage_exclude:-}" ]] && \
    mutants_args+=(--exclude "${usage_exclude}")
}

#######################################
# Appends iteration, check, timeout, and verbosity level arguments.
# Globals:
#   usage_iterate
#   usage_check
#   usage_timeout
#   usage_level
#   mutants_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
build_execution_flags() {
  [[ "${usage_iterate:-true}" == "true" ]] && mutants_args+=(--iterate)
  [[ "${usage_check:-false}" == "true" ]] && mutants_args+=(--check)
  [[ -n "${usage_timeout:-}" ]] && \
    mutants_args+=(--timeout "${usage_timeout}")
  [[ -n "${usage_level:-}" ]] && mutants_args+=(--level "${usage_level}")
}

#######################################
# Appends output logging and reporting flags.
# Globals:
#   usage_caught
#   usage_unviable
#   usage_all_logs
#   usage_json
#   usage_no_config
#   mutants_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
build_reporting_flags() {
  [[ "${usage_caught:-false}" == "true" ]] && mutants_args+=(--caught)
  [[ "${usage_unviable:-false}" == "true" ]] && mutants_args+=(--unviable)
  [[ "${usage_all_logs:-false}" == "true" ]] && mutants_args+=(--all-logs)
  [[ "${usage_json:-false}" == "true" ]] && mutants_args+=(--json)
  [[ "${usage_no_config:-false}" == "true" ]] && \
    mutants_args+=(--no-config)
}

#######################################
# Evaluates and parses variadic usage_args tokens into mutants_args.
# Globals:
#   usage_args
#   mutants_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
parse_passthrough_tokens() {
  # usage_args arrives shell-quoted; eval expands it into array elements.
  eval "mutants_args+=(${usage_args:-})"
}

#######################################
# Assembles full argument list and executes cargo mutants.
# Globals:
#   mutants_args
# Arguments:
#   CLI arguments vector.
# Outputs:
#   cargo mutants test output to STDOUT/STDERR.
# Returns:
#   Status of cargo mutants.
#######################################
main() {
  build_static_flags
  build_filter_flags
  build_execution_flags
  build_reporting_flags
  parse_passthrough_tokens

  cargo mutants "${mutants_args[@]}"
}

main "$@"
