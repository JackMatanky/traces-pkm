#!/bin/bash
#MISE description="Generate a structured Markdown report from missed mutants"
#MISE hide=true
#USAGE flag "-i --input <input>" default="mutants.out/missed.txt" help="Path to missed.txt input file"
#USAGE flag "-o --output <output>" default="mutants-report.md" help="Path to mutants-report.md output file"
# shellcheck disable=SC2154
set -euo pipefail

missed_file="${usage_input:-mutants.out/missed.txt}"
report_file="${usage_output:-mutants-report.md}"

if [[ ! -s "${missed_file}" ]]; then
  cat <<EOF > "${report_file}"
# Mutation Testing Report
**Status:** Completed successfully. All mutants were caught!
**Next Action:** No action needed. Test suite coverage is robust.
EOF
  exit 0
fi

cat <<EOF > "${report_file}"
# Mutation Testing Report
**Status:** Completed. Surviving mutants detected.

## Instructions for Next Agent Session
1. Read the list of surviving mutants below.
2. For each mutant, examine the file and add targeted
   assertions/unit tests to catch it.
3. Verify your fixes by running:
   \`cargo mutants --file <path-to-file>\`.

## Surviving Mutants List
\`\`\`text
$(cat "${missed_file}")
\`\`\`
EOF
