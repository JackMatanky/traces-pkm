#!/bin/bash
#MISE description="Run unit and integration tests with `nextest`"
#MISE sources=["@group:rust"]
#MISE extends="gate:never-skip"
#USAGE flag "-m --mod <module>" {
#USAGE   help "Run tests for a specific module only"
#USAGE   long_help """
#USAGE   Scopes nextest to the named module using a filter expression (e.g. `-m index` filters to tests under module `index`).
#USAGE   """
#USAGE }
#USAGE // `complete "module"` completes the value after `-m`/`--mod`, not the flag name.
#USAGE complete "module" run="sed -nE 's/^(pub )?mod ([a-z_]+);$/\\2/p' src/lib.rs"
#USAGE flag "--feature <feature>" default="all" {
#USAGE   help "Cargo feature to activate (e.g. all, default, or specific feature)"
#USAGE   long_help """
#USAGE   Selects Cargo feature set: `all` passes `--all-features`, `default` passes no feature flags, any other value passes `--features <feature>`.
#USAGE   """
#USAGE }
#USAGE arg "[args]" var=#true {
#USAGE   help "Extra arguments forwarded to `cargo nextest run`"
#USAGE   long_help """
#USAGE   Examples:
#USAGE   - `mise run test:unit index::query` - run tests matching name substring
#USAGE   - `mise run test:unit --test init_cli` - run integration test binary
#USAGE   - `mise run test:unit --lib` - run unit tests in library target only
#USAGE   - `mise run test:unit -E 'test(/^index::/)'` - filter with nextest filter expression DSL
#USAGE   """
#USAGE }

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail

declare -a unit_args=()

#######################################
# Maps feature selection flag to cargo nextest package and feature arguments.
# Globals:
#   usage_feature
#   unit_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
resolve_package_feature_args() {
  if [[ "${usage_feature:-all}" == "all" ]]; then
    unit_args+=(-p traces-pkm --all-features)
  else
    unit_args+=(-p traces-pkm --features "${usage_feature}")
  fi
}

#######################################
# Formats module filter flag into nextest expression DSL filter.
# Globals:
#   usage_mod
#   unit_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
resolve_module_filter() {
  if [[ -n "${usage_mod:-}" ]]; then
    unit_args+=(-E "test(/^${usage_mod}::/)")
  fi
}

#######################################
# Expands variadic passthrough arguments into unit_args.
# Globals:
#   usage_args
#   unit_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
parse_passthrough_tokens() {
  # usage_args arrives shell-quoted (var=#true arg); eval expands it
  # into array elements.
  eval "unit_args+=(${usage_args:-})"
}

#######################################
# Assembles argument vector and executes cargo nextest run.
# Globals:
#   unit_args
# Arguments:
#   CLI arguments vector.
# Outputs:
#   Nextest run results to STDOUT/STDERR.
# Returns:
#   Status of cargo nextest.
#######################################
main() {
  resolve_package_feature_args
  resolve_module_filter
  parse_passthrough_tokens

  cargo nextest run "${unit_args[@]}"
}

main "$@"
