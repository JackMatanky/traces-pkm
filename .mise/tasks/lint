#!/bin/bash
#MISE description="Strict `clippy`: workspace, all targets, all features; auto-fix known lints unless `--no-fix`"
#MISE alias="l"
#MISE depends=["fmt"]
#MISE sources=["@group:rust"]
#MISE extends="gate:never-skip"
#USAGE flag "--fix" negate="--no-fix" default=#true {
#USAGE   help "Auto-fix known lints using cargo clippy --fix"
#USAGE   long_help """
#USAGE   Enabled by default: auto-fixes 18 known safe Clippy lints across workspace targets and dirty/staged files. Pass `--no-fix` for read-only lint checks (used in verification gates and CI to prevent file mutation races).
#USAGE   """
#USAGE }
#USAGE flag "--deny-warnings" negate="--no-deny-warnings" default=#true {
#USAGE   help "Treat Clippy warnings as errors"
#USAGE   long_help """
#USAGE   Enabled by default: passes `-D warnings` to Clippy so any warning causes task failure. Pass `--no-deny-warnings` to inspect warnings without failing.
#USAGE   """
#USAGE }
#USAGE flag "--fix-lints <lints>" env="CLIPPY_FIX_LINTS" {
#USAGE   help "Comma-separated lints to auto-fix instead of the default list"
#USAGE   long_help """
#USAGE   Overrides the default 18-lint fix list. Supply a comma-separated list of Clippy lint names to fix (or set via `CLIPPY_FIX_LINTS`).
#USAGE   """
#USAGE }

# shellcheck disable=SC2154  # usage_* are injected by mise
set -euo pipefail
# Run `clippy` across workspace, all targets, and all features; by default also
# auto-fix a known lint list and deny warnings.

declare -a cargo_args=(--workspace --all-targets --all-features)
declare -a clippy_args=()

#######################################
# Populates array with canonical list of 18 auto-fixable Clippy lints.
# Globals:
#   default_lints
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
load_fix_registry() {
  default_lints=(
    as_pointer_underscore
    as_underscore
    bool_assert_comparison
    dbg_macro
    manual_let_else
    needless_borrow
    needless_collect
    or_fun_call
    redundant_clone
    redundant_closure_for_method_calls
    redundant_field_names
    search_is_some
    significant_drop_in_scrutinee
    str_to_string
    trait_duplication_in_bounds
    uninlined_format_args
    use_self
    useless_conversion
  )
}

#######################################
# Resolves list of lints to auto-fix from CLI or defaults.
# Globals:
#   usage_fix_lints
#   active_fix_lints
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
resolve_active_fix_lints() {
  active_fix_lints=()
  if [[ -n "${usage_fix_lints:-}" ]]; then
    local old_ifs="${IFS}"
    IFS=',' read -ra active_fix_lints <<< "${usage_fix_lints}"
    IFS="${old_ifs}"
  else
    declare -a default_lints=()
    load_fix_registry
    active_fix_lints=("${default_lints[@]}")
  fi
}

#######################################
# Assembles deny-warnings, fix, and lint warning flags into clippy_args
# and cargo_args.
# Globals:
#   usage_deny_warnings
#   usage_fix
#   cargo_args
#   clippy_args
# Arguments:
#   None
# Outputs:
#   None
# Returns:
#   0 on success.
#######################################
build_clippy_flag_args() {
  if [[ "${usage_deny_warnings:-true}" == "true" ]]; then
    clippy_args+=(-D warnings)
  fi

  if [[ "${usage_fix:-true}" == "true" ]]; then
    cargo_args+=(--fix --allow-dirty --allow-staged)

    declare -a active_fix_lints=()
    resolve_active_fix_lints

    local lint
    for lint in "${active_fix_lints[@]}"; do
      [[ -n "${lint}" ]] && clippy_args+=(-W "clippy::${lint}")
    done
  fi
}

#######################################
# Assembles options and executes cargo clippy.
# Globals:
#   cargo_args
#   clippy_args
# Arguments:
#   CLI arguments vector.
# Outputs:
#   Clippy diagnostic output to STDOUT/STDERR.
# Returns:
#   Status of cargo clippy.
#######################################
main() {
  build_clippy_flag_args

  cargo clippy "${cargo_args[@]}" -- "${clippy_args[@]}"
}

main "$@"
